{
  "artifact_kind": "manual_semantic_comparison",
  "id": "SEM-MIRROR-039",
  "baseline": "c35816ecae49633674775dd32061c6ee92f94aaf",
  "created_at_utc": "2026-10-21T07:58:49.236904+00:00",
  "scope": "Bounded semantic comparison of menu-item recipe contribution and owner-dashboard aggregate profitability calculations, including known-cost completeness propagation, UI warning representation, DTO contract and relevant unit tests. Cross-checks existing packaging coverage candidate; does not broaden to all report math.",
  "decision": "These are complementary calculations at different aggregation levels, not duplicate implementations: MenuItemProfitability receives an explicit per-recipe completeness boolean and withholds a margin for an incomplete or nonpositive-price item; ProfitabilityRules reports an aggregate known-cost upper-bound once at least one sold line has cost, carries IsFoodCostComplete=false, and the cashier dashboard renders a warning identifying incomplete coverage. The tested behavior is internally aligned. No new finding. Existing FIN-CAND-PACKAGING-COVERAGE-001 is a separate, source-supported aggregate-boundary issue: unknown once-per-order packaging cost is listed missing without reducing sold/known line counts, so aggregate food-cost completeness can remain true; this comparison does not duplicate or clear it.",
  "finding_candidate": null,
  "related_existing_findings": [
    "FIN-CAND-PACKAGING-COVERAGE-001"
  ],
  "severity": "NO_NEW_FINDING; existing medium packaging-completeness candidate remains open",
  "confidence": "High for source-level formula/flag/warning path and unit-test assertions. Runtime/native visual behavior not executed.",
  "manual_reasoning": {
    "menu_item_path": "InventoryQueryService.GetMenuItemProfitabilityAsync loads a RecipeCostResult and derives complete as LineCount>0 && KnownLineCount==LineCount before calling CostingRules.MenuItemProfitability. The domain function returns null percentages/contribution if the price is nonpositive or completeness is false; otherwise it computes sellingPrice-knownCost and rounds ratios to 2 decimals.",
    "aggregate_path": "OwnerDashboardQueryService.BuildProfitability feeds net sales, accumulated known food cost, sold line count and known line count from report DTOs into ProfitabilityRules.ComputeGrossProfit and ComputeOperatingMargin. Those functions mark cost completeness from line counts; for some known but incomplete costs they expose a numeric partial-result estimate while setting IsComplete false. With zero known line costs, they return null profit/cost percentage. The calculations are period-level subtraction of expenses and posted wages, not menu-item contribution.",
    "consumer_path": "OwnerDashboardViewModel labels the ratio as unknown or displays the priced/sold line count and incomplete-cost caption. It adds a warning that profit is overstated when unknown-cost sold items exist and builds a `UnknownCostLabel` saying known count and sold count; OwnerDashboardView.xaml displays the numeric totals plus a warning banner when HasUnknownFoodCost. Thus partial aggregate numbers are not silently represented as complete in source UI flow, though the values remain visible.",
    "test_evidence": "ProfitabilityRulesTests covers complete gross profit, incomplete coverage flag, zero-known cost suppression, partial known cost retaining a bounded numeric value with IsComplete=false, and operating margin behavior. CostingRulesTests covers nonpositive item price and complete item contribution. Test source inspected only; test runner was not executed in this comparison.",
    "existing_candidate_crosscheck": "FIN-CAND-PACKAGING-COVERAGE-001 concerns the aggregate input boundary: ReportingQueryService can add a missing order-level packaging cost to Missing without changing KnownLineCount/SoldLineCount; OwnerDashboardQueryService then uses only those counts to set IsFoodCostComplete. This is distinct from the legitimate known-partial ingredient case. Its existing evidence and synthetic boundary reproduction remain canonical; this comparison adds the formula/UI propagation context but does not create another ID.",
    "intentional_scope": "A per-item screen can withhold a partial item margin, while an aggregate can show a bounded total and explicitly flag incompleteness. The operating result is a recorded-cost measure and the DTO names IsFoodCostComplete and WagePercent null when no wage posting exists. Do not merge these formulas without preserving that different contract.",
    "limitations": "The WPF/native view was not launched, no visual accessibility/contrast claim is made, and no runtime/database report was queried. Owner policy on whether partial totals should remain visible is not altered."
  },
  "counterevidence": [
    "The aggregate DTO carries IsFoodCostComplete and missing item names; the Cashier viewmodel renders explicit incomplete-cost warnings.",
    "Unit tests explicitly expect a partial aggregate value with false completeness and distinguish it from entirely unknown cost.",
    "The item-level and aggregate functions serve different denominators and outputs; numerical similarity alone does not establish a duplicate defect."
  ],
  "recommendation": "Keep the calculations separate or extract only shared percentage rounding if future evidence justifies it. Preserve separate item-level unknown suppression and aggregate partial-bounds labeling. Resolve FIN-CAND-PACKAGING-COVERAGE-001 at the aggregate data contract: represent missing applicable packaging in completeness input (or an equivalent explicit completeness flag), then assert the DTO and warning state are incomplete. Regression tests should cover a known recipe plus unknown active order-packaging cost, and partial versus zero-known recipe costs.",
  "required_tests": [
    "Complete and partial item-level recipe costing maintain the intended null/known behavior.",
    "Aggregate partial-known lines retain a numeric bound only with IsFoodCostComplete=false and visible missing-cost warning.",
    "Unknown configured order packaging invalidates aggregate completeness (existing candidate), while absent/inactive packaging rules remain a documented policy distinction.",
    "No known sold-line costs keeps aggregate food cost and gross/operating result unknown.",
    "No wage entries yields unknown WagePercent and accurate posted-wage label; verify operating result labeling policy."
  ],
  "acceptance_criteria": [
    "No incomplete aggregate food cost is labeled complete.",
    "Item-level incomplete margin remains unavailable unless owner chooses otherwise.",
    "Known partial aggregate values remain visibly labeled as incomplete.",
    "Existing FIN-CAND-PACKAGING-COVERAGE-001 remains the sole canonical finding for packaging completeness.",
    "Wage figures and operating result labels describe recorded payroll, not unrecorded labor."
  ],
  "runtime": "NOT_EXECUTED; source and test assertions inspected only.",
