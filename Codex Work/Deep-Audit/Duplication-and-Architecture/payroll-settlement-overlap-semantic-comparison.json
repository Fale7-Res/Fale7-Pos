  "manual_reasoning": {
    "routes": "Program.cs maps both standalone employee pay and payroll-run pay; the cashier client has both employee-pay and payroll commands.",
    "accounting_paths": [
      "Standalone PayEmployee checks locked current balance and atomically posts Settlement debit plus treasury movement.",
      "CreatePayroll filters ledger entries by UTC year/month and freezes PayrollLine values.",
      "PayrollRules includes earning credits less Deduction and Adjustment only.",
      "PayPayroll spends frozen NetPayablePiastres and posts PayrollSettlement without reading current employee balance."
    ],
    "counterevidence": [
      "Project notes explicitly state payroll is no longer the only employee-payment method; no mutual-exclusion rule was found.",
      "Distinct ledger types preserve classification but do not net standalone Settlement from payroll.",
      "Inspected tests cover the paths separately and do not cover combined same-period payment."
    ]
  },
  "recommendation": "Define and enforce one authoritative outstanding-obligation basis across both payment paths. If standalone settlement prepays current-period earnings, net eligible settlements when payroll is created and prevent stale frozen lines from paying them again; alternatively enforce mutually exclusive payout modes for the covered period. Preserve audit history and test standalone-before-run, standalone-after-run-before-pay, and retry cases.",
  "required_regression_tests": [
    "Daily wage then standalone settlement then create/pay same month; total paid must not exceed the net obligation.",
    "Create/approve run then standalone settlement then pay; frozen payroll must not duplicate already paid amount.",
    "Separate earned periods and historical settlement; verify correct period assignment.",
    "Replay requests and repeat combined workflow; no duplicate treasury or ledger debit."
  ],
  "reviewer": "main coordinator; independent financial continuation challenge pending"
}
