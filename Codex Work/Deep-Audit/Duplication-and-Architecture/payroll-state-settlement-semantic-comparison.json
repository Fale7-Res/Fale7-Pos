  "comparisons": [
    {
      "contract": "Shared Paid label is not equivalent settlement",
      "generic": "TransitionPayroll employees_manage32, allowed Approved->Paid domain18/25, generic status assignment55 Save59; no movement, paidline, ledger settlement or payroll_pay gate.",
      "dedicated": "PayPayroll requires Approved73-74 and payroll_pay84; locks sourcefunds118; deterministic run journal122, movement127-134, positive-line debit143-145, run financial metadata149-154; Save/Commit161-162.",
      "decision": "Existing HIGH FIN006, not new duplicate finding. A shared state-transition helper must not expose financial terminal Paid without dedicated atomic settlement effects."
    },
    {
      "contract": "Client next step versus API acceptance",
      "client": "PayrollViewModel NextStatus113-118 stops at Approved; separate approved-unpaid/payroll_pay gate129-131 selects dedicated PayRun. HTTP transition endpoint830-839 still forwards arbitrary requested status to handler.",
      "decision": "Ordinary UI is narrower than API and is genuine counterevidence against allnormalbutton flows invoking Paid, not server protection. Numeric unknown enum passes parsing but AssertTransition allowed-table membership rejects; no new undefined-state defect."
    },
    {
      "contract": "Paid replay proof versus status-only writer",
      "evidence": "PayPayroll64-71 comment assumes Paid proves committed movement; actual code still LoadReplay and falls through nonApproved rejection73-74 if movement missing.",
      "decision": "The comment premise is defeated by generic FIN006 writer but code does not invent a payment receipt or post a second settlement on missing movement. This yields Paid-without-payment dead end, not duplicate payout."
    },
    {
      "contract": "Idempotency and cancellation are different constraints",
      "evidence": "Dedicated run-only key44 prevents repeated same-run payment; generic cancellation validates prior run state34-37 without shared conditional update. Existing qualified FIN-CAND-PAYROLL001 traces stale-approved schedules.",
      "decision": "Six same-run pay tasks in current test245-258 assert one movement/settlement, not competing pay/cancel correctness. Actual SQL acceptance of competing terminal-state schedule remains unexecuted; preserve filtered-period-index countercontrols in canonical candidate."
    },
    {
      "contract": "Client monotonic status read is not durable financial receipt",
      "evidence": "PayrollViewModel280-286 uses current single-run StatusRank to acknowledge already-progressed transition after response loss. It does not match original actor/approval/history and is not equivalent to dedicated movement-key receipt.",
      "decision": "Keep current purpose as status progression reconciliation, not proof that exact historical actor command paid finances. Existing UI017 retry accessibility and FIN006 state writer remain separate; no new author-count or unconditional defect."
    }
  ],
  "test_contexts": "Actual source read: Domain AssertTransition theory explicitly expects Approved->Paid allowed. Integration payout success asserts total/count/balance/movement; sequential and six-way duplicate pay tests assert dedupe; nonApproved and missing-payroll_pay reject. These controls do not assert generic Paid rejected or pay-versus-cancel barriers. Not executed.",
