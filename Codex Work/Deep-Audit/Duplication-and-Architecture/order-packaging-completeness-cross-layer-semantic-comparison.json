{
  "artifact_kind": "manual_semantic_comparison",
  "id": "SEM-MIRROR-040",
  "baseline": "c35816ecae49633674775dd32061c6ee92f94aaf",
  "created_at_utc": "2026-10-21T08:01:15.839421+00:00",
  "scope": "Bounded cross-layer trace of order-level packaging setup, per-order cost resolution, aggregate food-cost accounting, profitability completeness DTO and Cashier dashboard warning state. Reconciles rather than duplicates FIN-CAND-PACKAGING-COVERAGE-001.",
  "decision": "The existing candidate is source-confirmed and has a material cross-layer consequence: when a sold order type has an active packaging rule whose inventory cost is unknown, CostingRules returns Known=false and ReportingQueryService appends the packaging item name to Missing but does not change totalLines or knownLines (dish-line counters). OwnerDashboardQueryService/ProfitabilityRules derive IsFoodCostComplete solely from those counts. Therefore, if all dish recipes are costed, the dashboard can report IsFoodCostComplete=true while its cost report has an unresolved packaging component; the Cashier UI warning banner and attention warning are gated on !IsFoodCostComplete and will not surface that missing packaging entry. This validates the existing FIN-CAND-PACKAGING-COVERAGE-001 and adds the UI source path; do not create a second finding ID. No full endpoint/UI runtime reproduction was executed.",
  "finding_candidate": "FIN-CAND-PACKAGING-COVERAGE-001",
  "related_existing_findings": [
    "FIN-CAND-PACKAGING-COVERAGE-001"
  ],
  "severity": "MEDIUM (existing candidate; accounting completeness / misleading report indicator, not demonstrated ledger loss)",
  "confidence": "High for source control/data flow and warning gating; runtime/native rendering not tested.",
  "manual_reasoning": {
    "configuration": "SaveOrderPackagingRuleHandler.HandleAsync validates a chosen inventory item and positive quantity, applies menu_manage authorization, upserts one active/inactive rule by order type, and saves. Existing integration test asserts only that the rule can be stored/read; it does not cover cost completeness.",
    "cost_resolution": "CostingRules.OrderPackagingCost selects the active rule for an order type. No rule/inactive rule is represented as known zero by current policy; a found rule whose item cost cannot resolve returns zero partial amount, Known=false, and the item name.",
    "aggregation": "ReportingQueryService.GetFoodCostReportAsync first increments totalLines for each noncancelled sold item and increments knownLines only when that dish recipe is complete. It then separately groups sold orders by order type, computes packaging once per order, and on !known adds its name to Missing and continues without changing knownLines. Thus returned Missing may be nonempty even when knownLines==totalLines.",
    "dashboard_propagation": "OwnerDashboardQueryService.BuildProfitability passes FoodCostReportDto numeric amount and SoldLineCount/KnownLineCount to ProfitabilityRules; the latter marks complete from knownLineCount>=soldLineCount. It forwards Missing as ItemsWithUnknownCost separately, but ProfitabilityDto.IsFoodCostComplete is sourced from gross.IsComplete.",
    "ui_consequence": "OwnerDashboardViewModel.RebuildMetrics uses IsFoodCostComplete for its green/unknown caption; RebuildAttention adds an unknown-cost warning only when that flag is false; HasUnknownFoodCost drives XAML banner Visibility. Therefore the missing package name alone does not activate these UI warning paths when dish counters show complete. Source confirms the gate; no live UI observation claimed.",
    "counterevidence": "Missing packaging is still present in FoodCostReportDto.Missing and ProfitabilityDto.ItemsWithUnknownCost. The separate reporting screen may expose the missing list; it was not traced here. A no-rule optional packaging cost is intentionally known zero, distinct from an active rule with unresolved cost. The rule is order-level and counted per order by design.",
    "tests": "Existing domain tests check known/incomplete food line counts, and the integration test checks rule persistence. Search found no test asserting a known dish plus unknown active order packaging must mark the aggregate DTO/UI incomplete. No test suite was run.",
    "severity_rationale": "Financial report completeness and a dashboard attention state may be falsely positive; total cost/profit can be overstated by the unresolved package cost. It does not itself alter ledger balances or prove money movement loss."
  },
  "recommended_action": "Keep packaging cost in the per-order aggregate, but feed its known/unknown state into an explicit aggregate cost-completeness result consumed by ProfitabilityRules/OwnerDashboardQueryService and DTO. Ensure the UI warning gate uses that aggregate state, while preserving separate sold-dish counts and one-package-per-order cardinality. Keep no-active-rule semantics explicitly known-zero only if owner confirms optional packaging is valid.",
  "required_tests": [
    "Known dish plus active packaging rule with unknown item cost yields nonempty Missing and aggregate IsFoodCostComplete=false.",
    "The owner dashboard attention list and warning banner appear for that case; native visual rendering is a separate verification.",
    "Known active packaging cost is included once per order type/order, independent of item quantity.",
    "No active packaging rule remains known zero only under confirmed optional-packaging policy.",
    "Dish cost gaps and packaging gaps both contribute to aggregate incompleteness without corrupting SoldLineCount/KnownLineCount meanings.",
    "Report DTO and dashboard source projections agree on incomplete aggregate cost state."
  ],
  "acceptance_criteria": [
    "A nonempty missing list for a cost component required by an active sold-order rule cannot coexist with a complete aggregate profitability flag.",
    "Dashboard warning visibility reflects unknown order packaging cost.",
    "Per-order packaging is not multiplied by item count.",
    "No treasury, stock ledger, or sales amount side effects are introduced by report calculation.",
    "No duplicate finding ID is created; canonical FIN-CAND-PACKAGING-COVERAGE-001 includes cross-layer evidence and verification limits."
  ],
  "runtime": "NOT_EXECUTED. Only source and existing test source inspected; no build/test/HTTP/database/UI interaction.",
  "limits": [
    "No SQL Server query executed and no test run.",
    "No native dashboard screenshot/visual check.",
    "Owner policy on whether absence of a configured packaging rule is always optional known-zero remains an assumption encoded in code.",
    "This comparison does not certify all report calculations."
  ],
