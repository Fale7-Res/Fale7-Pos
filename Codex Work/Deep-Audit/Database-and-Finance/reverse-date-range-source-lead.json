{
  "id": "FIN-LEAD-REVERSED-RANGE-001",
  "at_utc": "2026-10-18T04:28:53.229660+00:00",
  "status": "SOURCE_SUPPORTED_CANDIDATE_PENDING_INDEPENDENT_CHALLENGE",
  "severity_proposed": "MEDIUM",
  "confidence": "HIGH_STATIC_CHAIN_NOT_RUNTIME",
  "baseline": "c35816ecae49633674775dd32061c6ee92f94aaf",
  "title": "Reversed report endpoints normalize sales but independently filter cost with contradictory date bounds",
  "evidence_chain": [
    "Owner-dashboard endpoint1976-1983 accepts from/to through BusinessDateRange.Resolve with no local ordering rejection after report permission check. DateOnly syntax binding does not impose cross-field order.",
    "Resolve65-71 preserves reversed endpoints; ToUtcRange calls UtcRangeForBusinessDates47-53 which swaps only local arguments. DayCount and Days retain original order.",
    "ReportingQueryService.LoadSalesOrdersAsync normalizes through ToUtcRange, whereas Range241-246 independently constructs start from From and end from To. For separated reversed days start>=end, food-cost query has no matching timestamp. Adjacent reversed days give start=end, also empty.",
    "OwnerDashboard.GetAsync passes same range to sales but raw From/To to food cost; BuildProfitability uses net sales and zero sold/known cost lines. ProfitabilityRules.ComputeGrossProfit treats soldLineCount0 as complete, permits nonzero sales/zero cost and100percent margin.",
    "Owner response preserves reversed From/To and potentially negative DayCount; trend Days can be empty while aggregate sales are nonempty."
  ],
  "preconditions": [
    "Authorized reports actor, dates supplied in reverse order across at least two distinct calendar dates, and qualifying sales within normalized interval.",
    "Assumes no uninspected upstream custom validation rejects reversed report query before this endpoint; endpoint itself does not."
  ],
  "impact": "Misleading cost/profit/report period, not a proven money posting or authorization bypass. Static financial report correctness candidate.",
  "counterevidence": [
    "Normal correctly ordered UI dates unaffected; UI may constrain date inputs, not yet checked for every client.",
    "No DB records read/written and no HTTP request executed. Exact provider and DTO runtime chain untested.",
    "FoodCost missing details remain an independent packaging-cost issue; this lead concerns period mismatch."
  ],
  "recommended_solution": "Validate or normalize range once at construction/endpoint and pass one canonical range to every report component; reject or consistently normalize reversed input. Do not silently swap in only one query helper.",
  "required_tests": [
    "Pure forward/same/reversed range invariants, Days and DayCount consistency.",
    "Authorized isolated seeded report test with nonzero sales and known recipe cost, reversing endpoints; assert shared row scope or400 rejection.",
    "Check direct food-cost/expense/action report endpoints follow same agreed date contract."
  ],
  "independent_verification": "PENDING; root source tracing only",
  "runtime_verification": "PARTIAL_PURE_COMPONENTS_ONLY_NOT_DB_OR_ENDPOINT",
