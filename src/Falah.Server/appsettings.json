{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "//Urls": "The address the till connects to. Set here rather than on the command line so the service and a normal run listen identically.",
  "Urls": "http://localhost:5151",
  "Backup": {
    "DefaultDirectory": "E:/falah-restaurant/Backups",
    "Automatic": {
      "Enabled": true,
      "MaxAgeHours": 20,
      "CheckIntervalMinutes": 30,
      "KeepCount": 60,
      "StartupDelaySeconds": 90
    }
  }
}
