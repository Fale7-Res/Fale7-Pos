<UserControl x:Class="Falah.Client.CallCenterWinUI.Controls.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!--
        Shared "nothing here yet" placeholder - every management list screen (no purchases, no
        drivers, no employees...) shows the same visual language instead of a bare empty table, per
        the design-system requirement to cover loading/empty/error/permission-denied states once.
    -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="40" MaxWidth="360">
        <FontIcon Glyph="&#xE71D;" FontSize="32" Foreground="{StaticResource TextMutedBrush}"
                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock x:Name="TitleBlock" Style="{StaticResource SectionTitleText}"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock x:Name="MessageBlock" Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
