<UserControl x:Class="Falah.Client.CallCenterWinUI.Controls.ErrorStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!--
        Shared "the API call failed" placeholder - every module's Arabic-mapped ApiResult error
        message (see ApiClient's ApiResult wrapper) lands here verbatim, with an optional retry.
    -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="40" MaxWidth="380">
        <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="{StaticResource DangerBrush}"
                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock x:Name="TitleBlock" Style="{StaticResource SectionTitleText}"
                   HorizontalAlignment="Center" TextAlignment="Center" Text="تعذر تحميل البيانات"/>
        <TextBlock x:Name="MessageBlock" Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Name="RetryButton" Content="إعادة المحاولة" Style="{StaticResource SecondaryButtonStyle}"
                HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnRetryClick"
                Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
