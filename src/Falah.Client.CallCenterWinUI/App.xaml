<Application x:Class="Falah.Client.CallCenterWinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Falah.Client.CallCenterWinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <conv:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <conv:EmptyStringToVisibleConverter x:Key="EmptyStringToVisibleConverter"/>
            <conv:ShiftDotBrushConverter x:Key="ShiftDotBrushConverter"/>
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
            <conv:StringEqualsToBrushConverter x:Key="StringEqualsToBrushConverter"/>
            <conv:StringEqualsToVisibleConverter x:Key="StringEqualsToVisibleConverter"/>
            <conv:CountGreaterThanOneToVisibleConverter x:Key="CountGreaterThanOneToVisibleConverter"/>
            <conv:PiastresToDisplayConverter x:Key="PiastresToDisplayConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:EmptyCollectionToVisibleConverter x:Key="EmptyCollectionToVisibleConverter"/>
            <conv:NonEmptyCollectionToVisibleConverter x:Key="NonEmptyCollectionToVisibleConverter"/>
            <conv:CairoBusinessDateConverter x:Key="CairoBusinessDateConverter"/>
            <conv:TimeOfDayConverter x:Key="TimeOfDayConverter"/>
            <conv:StatusToPillBrushConverter x:Key="StatusToPillBrushConverter"/>
            <conv:ImageUriToSourceConverter x:Key="ImageUriToSourceConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
