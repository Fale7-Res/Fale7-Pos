<UserControl x:Class="Falah.Client.CallCenterWinUI.Views.CallCenterDeliveryEditorView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CallCenterWinUI.Controls"
             FlowDirection="RightToLeft">
    <!--
        The caller + address capture form. A phone order is taken while someone waits on the line, so
        this is a focused full-screen step rather than a permanently-expanded column: the phone field
        is first because it is the customer's IDENTITY (CustomerQueryService looks up by phone, never
        by name), and a recognised caller's saved addresses collapse the rest of the form into one tap.
        Field order matches DeliveryRules.FirstMissingDeliveryField exactly, so what this form asks for
        in sequence is what the server will demand at checkout.
    -->
    <Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsDeliveryEditorOpen, Converter={StaticResource BoolToVisibleConverter}}">
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" MaxWidth="760" Margin="28"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ModalHeaderView Padding="24,18" Title="{Binding CustomerEditorTitle}"
                                          CloseCommand="{Binding CloseDeliveryEditorCommand}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="24,0,24,20" Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox MaxLength="30" Header="رقم الهاتف" InputScope="TelephoneNumber" MinHeight="44"
                                     Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="بحث عن العميل" VerticalAlignment="Bottom" MinHeight="44"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LookupCustomerCommand}"/>
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLookingUpCustomer, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <TextBlock Text="{Binding CustomerLookupNote}" TextWrapping="Wrap" Foreground="{ThemeResource TextMutedBrush}"
                                   Visibility="{Binding CustomerLookupNote, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <TextBox MaxLength="200" Header="اسم العميل" MinHeight="44"
                                 Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Pickup: the name and phone are enough; a time only if the customer named one. -->
                        <StackPanel Spacing="10" Visibility="{Binding IsPickup, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="موعد الاستلام (اختياري)" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Text="سيبه فاضي لو العميل جاي على طول. لو حدد ميعاد، اختار اليوم والساعة الاتنين."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Not bound: a bound null reaches the pickers as 1/1/1926 and 0:00 (see the code-behind). -->
                                <CalendarDatePicker x:Name="PickupDatePicker" Header="اليوم" PlaceholderText="اختر اليوم" HorizontalAlignment="Stretch" MinHeight="44"
                                                    AutomationProperties.AutomationId="CallCenter_PickupDate" DateChanged="OnPickupDateChanged"/>
                                <!-- Audit 2026-11-25 U16: two lists with Arabic placeholders instead of the framework TimePicker
                                     ("hour"/"minute" in English). -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="الساعة"/>
                                    <Grid ColumnSpacing="6" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PickupHourBox" PlaceholderText="الساعة" HorizontalAlignment="Stretch" MinHeight="44"
                                                  AutomationProperties.AutomationId="CallCenter_PickupHour" AutomationProperties.Name="ساعة الاستلام"
                                                  SelectionChanged="OnPickupTimePartChanged"/>
                                        <ComboBox x:Name="PickupMinuteBox" Grid.Column="1" PlaceholderText="الدقيقة" HorizontalAlignment="Stretch" MinHeight="44"
                                                  AutomationProperties.AutomationId="CallCenter_PickupMinute" AutomationProperties.Name="دقيقة الاستلام"
                                                  SelectionChanged="OnPickupTimePartChanged"/>
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2" Content="بدون موعد" VerticalAlignment="Bottom" MinHeight="44"
                                        Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearPickupTimeCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Delivery: the address and the zone that sets the fee. -->
                        <StackPanel Spacing="14" Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibleConverter}}">
                        <ComboBox Header="عنوان محفوظ" HorizontalAlignment="Stretch" MinHeight="44"
                                  ItemsSource="{Binding SavedAddresses}" SelectedItem="{Binding SelectedSavedAddress, Mode=TwoWay}"
                                  DisplayMemberPath="FullText"
                                  Visibility="{Binding SavedAddresses.Count, Converter={StaticResource CountToVisibleConverter}}"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox Header="خدمة التوصيل" HorizontalAlignment="Stretch" MinHeight="44"
                                            PlaceholderText="اكتب جزء من اسم الخدمة" AutomationProperties.AutomationId="Delivery_ServiceSearch"
                                            Text="{Binding DeliveryServiceQuery, Mode=OneWay}" ItemsSource="{Binding DeliveryServiceSuggestions}"
                                            DisplayMemberPath="PickerLabel" TextMemberPath="Name"
                                            TextChanged="OnServiceTextChanged" SuggestionChosen="OnServiceChosen"
                                            QuerySubmitted="OnServiceSubmitted" GotFocus="OnServiceFocused"/>
                            <TextBox Grid.Column="1" Header="المنطقة" MinHeight="44"
                                     Text="{Binding DeliveryArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBox Header="الشارع" MinHeight="44"
                                 Text="{Binding DeliveryStreet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Header="المبنى" MinHeight="44"
                                     Text="{Binding DeliveryBuilding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="1" Header="الدور" MinHeight="44"
                                     Text="{Binding DeliveryFloor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Header="الشقة" MinHeight="44"
                                     Text="{Binding DeliveryApartment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBox Header="علامة مميزة" MinHeight="44"
                                 Text="{Binding DeliveryLandmark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox MaxLength="500" Header="ملاحظات التوصيل" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding DeliveryNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{Binding DeliveryServicesError}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding DeliveryServicesError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="تحديث خدمات التوصيل" Style="{StaticResource GhostButtonStyle}" MinHeight="44"
                                HorizontalAlignment="Right" Command="{Binding LoadDeliveryServicesCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding DeliveryError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding DeliveryError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="حفظ البيانات" HorizontalAlignment="Stretch" MinHeight="52"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SaveDeliveryDetailsCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
