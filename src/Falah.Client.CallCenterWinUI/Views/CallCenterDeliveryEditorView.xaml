<UserControl x:Class="Falah.Client.CallCenterWinUI.Views.CallCenterDeliveryEditorView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CallCenterWinUI.Controls"
             FlowDirection="RightToLeft">
    <!--
        The caller + address capture form. A phone order is taken while someone waits on the line, so
        this is a focused full-screen step rather than a permanently-expanded column: the phone field
        is first because it is the customer's IDENTITY (CustomerQueryService looks up by phone, never
        by name), and a recognised caller's saved addresses collapse the rest of the form into one tap.
        Field order matches DeliveryRules.FirstMissingDeliveryField exactly, so what this form asks for
        in sequence is what the server will demand at checkout.
    -->
    <Grid Background="#66313D35" Visibility="{Binding IsDeliveryEditorOpen, Converter={StaticResource BoolToVisibleConverter}}">
        <Border Background="White" CornerRadius="20" MaxWidth="760" Margin="28"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ModalHeaderView Padding="24,18" Title="بيانات العميل والتوصيل"
                                          CloseCommand="{Binding CloseDeliveryEditorCommand}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="24,0,24,20" Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Header="رقم الهاتف" InputScope="TelephoneNumber" MinHeight="44"
                                     Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="بحث عن العميل" VerticalAlignment="Bottom" MinHeight="44"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LookupCustomerCommand}"/>
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLookingUpCustomer, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <TextBlock Text="{Binding CustomerLookupNote}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding CustomerLookupNote, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <TextBox Header="اسم العميل" MinHeight="44"
                                 Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox Header="عنوان محفوظ" HorizontalAlignment="Stretch" MinHeight="44"
                                  ItemsSource="{Binding SavedAddresses}" SelectedItem="{Binding SelectedSavedAddress, Mode=TwoWay}"
                                  Visibility="{Binding SavedAddresses.Count, Converter={StaticResource CountToVisibleConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Area}"/><Run Text=" — "/><Run Text="{Binding Street}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="خدمة التوصيل" HorizontalAlignment="Stretch" MinHeight="44"
                                      ItemsSource="{Binding DeliveryServices}" SelectedItem="{Binding SelectedDeliveryService, Mode=TwoWay}"
                                      DisplayMemberPath="Name"/>
                            <TextBox Grid.Column="1" Header="المنطقة" MinHeight="44"
                                     Text="{Binding DeliveryArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBox Header="الشارع" MinHeight="44"
                                 Text="{Binding DeliveryStreet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Header="المبنى" MinHeight="44"
                                     Text="{Binding DeliveryBuilding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="1" Header="الدور" MinHeight="44"
                                     Text="{Binding DeliveryFloor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Header="الشقة" MinHeight="44"
                                     Text="{Binding DeliveryApartment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBox Header="علامة مميزة" MinHeight="44"
                                 Text="{Binding DeliveryLandmark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Header="ملاحظات التوصيل" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding DeliveryNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{Binding DeliveryServicesError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding DeliveryServicesError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="تحديث خدمات التوصيل" Style="{StaticResource GhostButtonStyle}" MinHeight="44"
                                HorizontalAlignment="Right" Command="{Binding LoadDeliveryServicesCommand}"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding DeliveryError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding DeliveryError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="حفظ بيانات التوصيل" HorizontalAlignment="Stretch" MinHeight="52"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SaveDeliveryDetailsCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
