<UserControl x:Class="Falah.Client.CallCenterWinUI.Views.CallCenterOrderPanelView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!--
        Order-intake workspace: caller details (top), order lines (the only scrolling region), then
        payment + submit pinned to the bottom. Kept in its own file, split from CallCenterView.xaml's
        GridView-based sibling views - see CashierView.xaml.cs's documented WinUI 3 XamlCompiler crash
        and CartPanelView.xaml's identical split for why.

        A phone order is entered while a customer is waiting on the line, so the caller fields sit
        ABOVE the item list: the operator captures who is calling first, then builds the order while
        talking, rather than discovering a required address field only at checkout.
    -->
    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Margin="12,14,0,14">
        <Border.Shadow><ThemeShadow/></Border.Shadow>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CALLER DETAILS (compact) -->
            <Grid Grid.Row="0" IsHitTestVisible="{Binding CanEditOperation}">
                <StackPanel Padding="16,16,16,12" Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="طلب توصيل هاتفي" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#EDF3EE" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource BrandPrimaryBrush}" FontSize="13">
                                <Run Text="{Binding CartItemCount}"/><Run Text=" صنف"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Phone stays inline: it is the very first thing typed when the call connects,
                         and it is the customer's identity for lookup. Everything else lives one tap
                         away so the order lines below keep their vertical space. -->
                    <TextBox PlaceholderText="رقم هاتف العميل" InputScope="TelephoneNumber" MinHeight="44"
                             Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding CustomerLookupNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               Visibility="{Binding CustomerLookupNote, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <!-- The icon is state, not decoration: a checkmark once every field the server
                         will demand at checkout is present, a warning while something is still
                         missing - so the operator learns the order is incomplete while the customer
                         is still on the line, not at submit. -->
                    <Button Command="{Binding OpenDeliveryEditorCommand}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DeliverySummary}" TextWrapping="Wrap" FontSize="12" MaxLines="3"
                                       VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                      Foreground="{StaticResource SuccessBrush}"
                                      Visibility="{Binding HasDeliveryDetails, Converter={StaticResource BoolToVisibleConverter}}"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center"
                                      Foreground="{StaticResource WarningBrush}"
                                      Visibility="{Binding HasDeliveryDetails, Converter={StaticResource InverseBoolToVisibleConverter}}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ORDER LINES -->
            <Grid Grid.Row="1" IsHitTestVisible="{Binding CanEditOperation}">
                <StackPanel x:Name="EmptyCartHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24">
                    <Border Width="64" Height="64" CornerRadius="22" Background="#F0F4EE" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE717;" FontSize="26" Foreground="{StaticResource BrandPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="لا توجد أصناف بعد" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="اختر الأصناف من القائمة أثناء المكالمة" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <ScrollViewer x:Name="CartScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cart}" Padding="16,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding ProductName}" Style="{StaticResource CartItemNameText}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding VariantName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                           Visibility="{Binding VariantName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                <TextBlock Text="{Binding AppliedOfferName}" FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}"
                                                           Visibility="{Binding AppliedOfferName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="×" AutomationProperties.Name="حذف الصنف"
                                                    Style="{StaticResource GhostButtonStyle}" MinHeight="44" Padding="0" FontSize="22" VerticalAlignment="Top"
                                                    Command="{Binding ElementName=Root, Path=DataContext.RemoveLineCommand}" CommandParameter="{Binding}"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="+" AutomationProperties.Name="زيادة الكمية" Style="{StaticResource QuantityButtonStyle}"
                                                        Command="{Binding ElementName=Root, Path=DataContext.IncreaseQuantityCommand}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Button Content="−" AutomationProperties.Name="تقليل الكمية" Style="{StaticResource QuantityButtonStyle}"
                                                        Command="{Binding ElementName=Root, Path=DataContext.DecreaseQuantityCommand}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LineTotalDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding UnitPriceDisplay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   Visibility="{Binding Notes, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        <Button Content="ملاحظات التحضير" Style="{StaticResource GhostButtonStyle}" FontSize="12" Padding="0"
                                                MinHeight="44" HorizontalAlignment="Right">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel Width="260" Spacing="8">
                                                        <TextBox Header="ملاحظات للمطبخ" TextWrapping="Wrap" AcceptsReturn="True"
                                                                 Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Content="بدون بصل" Tag="بدون بصل" Click="OnNoteChipClicked" Style="{StaticResource SecondaryButtonStyle}"/>
                                                        <Button Content="حار" Tag="حار" Click="OnNoteChipClicked" Style="{StaticResource SecondaryButtonStyle}"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- PAYMENT + SUBMIT -->
            <Border Grid.Row="2" Background="#F9FAF7" CornerRadius="0,0,18,18" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="4" Background="#F0F3EF" CornerRadius="12" Padding="4"
                          IsHitTestVisible="{Binding CanEditOperation}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="عند الاستلام" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                Command="{Binding SetPaymentMethodCommand}" CommandParameter="cash"
                                Background="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|WhiteBrush|TransparentBrush}"
                                Foreground="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|BrandPrimaryBrush|TextMutedBrush}"/>
                        <Button Grid.Column="1" Content="إنستاباي" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                Command="{Binding SetPaymentMethodCommand}" CommandParameter="instapay"
                                Background="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|WhiteBrush|TransparentBrush}"
                                Foreground="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|BrandPrimaryBrush|TextMutedBrush}"/>
                        <Button Grid.Column="2" Content="محفظة" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                Command="{Binding SetPaymentMethodCommand}" CommandParameter="wallet"
                                Background="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=wallet|WhiteBrush|TransparentBrush}"
                                Foreground="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=wallet|BrandPrimaryBrush|TextMutedBrush}"/>
                    </Grid>
                    <TextBox PlaceholderText="اسم المحفظة (فودافون كاش، إلخ)" MinHeight="44"
                             Text="{Binding WalletProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding PaymentMethod, Converter={StaticResource StringEqualsToVisibleConverter}, ConverterParameter=wallet}"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المجموع الفرعي" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CartSubtotalDisplay}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الإجمالي شامل التوصيل" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding GrandTotalDisplay}" Style="{StaticResource TotalAmountText}"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Text="{Binding CheckoutError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding CheckoutError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <Button AutomationProperties.AutomationId="SubmitCallCenterOrderButton" Style="{StaticResource CtaButtonStyle}"
                            HorizontalAlignment="Stretch" MinHeight="52" Command="{Binding SubmitOrderCommand}"
                            IsEnabled="{Binding IsShiftOpen}">
                        <TextBlock FontWeight="Bold" FontSize="16" Foreground="White">
                            <Run Text="تسجيل الطلب"/><Run Text=" • "/><Run Text="{Binding GrandTotalDisplay}"/>
                        </TextBlock>
                    </Button>

                    <Button Content="إلغاء الطلب" Style="{StaticResource GhostButtonStyle}" FontSize="12"
                            HorizontalAlignment="Center" MinHeight="44"
                            IsEnabled="{Binding CanEditOperation}" Command="{Binding ClearOrderCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
