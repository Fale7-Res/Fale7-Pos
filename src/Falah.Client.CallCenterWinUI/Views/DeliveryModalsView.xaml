<UserControl x:Class="Falah.Client.CallCenterWinUI.Views.DeliveryModalsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CallCenterWinUI.Controls"
             FlowDirection="RightToLeft">
    <!-- Assign / record-outcome / driver-settlement dialogs, split out of DeliveryView so that file
         keeps a single templated region per concern (same file-splitting discipline the Cashier
         screens follow for the documented XamlCompiler crash). -->
    <Grid>

        <!-- ================= ASSIGN TO DRIVER ================= -->
        <Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsAssignOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="إسناد الطلب لسائق" CloseCommand="{Binding CloseAssignCommand}"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                        <Run Text="الطلب "/><Run Text="{Binding AssignTarget.OrderNumber}" FontWeight="Bold"/>
                        <Run Text=" — للتحصيل "/><Run Text="{Binding AssignCollectDisplay}"/>
                    </TextBlock>

                    <!-- Assignment IS physical receipt in this system: handing the order to the driver
                         and opening their cash custody happen in one server-side step. -->
                    <TextBlock Text="اختيار السائق يعني تسليمه الطلب وفتح عهدة نقدية باسمه."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>

                    <ComboBox IsEnabled="{Binding CanEditAction}" Header="السائق" HorizontalAlignment="Stretch" MinHeight="44"
                              ItemsSource="{Binding Drivers}" SelectedItem="{Binding AssignDriver, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>

                    <!-- Owner, 2026-11-24: a driver who already holds the custody limit takes a new cash order only
                         with a manager's PIN. Left empty in the ordinary case. -->
                    <PasswordBox IsEnabled="{Binding CanEditAction}" Header="رمز المدير (لو السائق عدّى حد العهدة بس)" MinHeight="44" FontSize="16"
                                 Password="{Binding AssignManagerPin, Mode=TwoWay}" AutomationProperties.Name="رمز المدير لتعدي حد العهدة"/>

                    <TextBlock Text="{Binding AssignError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding AssignError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <Button Content="تأكيد الإسناد" MinHeight="52" HorizontalAlignment="Stretch"
                            Style="{StaticResource CtaButtonStyle}" Command="{Binding ConfirmAssignCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= CANCEL AN UNPAID ORDER (workflow redesign, owner 2026-11-24) =================
             Before the kitchen has its paper: a plain confirmation, every ingredient back. After it: the
             manager's PIN, then whether the food was prepared. A paid order is refunded, never cancelled here. -->
        <!-- ================= QUEUE: MOVE AN ORDER TO ANOTHER DRIVER (owner's trial 2026-11-25) =================
             The same custody moves to the new driver; a dispatch slip prints for him. A reason is required. -->
        <Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsReassignOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="{Binding ReassignTitle}" CloseCommand="{Binding CloseReassignCommand}"/>
                    <TextBlock Text="{Binding ReassignTarget.CustomerDisplay}" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="الفلوس اللي على الطلب بتتنقل لعهدة السائق الجديد، وتتطبعله ورقة تسليم." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <ComboBox IsEnabled="{Binding CanEditAction}" Header="السائق الجديد" HorizontalAlignment="Stretch" MinHeight="44"
                              AutomationProperties.AutomationId="Reassign_Driver"
                              ItemsSource="{Binding ReassignDriverOptions}" SelectedItem="{Binding ReassignDriver, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                    <TextBox Header="سبب النقل (إلزامي)" MinHeight="44" TextWrapping="Wrap" MaxLength="300" IsEnabled="{Binding CanEditAction}"
                             AutomationProperties.AutomationId="Reassign_Reason"
                             Text="{Binding ReassignReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding ReassignError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding ReassignError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="انقل الطلب" MinHeight="52" HorizontalAlignment="Stretch" Style="{StaticResource CtaButtonStyle}"
                                AutomationProperties.AutomationId="Reassign_Confirm" Command="{Binding ConfirmReassignCommand}"/>
                        <Button Grid.Column="1" Content="رجوع" MinHeight="52" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="Reassign_Back" Command="{Binding CloseReassignCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= QUEUE: «ترحيل» (owner, 2026-11-25) =================
             Clears the queue's screen of finished orders for the next shift; an order still in progress stays until it
             finishes. Nothing is deleted. -->
        <Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsQueueClearOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="ترحيل الطابور" CloseCommand="{Binding CloseQueueClearCommand}"/>
                    <TextBlock Text="اختار اللي عايز تشيله من الواجهة:" Style="{StaticResource SectionTitleText}"/>
                    <CheckBox Content="التوصيل" MinHeight="44" IsChecked="{Binding QueueClearDeliveries, Mode=TwoWay}"
                              AutomationProperties.AutomationId="QueueClear_Deliveries"/>
                    <CheckBox Content="الاستلام من الفرع" MinHeight="44" IsChecked="{Binding QueueClearPickups, Mode=TwoWay}"
                              AutomationProperties.AutomationId="QueueClear_Pickups"/>
                    <TextBlock Text="{Binding QueueClearSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="QueueClear_Summary"/>
                    <Border Background="{ThemeResource WarningBackgroundBrush}" CornerRadius="10" Padding="12,10"
                            Visibility="{Binding HasQueueClearWarning, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="{Binding QueueClearWarning}" Foreground="{ThemeResource WarningTextBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="QueueClear_Warning"/>
                    </Border>
                    <TextBlock Text="{Binding QueueClearError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding QueueClearError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="إزالة من الواجهة" MinHeight="52" HorizontalAlignment="Stretch" Style="{StaticResource CtaButtonStyle}"
                                AutomationProperties.AutomationId="QueueClear_Confirm" Command="{Binding ConfirmQueueClearCommand}"/>
                        <Button Grid.Column="1" Content="رجوع" MinHeight="52" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="QueueClear_Back" Command="{Binding CloseQueueClearCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsQueueCancelOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="{Binding QueueCancelTitle}" CloseCommand="{Binding CloseQueueCancelCommand}"/>
                    <TextBlock Text="{Binding QueueCancelTarget.CustomerDisplay}" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="{Binding QueueCancelEffect}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="QueueCancel_Effect"/>
                    <TextBox Header="سبب الإلغاء (إلزامي)" MinHeight="44" TextWrapping="Wrap" IsEnabled="{Binding CanEditAction}"
                             AutomationProperties.AutomationId="QueueCancel_Reason"
                             Text="{Binding QueueCancelReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Spacing="8" Visibility="{Binding QueueCancelNeedsAdmin, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="محتاج اعتماد المدير" Style="{StaticResource SectionTitleText}" Foreground="{ThemeResource WarningTextBrush}"/>
                        <PasswordBox PlaceholderText="رمز المدير" MinHeight="44" IsEnabled="{Binding CanEditAction}"
                                     AutomationProperties.AutomationId="QueueCancel_ManagerPin" AutomationProperties.Name="رمز المدير لاعتماد الإلغاء"
                                     Visibility="{Binding QueueCancelAsksForPin, Converter={StaticResource BoolToVisibleConverter}}"
                                     Password="{Binding QueueCancelManagerPin, Mode=TwoWay}"/>
                        <TextBlock Text="هل الأكل اتحضّر؟" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <RadioButton GroupName="QueueCancelFood" Content="أيوه، اتحضّر - الخامات ما ترجعش للمخزون" IsEnabled="{Binding CanEditAction}"
                                     AutomationProperties.AutomationId="QueueCancel_Prepared" IsChecked="{Binding IsQueueCancelPrepared, Mode=TwoWay}"/>
                        <RadioButton GroupName="QueueCancelFood" Content="لأ، ما اتحضّرش - الخامات ترجع للمخزون" IsEnabled="{Binding CanEditAction}"
                                     AutomationProperties.AutomationId="QueueCancel_NotPrepared" IsChecked="{Binding IsQueueCancelNotPrepared, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QueueCancelError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding QueueCancelError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="إلغاء الطلب" MinHeight="52" HorizontalAlignment="Stretch" Style="{StaticResource CtaButtonStyle}"
                                AutomationProperties.AutomationId="QueueCancel_Confirm" Command="{Binding ConfirmQueueCancelCommand}"/>
                        <Button Grid.Column="1" Content="سيب الطلب" MinHeight="52" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="QueueCancel_Keep" Command="{Binding CloseQueueCancelCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= RECORD OUTCOME ================= -->
        <Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsOutcomeOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" Width="460" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <controls:ModalHeaderView Title="تسجيل نتيجة التوصيل" CloseCommand="{Binding CloseOutcomeCommand}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                            <Run Text="الطلب "/><Run Text="{Binding OutcomeTarget.OrderNumber}" FontWeight="Bold"/>
                            <Run Text=" — مع "/><Run Text="{Binding OutcomeTarget.DriverName}"/>
                        </TextBlock>

                        <Grid ColumnSpacing="6" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="12" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="تم التسليم" Style="{StaticResource SegmentButtonStyle}" FontSize="12"
                                    Command="{Binding SetOutcomeResultCommand}" CommandParameter="delivered"
                                    Background="{Binding OutcomeResult, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=delivered|CardBackgroundBrush|TransparentBrush}"
                                    Foreground="{Binding OutcomeResult, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=delivered|BrandPrimaryBrush|TextMutedBrush}"/>
                            <Button Grid.Column="1" Content="فشل" Style="{StaticResource SegmentButtonStyle}" FontSize="12"
                                    Command="{Binding SetOutcomeResultCommand}" CommandParameter="failed"
                                    Background="{Binding OutcomeResult, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=failed|CardBackgroundBrush|TransparentBrush}"
                                    Foreground="{Binding OutcomeResult, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=failed|BrandPrimaryBrush|TextMutedBrush}"/>
                            <Button Grid.Column="2" Content="مرتجع" Style="{StaticResource SegmentButtonStyle}" FontSize="12"
                                    Command="{Binding SetOutcomeResultCommand}" CommandParameter="returned"
                                    Background="{Binding OutcomeResult, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=returned|CardBackgroundBrush|TransparentBrush}"
                                    Foreground="{Binding OutcomeResult, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=returned|BrandPrimaryBrush|TextMutedBrush}"/>
                        </Grid>

                        <!-- Delivered: the amount actually collected. A variance from the expected
                             figure requires a reason - enforced server-side by AssertCollectionAmount. -->
                        <StackPanel Spacing="8" Visibility="{Binding IsDeliveredOutcome, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBox IsEnabled="{Binding CanEditAction}" Header="المبلغ المحصّل بالجنيه" InputScope="Number" MinHeight="44" FontSize="18" TextAlignment="Center"
                                     Text="{Binding OutcomeCollectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="أي فرق عن المبلغ المتوقع يستوجب كتابة سبب. التحصيل الأقل من المستحق يحتاج اعتماد مدير أيضًا." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <!-- AUD-03: less than was due needs the authority that approves a settlement difference. -->
                            <StackPanel Spacing="6" Visibility="{Binding OutcomeShortfallNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                                <TextBlock Text="{Binding OutcomeShortfallLabel}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource WarningTextBrush}"/>
                                <PasswordBox IsEnabled="{Binding CanEditAction}" PlaceholderText="رمز المدير" MinHeight="44" FontSize="16"
                                             Password="{Binding OutcomeManagerPin, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Failed: a fixed reason code, not free text - the server rejects anything
                             outside its own ValidFailureReasons set. -->
                        <StackPanel Spacing="8" Visibility="{Binding IsFailedOutcome, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="سبب الفشل" Style="{StaticResource MutedText}"/>
                            <ItemsControl ItemsSource="{Binding FailureReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="44" Margin="0,0,0,6"
                                                Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Label}"
                                                Command="{Binding ElementName=Root, Path=DataContext.SetFailureReasonCommand}"
                                                CommandParameter="{Binding Code}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBox IsEnabled="{Binding CanEditAction}" Header="السبب / ملاحظة" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding OutcomeReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- A cash-on-delivery order that failed or came back is voided: the server needs
                             to know what became of its food. Shown only when that applies. -->
                        <StackPanel Spacing="6" Visibility="{Binding NeedsFoodDisposition, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="هل تم تحضير الطلب؟" Style="{StaticResource MutedText}"/>
                            <RadioButton GroupName="OutcomeFood" Content="تم التحضير — يُسجَّل هالكًا" IsEnabled="{Binding CanEditAction}"
                                         IsChecked="{Binding IsOutcomeFoodPrepared, Mode=TwoWay}"/>
                            <RadioButton GroupName="OutcomeFood" Content="لم يُحضَّر — تعود الخامات للمخزون" IsEnabled="{Binding CanEditAction}"
                                         IsChecked="{Binding IsOutcomeFoodNotPrepared, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding OutcomeError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding OutcomeError, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <Button Content="حفظ النتيجة" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding ConfirmOutcomeCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= DRIVER ACCOUNT + SETTLEMENT ================= -->
        <Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsDriverAccountOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" Width="480" MaxHeight="700"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <controls:ModalHeaderView Title="{Binding AccountDriver.Name}" CloseCommand="{Binding CloseDriverAccountCommand}"/>

                        <ProgressRing IsActive="True" Width="32" Height="32" HorizontalAlignment="Center"
                                      Visibility="{Binding IsLoadingAccount, Converter={StaticResource BoolToVisibleConverter}}"/>

                        <StackPanel Spacing="10" Visibility="{Binding DriverAccount, Converter={StaticResource NullToCollapsedConverter}}">
                            <Border Background="{ThemeResource NeutralBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="16">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="طلبات جارية" Style="{StaticResource TableCellText}" Foreground="{ThemeResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DriverAccount.ActiveOrderCount}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="طلبات منتهية غير مسوّاة" Style="{StaticResource TableCellText}" Foreground="{ThemeResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DriverAccount.CompletedUnsettledCount}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource CardBorderBrush}"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="العهدة النقدية المستحقة" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" FontSize="20" FontWeight="Black" Foreground="{ThemeResource BrandPrimaryBrush}"
                                                   Text="{Binding DriverAccount.CashCustodyPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Driver statistics: same dialog, same driver, read straight from
                                 /api/delivery/drivers/{id}/statistics - nothing recomputed here. -->
                            <Border Background="{ThemeResource NeutralBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="إحصائيات السائق" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ComboBox AutomationProperties.Name="فترة الإحصاءات" Grid.Column="1" MinWidth="150" MinHeight="40"
                                                  ItemsSource="{Binding StatsPeriods}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedStatsPeriod, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Stacked, not side by side: this dialog is narrow, and two DatePickers
                                         sharing its width clip their year column so a custom range spanning
                                         years cannot be read or set. -->
                                    <StackPanel Spacing="8" Visibility="{Binding IsCustomStatsPeriod, Converter={StaticResource BoolToVisibleConverter}}">
                                        <DatePicker Header="من" MinHeight="40" HorizontalAlignment="Stretch" Date="{Binding StatsFromDate, Mode=TwoWay}"/>
                                        <DatePicker Header="إلى" MinHeight="40" HorizontalAlignment="Stretch" Date="{Binding StatsToDate, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <ProgressRing IsActive="True" Width="24" Height="24" HorizontalAlignment="Center"
                                                  Visibility="{Binding IsLoadingStatistics, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    <TextBlock Text="{Binding StatisticsError}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding StatisticsError, Converter={StaticResource NullToCollapsedConverter}}"/>

                                    <Grid ColumnSpacing="8" RowSpacing="8"
                                          Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVisibleConverter}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                                        <StackPanel Spacing="2"><TextBlock Text="مُسندة" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.AssignedCount}" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="تم التسليم" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.DeliveredCount}" FontWeight="Bold" Foreground="{ThemeResource SuccessTextBrush}"/></StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="فشل" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.FailedCount}" FontWeight="Bold" Foreground="{ThemeResource DangerBrush}"/></StackPanel>

                                        <StackPanel Grid.Row="1" Spacing="2"><TextBlock Text="مرتجع" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.ReturnedCount}" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2"><TextBlock Text="قيمة الطلبات" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.OrderValuePiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2"><TextBlock Text="نقدية محصّلة" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.CashCollectedPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/></StackPanel>

                                        <StackPanel Grid.Row="2" Spacing="2"><TextBlock Text="العهدة الحالية" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.CurrentCustodyPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold" Foreground="{ThemeResource WarningTextBrush}"/></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2"><TextBlock Text="عدد التسويات" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.SettlementCount}" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2"><TextBlock Text="متوسط زمن التوصيل" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding AverageDeliveryMinutesDisplay}" FontWeight="Bold"/></StackPanel>

                                        <StackPanel Grid.Row="3" Spacing="2"><TextBlock Text="عجز التسويات" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.SettlementShortagesPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold" Foreground="{ThemeResource DangerBrush}"/></StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2"><TextBlock Text="زيادة التسويات" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding DriverStatistics.SettlementOveragesPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold" Foreground="{ThemeResource SuccessTextBrush}"/></StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="2" Spacing="2"><TextBlock Text="آخر طلب / آخر تسوية" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding LastOrderDisplay}" FontSize="11"/>
                                            <TextBlock Text="{Binding LastSettlementDisplay}" FontSize="11" Style="{StaticResource MutedText}"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Settlement is driver-scoped and all-or-nothing: the server refuses while
                                 any of this driver's orders is still out for delivery, and names them. -->
                            <StackPanel Spacing="8" Visibility="{Binding DriverAccount.BlockingOrders, Converter={StaticResource NonEmptyCollectionToVisibleConverter}}">
                                <TextBlock Text="لا يمكن التسوية الآن - طلبات ما زالت في الطريق:" Foreground="{ThemeResource WarningTextBrush}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding DriverAccount.BlockingOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,4">
                                                <Run Text="• "/><Run Text="{Binding OrderNumber}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The settlement figures, exactly as the server computes them: collected cash, the driver's
                                 delivery fees (his earnings), any balance carried from a partial settlement, and the net. -->
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <StackPanel Spacing="2"><TextBlock Text="نقدية حصّلها السائق" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding SettleCollectedText}" FontWeight="Bold" AutomationProperties.AutomationId="Settle_Collected"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="أجر التوصيل (للسائق)" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding SettleFeesText}" FontWeight="Bold" AutomationProperties.AutomationId="Settle_Fees"/></StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2"><TextBlock Text="رصيد مرحّل من تسوية سابقة" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding SettleCarriedText}" FontWeight="Bold" AutomationProperties.AutomationId="Settle_Carried"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2"><TextBlock Text="{Binding SettleNetLabel}" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding SettleNetText}" FontSize="18" FontWeight="Black" Foreground="{ThemeResource BrandPrimaryBrush}" AutomationProperties.AutomationId="Settle_Net"/></StackPanel>
                                </Grid>
                            </Border>

                            <TextBox IsEnabled="{Binding CanEditAction}" Header="المبلغ المسلَّم فعليًا بالجنيه" InputScope="Number" MinHeight="44" FontSize="18" TextAlignment="Center"
                                     AutomationProperties.AutomationId="Settle_Received"
                                     Text="{Binding SettleActualCashText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox IsEnabled="{Binding CanEditAction}" Header="يُصرف للسائق من الدرج بالجنيه" InputScope="Number" MinHeight="44" FontSize="18" TextAlignment="Center"
                                     AutomationProperties.AutomationId="Settle_PaidToDriver"
                                     Visibility="{Binding RestaurantOwesDriver, Converter={StaticResource BoolToVisibleConverter}}"
                                     Text="{Binding SettlePaidToDriverText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox IsEnabled="{Binding CanEditAction}" Content="تسوية جزئية - يُرحَّل الباقي للتسوية القادمة"
                                      AutomationProperties.AutomationId="Settle_KeepOpen"
                                      IsChecked="{Binding SettleKeepRemainderOpen, Mode=TwoWay}"/>
                            <TextBox IsEnabled="{Binding CanEditAction}" Header="سبب الفارق (إلزامي عند وجود فرق)" MinHeight="44" TextWrapping="Wrap"
                                     Text="{Binding SettleReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Spacing="6" Visibility="{Binding SettlementNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                                <TextBlock Text="اعتماد فارق التسليم يحتاج صلاحية إضافية - أدخل رمز المدير المخوّل."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                <PasswordBox IsEnabled="{Binding CanEditAction}" PlaceholderText="رمز المدير" MinHeight="44" FontSize="16"
                                             Password="{Binding SettleManagerPin, Mode=TwoWay}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SettleError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Visibility="{Binding SettleError, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <TextBlock Text="{Binding SettleNote}" Foreground="{ThemeResource SuccessTextBrush}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Visibility="{Binding SettleNote, Converter={StaticResource NullToCollapsedConverter}}"/>

                            <!-- Audit 2026-11-25 U27: the settled cash is posted into the open shift's drawer; the dialog never said so, and the
                                 cashier's blind count came up short by exactly the driver's money. -->
                            <TextBlock Text="الفلوس اللي الطيار بيسلّمها بتتسجل في درج الكاشير (الوردية المفتوحة دلوقتي) - حطها في الدرج."
                                       TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource WarningTextBrush}" AutomationProperties.AutomationId="Settle_DrawerNote"/>
                            <Button Content="تسوية العهدة" MinHeight="52" HorizontalAlignment="Stretch"
                                    Style="{StaticResource CtaButtonStyle}" Command="{Binding SettleDriverCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
