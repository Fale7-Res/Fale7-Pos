<UserControl x:Class="Falah.Client.CallCenterWinUI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- Mirrors the reference app's LockScreenModal: dark background, red lock accent, PIN display,
         a 3x3 + clear/0/backspace touch keypad, no username field anywhere - the server determines
         who this PIN belongs to. -->
    <Grid Background="#F3F5F2">
        <Border Background="White" CornerRadius="24" Padding="40" Width="440"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="4">
                <Border Background="#EDF3EE" CornerRadius="16" Width="64" Height="64"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🔒" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="فلاح • مركز الاتصال" Style="{StaticResource TitleText}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="شاشة النظام مقفلة لحماية العمليات المالية" Style="{StaticResource MutedText}"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,20" TextAlignment="Center"/>

                <!-- A real, visible PIN field. Previously this was a bare TextBlock whose bound value is
                     an empty string until the first digit lands, so the screen showed nothing at all
                     where the input is - the cashier had no confirmation their taps registered. -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Height="56" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="{Binding PinDisplay}" FontSize="26" FontWeight="Black" Foreground="{StaticResource BrandPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="أدخل الرمز السري" Style="{StaticResource MutedText}" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding PinDisplay, Converter={StaticResource EmptyStringToVisibleConverter}}"/>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

                <!-- LeftToRight is deliberate and load-bearing: a numeric keypad is universally 1-2-3
                     left-to-right, on every phone, ATM and POS terminal on earth. Inheriting the
                     screen's RTL flow mirrored it to 3-2-1, which fights a cashier's muscle memory
                     on the one control they touch most often. Digits are not RTL content. -->
                <Grid ColumnSpacing="8" RowSpacing="8" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="1"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="2"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="3"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="4"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="5"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="6"/>
                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="7"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="8"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="9"/>
                    <Button Grid.Row="3" Grid.Column="0" Content="مسح" FontSize="13" Style="{StaticResource KeypadButtonStyle}" Command="{Binding ClearCommand}"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="0"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource KeypadButtonStyle}" Command="{Binding BackspaceCommand}"/>
                </Grid>

                <!-- Signing in is the primary, expected action, not a destructive one - DangerButtonStyle
                     painted it red, which both read as an error state and broke the brand palette. -->
                <Button Content="{Binding SubmitLabel}"
                        Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitCommand}"
                        Margin="0,16,0,0" MinHeight="52" FontSize="16" HorizontalAlignment="Stretch"/>

                <TextBlock Text="أدخل رمزك الشخصي؛ سيحدد النظام المستخدم وصلاحياته تلقائيًا."
                           Style="{StaticResource MutedText}" Foreground="#64748B" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
