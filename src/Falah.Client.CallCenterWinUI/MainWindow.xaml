<Window x:Class="Falah.Client.CallCenterWinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Falah.Client.CallCenterWinUI.Views"
        Title="فلاح - مركز الاتصال">

    <Grid x:Name="RootGrid" FlowDirection="RightToLeft" Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:AppHeaderView x:Name="HeaderHost" Grid.Row="0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="1">
        <Border x:Name="OfflineBanner" Background="{StaticResource DangerBrush}" Padding="8" Visibility="Collapsed">
            <TextBlock Text="⚠ غير متصل بالسيرفر - تحقق من تشغيل Falah.Server" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}"/>
        </Border>
        <InfoBar x:Name="CloseNotice" IsOpen="{Binding IsCloseBlocked, Mode=TwoWay}" Severity="Warning" IsClosable="True"
                 Title="العملية لم تُحسم بعد" Message="أكمل التحقق من العملية الحالية قبل إغلاق البرنامج."/>
        </StackPanel>

        <ContentControl x:Name="RootContent" Grid.Row="2"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
