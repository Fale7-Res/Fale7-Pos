<UserControl x:Class="Falah.Client.Cashier.Views.AppHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Falah.Client.Cashier.ViewModels"
             d:DataContext="{d:DesignInstance vm:HeaderViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" FlowDirection="RightToLeft" Height="64">
    <!-- Matches the reference AppShell header exactly: 64px, dark graphite, logo+name on the
         inner-right (RTL), shift pill, clock, lock, user badge on the inner-left. -->
    <Border Background="{StaticResource GraphiteBrush}" BorderBrush="{StaticResource GraphiteBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource BrandPrimaryBrush}">
                    <TextBlock Text="{Binding LogoLetter}" FontSize="20" FontWeight="Black" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RestaurantName}" FontSize="15" FontWeight="Black" Foreground="White" FontFamily="{StaticResource AppFontFamily}"/>
                    <TextBlock Text="نظام إدارة المطعم" FontSize="10" Foreground="{StaticResource TextOnDarkMutedBrush}" FontFamily="{StaticResource AppFontFamily}"/>
                </StackPanel>
                <Border Width="1" Height="28" Background="{StaticResource GraphiteBorderBrush}" Margin="20,0"/>
                <Border Background="{StaticResource GraphiteButtonBrush}" CornerRadius="8" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShiftOpen}" Value="True">
                                            <Setter Property="Fill" Value="#34D399"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="الشيفت:" FontSize="11" Foreground="{StaticResource TextOnDarkMutedBrush}" FontFamily="{StaticResource AppFontFamily}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding ShiftLabel}" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource AppFontFamily}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" FlowDirection="LeftToRight">
                    <TextBlock Text="{Binding TimeText}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" FontFamily="{StaticResource AppFontFamily}"/>
                    <TextBlock Text="{Binding DateText}" FontSize="10" Foreground="{StaticResource TextOnDarkMutedBrush}" HorizontalAlignment="Right" FontFamily="{StaticResource AppFontFamily}"/>
                </StackPanel>
                <Button Content="🔒 قفل" Margin="0,0,10,0" Padding="10,8" Background="{StaticResource GraphiteButtonBrush}" Foreground="#FCD34D"
                        FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DataContext.LockCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Border Background="{StaticResource GraphiteButtonBrush}" CornerRadius="8" Padding="6">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrandPrimaryBrush}">
                            <TextBlock Text="{Binding UserName[0]}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource AppFontFamily}"/>
                            <TextBlock Text="{Binding RoleLabel}" FontSize="9" Foreground="{StaticResource TextOnDarkMutedBrush}" FontFamily="{StaticResource AppFontFamily}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
