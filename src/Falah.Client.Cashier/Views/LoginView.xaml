<UserControl x:Class="Falah.Client.Cashier.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Falah.Client.Cashier.ViewModels"
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" FlowDirection="RightToLeft">
    <!-- Mirrors the reference app's full-screen PIN lock screen: dark background, PIN dots, a
         3x3 + clear/0/backspace keypad, no username field anywhere. -->
    <Grid Background="#0F172A">
        <Border Background="#1E293B" CornerRadius="24" Padding="40" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Background="#7C2D2D22" CornerRadius="16" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🔒" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="نظام فلاح لإدارة المطعم" Style="{StaticResource TitleText}" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="أدخل رمزك الشخصي (PIN)" Style="{StaticResource MutedText}" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <TextBlock Text="{Binding PinDisplay}" FontSize="28" FontWeight="Black" Foreground="#DC2626"
                           HorizontalAlignment="Center" Margin="0,0,0,8" MinHeight="34"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" FontWeight="Bold" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

                <UniformGrid Columns="3" Rows="4">
                    <Button Content="1" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="1" Margin="4"/>
                    <Button Content="2" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="2" Margin="4"/>
                    <Button Content="3" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="3" Margin="4"/>
                    <Button Content="4" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="4" Margin="4"/>
                    <Button Content="5" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="5" Margin="4"/>
                    <Button Content="6" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="6" Margin="4"/>
                    <Button Content="7" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="7" Margin="4"/>
                    <Button Content="8" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="8" Margin="4"/>
                    <Button Content="9" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="9" Margin="4"/>
                    <Button Content="مسح" FontSize="13" Style="{StaticResource KeypadButtonStyle}" Command="{Binding ClearCommand}" Margin="4"/>
                    <Button Content="0" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressDigitCommand}" CommandParameter="0" Margin="4"/>
                    <Button Content="⌫" Style="{StaticResource KeypadButtonStyle}" Command="{Binding BackspaceCommand}" Margin="4"/>
                </UniformGrid>

                <Button Content="{Binding IsBusy, Converter={StaticResource BoolToLoginLabelConverter}}"
                        Style="{StaticResource SuccessButtonStyle}" Command="{Binding SubmitCommand}"
                        Margin="0,16,0,0" MinHeight="52" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
