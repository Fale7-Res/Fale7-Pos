<Window x:Class="Falah.Client.Cashier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Falah.Client.Cashier"
        xmlns:vm="clr-namespace:Falah.Client.Cashier.ViewModels"
        xmlns:views="clr-namespace:Falah.Client.Cashier.Views"
        mc:Ignorable="d"
        Title="فلاح - نقطة البيع" Height="820" Width="1366" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashierViewModel}">
            <views:CashierView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- Persistent branded header - present on every screen once logged in, matching the
             reference app's AppShell header exactly (not shown on the PIN screen, matching the
             reference where the lock overlay covers it anyway). -->
        <views:AppHeaderView DockPanel.Dock="Top" DataContext="{Binding Header}"
                              Visibility="{Binding DataContext.IsLoggedIn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibleConverter}}"/>

        <!-- Persistent connectivity banner - only takes space when actually offline, so it never
             steals a pixel from the workspace during normal operation. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource DangerBrush}" Padding="8"
                Visibility="{Binding IsOnline, Converter={StaticResource InverseBoolToVisibleConverter}}">
            <TextBlock Text="⚠ غير متصل بالسيرفر - تحقق من تشغيل Falah.Server" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>
        <ContentControl Content="{Binding CurrentView}"/>
    </DockPanel>
</Window>
