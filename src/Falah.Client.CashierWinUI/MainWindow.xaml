<Window x:Class="Falah.Client.CashierWinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Falah.Client.CashierWinUI.Views"
        Title="فالح أبو العنبه - نقطة البيع">

    <Grid x:Name="RootGrid" FlowDirection="RightToLeft" Background="{ThemeResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent branded header - present on every screen once logged in, matching the
             reference app's AppShell header exactly (not shown on the PIN screen, matching the
             reference where the lock overlay covers it anyway). -->
        <views:AppHeaderView x:Name="HeaderHost" Grid.Row="0" Visibility="Collapsed"/>

        <!-- Persistent connectivity banner - only takes space when actually offline, so it never
             steals a pixel from the workspace during normal operation. -->
        <StackPanel Grid.Row="1">
        <Border x:Name="OfflineBanner" Background="{ThemeResource DangerBrush}" Padding="8" Visibility="Collapsed">
            <TextBlock Text="⚠ غير متصل بالسيرفر - تحقق من تشغيل Falah.Server" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}"/>
        </Border>
        <InfoBar x:Name="CloseNotice" IsOpen="{Binding IsCloseBlocked, Mode=TwoWay}" Severity="Warning" IsClosable="True"
                 Title="العملية لم تُحسم بعد" Message="أكمل التحقق من العملية الحالية قبل إغلاق البرنامج."/>
        <!-- Operations that were still in flight when the station last stopped - a power cut mid
             payment is the case this exists for. Nothing is re-sent from here. -->
        <InfoBar x:Name="RecoveredNotice" Severity="Warning" IsClosable="True"
                 IsOpen="{Binding RecoveredOperationsNotice, Converter={StaticResource NullToBoolConverter}}"
                 CloseButtonCommand="{Binding DismissRecoveredNoticeCommand}"
                 Title="عمليات لم تُحسم من تشغيل سابق" Message="{Binding RecoveredOperationsNotice}"/>
        </StackPanel>

        <ContentControl x:Name="RootContent" Grid.Row="2"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
