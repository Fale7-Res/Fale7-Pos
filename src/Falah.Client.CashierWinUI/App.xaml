<Application x:Class="Falah.Client.CashierWinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Falah.Client.CashierWinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3's own Fluent control resources (default TextBox/GridView/ProgressRing/etc.
                     templates and the theme brushes they reference) - every WinUI 3 app needs this;
                     its absence was a real bug here, surfacing as "Cannot find a Resource with the
                     Name/Key TabViewButtonBackground" the first time a control needing it rendered. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <conv:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <conv:ImageUriToSourceConverter x:Key="ImageUriToSourceConverter"/>
            <conv:NullToTextConverter x:Key="NullToTextConverter"/>
            <conv:EmptyStringToVisibleConverter x:Key="EmptyStringToVisibleConverter"/>
            <conv:DeliveryStatusLabelConverter x:Key="DeliveryStatusLabelConverter"/>
            <conv:PositiveAmountToVisibleConverter x:Key="PositiveAmountToVisibleConverter"/>
            <conv:MilliUnitsToDisplayConverter x:Key="MilliUnitsToDisplayConverter"/>
            <conv:NullablePiastresToDisplayConverter x:Key="NullablePiastresToDisplayConverter"/>
            <conv:TreasuryAccountLabelConverter x:Key="TreasuryAccountLabelConverter"/>
            <conv:TreasuryMovementTypeLabelConverter x:Key="TreasuryMovementTypeLabelConverter"/>
            <conv:ShiftDotBrushConverter x:Key="ShiftDotBrushConverter"/>
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
            <conv:BoolToLabelConverter x:Key="BoolToLabelConverter"/>
            <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
            <conv:DeltaStateToBrushConverter x:Key="DeltaStateToBrushConverter"/>
            <conv:FractionToWidthConverter x:Key="FractionToWidthConverter"/>
            <conv:MoneyOrUnknownConverter x:Key="MoneyOrUnknownConverter"/>
            <conv:PercentOrUnknownConverter x:Key="PercentOrUnknownConverter"/>
            <conv:CountToVisibleConverter x:Key="CountToVisibleConverter"/>
            <conv:LocalTimestampConverter x:Key="LocalTimestampConverter"/>
            <conv:StringEqualsToBrushConverter x:Key="StringEqualsToBrushConverter"/>
            <conv:StringEqualsToVisibleConverter x:Key="StringEqualsToVisibleConverter"/>
            <conv:CountGreaterThanOneToVisibleConverter x:Key="CountGreaterThanOneToVisibleConverter"/>
            <conv:PiastresToDisplayConverter x:Key="PiastresToDisplayConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:EmptyCollectionToVisibleConverter x:Key="EmptyCollectionToVisibleConverter"/>
            <conv:ZeroCountToVisibleConverter x:Key="ZeroCountToVisibleConverter"/>
            <conv:NonEmptyCollectionToVisibleConverter x:Key="NonEmptyCollectionToVisibleConverter"/>
            <conv:CairoBusinessDateConverter x:Key="CairoBusinessDateConverter"/>
            <conv:TimeOfDayConverter x:Key="TimeOfDayConverter"/>
            <conv:StatusToPillBrushConverter x:Key="StatusToPillBrushConverter"/>
            <conv:AttendanceStatusLabelConverter x:Key="AttendanceStatusLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
