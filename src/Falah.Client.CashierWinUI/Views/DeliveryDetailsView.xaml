<UserControl x:Class="Falah.Client.CashierWinUI.Views.DeliveryDetailsView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
 FlowDirection="RightToLeft">
<Grid Background="#66313D35" Visibility="{Binding IsDeliveryEditorOpen, Converter={StaticResource BoolToVisibleConverter}}">
 <Border Background="White" CornerRadius="20" MaxWidth="720" Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <controls:ModalHeaderView Padding="24,18" Title="العميل والتوصيل" CloseCommand="{Binding CloseDeliveryEditorCommand}"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Padding="24,0,24,20" Spacing="14">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Header="رقم الهاتف" Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="بحث عن العميل" VerticalAlignment="Bottom" Command="{Binding LookupCustomerCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
    <TextBlock Text="{Binding CustomerLookupMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
    <TextBox Header="اسم العميل" Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <ComboBox Header="عنوان محفوظ" ItemsSource="{Binding SavedAddresses}" SelectedItem="{Binding SelectedSavedAddress, Mode=TwoWay}" DisplayMemberPath="Street" HorizontalAlignment="Stretch"/>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBox Header="المنطقة" Text="{Binding DeliveryArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Grid.Column="1" Header="خدمة التوصيل" ItemsSource="{Binding DeliveryServices}" SelectedItem="{Binding SelectedDeliveryService, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
    </Grid>
    <TextBox Header="الشارع" Text="{Binding DeliveryStreet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBox Header="المبنى" Text="{Binding DeliveryBuilding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="1" Header="الدور" Text="{Binding DeliveryFloor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="2" Header="الشقة" Text="{Binding DeliveryApartment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
    <TextBox Header="علامة مميزة" Text="{Binding DeliveryLandmark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBox Header="ملاحظات التوصيل" Text="{Binding DeliveryNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{Binding DeliveryError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
    <Button Content="تحديث خدمات التوصيل" Command="{Binding LoadDeliveryServicesCommand}" Style="{StaticResource GhostButtonStyle}"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
    <Button Content="حفظ تفاصيل التوصيل" Command="{Binding SaveDeliveryDetailsCommand}" HorizontalAlignment="Stretch" Style="{StaticResource CtaButtonStyle}"/>
   </Border>
  </Grid>
 </Border>
</Grid></UserControl>