<UserControl x:Class="Falah.Client.CashierWinUI.Views.CustomersView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- Search by phone, because phone IS the customer's identity in this system - there is no
         list-all read, and inventing one for a browsing use case nobody evidenced would mean a new
         endpoint over an unbounded table. See CustomersViewModel's doc comment. -->
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Padding="28,24,28,12" Spacing="4">
            <TextBlock Text="العملاء" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="ابحث عن العميل برقم هاتفه لعرض بياناته وعناوينه المحفوظة"
                       Style="{StaticResource PageSubtitleText}"/>
        </StackPanel>

        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBoxStyle}" MinHeight="44" MaxWidth="420" HorizontalAlignment="Right"
                     InputScope="TelephoneNumber" PlaceholderText="رقم هاتف العميل..."
                     Text="{Binding PhoneQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Content="بحث" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SearchCommand}"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
            <StackPanel Spacing="16">

                <Border Style="{StaticResource PageCardStyle}"
                        Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Customer.Name}" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="{Binding Customer.Phone}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}" Padding="0"
                        Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel>
                        <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المنطقة" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="العنوان" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="خدمة التوصيل" Style="{StaticResource TableHeaderText}"/>
                            </Grid>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Addresses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Area}" Style="{StaticResource TableCellText}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="{Binding Street}"/><Run Text=" "/><Run Text="{Binding Building}"/>
                                                <Run Text=" "/><Run Text="{Binding Landmark}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding ServiceName}" Style="{StaticResource TableCellText}"
                                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="لا توجد عناوين محفوظة لهذا العميل بعد." Style="{StaticResource MutedText}" Margin="16,14"
                                   Visibility="{Binding Addresses, Converter={StaticResource EmptyCollectionToVisibleConverter}}"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,40,0,0"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibleConverter}}">
                    <ProgressRing IsActive="True" Width="36" Height="36"/>
                    <TextBlock Text="جاري البحث..." Style="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,0" MaxWidth="380"
                            Visibility="{Binding SearchError, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding SearchError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Command="{Binding SearchCommand}"/>
                </StackPanel>

                <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,0" MaxWidth="420"
                            Visibility="{Binding NotFound, Converter={StaticResource BoolToVisibleConverter}}">
                    <Border Width="64" Height="64" CornerRadius="22" Background="#F0F4EE" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;" FontSize="26" Foreground="{StaticResource BrandPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="لا يوجد عميل بهذا الرقم" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="يُسجَّل العميل تلقائيًا عند أول طلب توصيل باسمه." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
