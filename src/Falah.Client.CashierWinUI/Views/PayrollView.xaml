<UserControl x:Class="Falah.Client.CashierWinUI.Views.PayrollView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <!-- Runs on the right, the selected run's lines on the left. Only the ONE transition that is
         legal from the run's current status is offered, so an illegal step is never presented. -->
    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="الرواتب والأجور" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="مسيّرات الرواتب الشهرية وحالتها" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox MinHeight="44" MinWidth="120" PlaceholderText="YYYY-MM" IsEnabled="{Binding CanEditAction}"
                         Text="{Binding NewPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="إنشاء مسيّر" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibleConverter}}"
                        Command="{Binding CreateRunCommand}"/>
                <Button MinHeight="44" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Lines of the selected run -->
            <Border Style="{StaticResource PageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="الموظف" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="الأساسي" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="إضافات" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="3" Text="خصومات وسلف" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="4" Text="الصافي" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EmployeeName}" Style="{StaticResource TableCellText}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource CaptionText}"
                                                           Foreground="{Binding IsPaid, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=SuccessBrush|TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TableCellText}"
                                                       Text="{Binding BaseDisplay}"/>
                                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AdditionsDisplay}" Style="{StaticResource TableCellText}"/>
                                                <TextBlock Text="{Binding AdditionsBreakdown}" Style="{StaticResource CaptionText}"
                                                           Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SubtractionsDisplay}" Style="{StaticResource TableCellText}"
                                                           Foreground="{ThemeResource DangerBrush}"/>
                                                <TextBlock Text="{Binding SubtractionsBreakdown}" Style="{StaticResource CaptionText}"
                                                           Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding NetDisplay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ProgressRing Grid.Row="1" IsActive="True" Width="32" Height="32" VerticalAlignment="Center"
                                  Visibility="{Binding IsLoadingLines, Converter={StaticResource BoolToVisibleConverter}}"/>

                    <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{ThemeResource CartFooterBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                                <Run Text="إجمالي صافي المسيّر: "/><Run Text="{Binding SelectedRunTotalDisplay}"/>
                            </TextBlock>
                            <Button Grid.Column="1" MinHeight="44" Content="{Binding NextStatusLabel}"
                                    Style="{StaticResource CtaButtonStyle}"
                                    IsEnabled="{Binding CanAdvance}"
                                    Visibility="{Binding NextStatusLabel, Converter={StaticResource NullToCollapsedConverter}}"
                                    Command="{Binding AdvanceRunCommand}"/>
                            <Button Grid.Column="1" MinHeight="44" Content="صرف الرواتب"
                                    Style="{StaticResource CtaButtonStyle}" IsEnabled="{Binding CanOpenPay}"
                                    Visibility="{Binding IsApprovedAndUnpaid, Converter={StaticResource BoolToVisibleConverter}}"
                                    Command="{Binding OpenPayCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Runs -->
            <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                        <TextBlock Text="المسيّرات" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Runs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="60"
                                            Background="Transparent" BorderThickness="0,0,0,1"
                                            BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="0" Padding="16,10"
                                            Command="{Binding ElementName=Root, Path=DataContext.SelectRunCommand}" CommandParameter="{Binding}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Period}" Style="{StaticResource TableCellText}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusToPillBrushConverter}}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource GeneralStatusLabelConverter}}" Style="{StaticResource StatusPillText}"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding HasNoRuns, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="لا توجد مسيّرات بعد" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="أنشئ مسيّرًا لفترة (YYYY-MM)" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
                Background="{ThemeResource TextPrimaryBrush}" CornerRadius="12" Padding="18,12"
                Visibility="{Binding ActionNote, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ActionNote}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
        </Border>
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
                Background="{ThemeResource DangerBrush}" CornerRadius="12" Padding="18,12"
                Visibility="{Binding ActionError, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ActionError}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
        </Border>

        <Grid Grid.RowSpan="2" Background="{ThemeResource OverlayBrush}"
              Visibility="{Binding IsPayOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" MaxWidth="480" MaxHeight="600"
                    Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <controls:ModalHeaderView Title="صرف الرواتب المعتمدة" CloseCommand="{Binding ClosePayCommand}"/>
                        <TextBlock Text="{Binding SelectedRun.Period}" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="{Binding SelectedRunTotalDisplay}" FontSize="28" FontWeight="Bold"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"/>
                        <TextBlock Text="سيُخصم إجمالي المسيّر من الحساب المختار وتُسجّل تسويات الموظفين."
                                   TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                        <ComboBox Header="حساب الصرف" ItemsSource="{Binding PaymentAccounts}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding PaymentAccount, Mode=TwoWay}" IsEnabled="{Binding CanEditAction}"
                                  MinHeight="48" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding PayError}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding PayError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="تأكيد صرف الرواتب" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding PayRunCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
