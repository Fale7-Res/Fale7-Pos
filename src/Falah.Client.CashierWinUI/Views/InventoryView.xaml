<UserControl x:Class="Falah.Client.CashierWinUI.Views.InventoryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Falah.Client.CashierWinUI.Views"
             FlowDirection="RightToLeft">
    <!-- Stock on hand. Balance is read from the server (derived from the movement log), never
         tracked here. Low stock is the item's own IsLowStock flag against its configured minimum. -->
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="المخزون" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="الأرصدة الحالية محسوبة من سجل الحركات" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    <TextBlock Text="تحديث" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBoxStyle}" MinHeight="44" PlaceholderText="ابحث بالصنف أو التصنيف..."
                     MaxWidth="420" HorizontalAlignment="Right"
                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Column="1" MinHeight="44" VerticalAlignment="Center"
                      IsChecked="{Binding LowStockOnly, Mode=TwoWay}">
                <TextBlock FontSize="13">
                    <Run Text="أقل من الحد الأدنى فقط ("/><Run Text="{Binding LowStockCount}"/><Run Text=")"/>
                </TextBlock>
            </CheckBox>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}" Margin="28,0,28,24" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="الصنف" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="التصنيف" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="الرصيد" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="الحد الأدنى" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="إجراء" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellText}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <Border Background="{StaticResource DangerBackgroundBrush}" CornerRadius="7" Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibleConverter}}">
                                                <TextBlock Text="منخفض" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DangerBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource TableCellText}"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <Run Text="{Binding BalanceMilliUnits, Converter={StaticResource MilliUnitsToDisplayConverter}}"/>
                                            <Run Text=" "/><Run Text="{Binding Unit}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource TableCellText}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding MinimumMilliUnits, Converter={StaticResource MilliUnitsToDisplayConverter}}"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="جرد" MinHeight="44" FontSize="12" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ElementName=Root, Path=DataContext.OpenCountCommand}" CommandParameter="{Binding}"/>
                                            <Button Content="فاقد" MinHeight="44" FontSize="12" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ElementName=Root, Path=DataContext.OpenWasteCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                    <ProgressRing IsActive="True" Width="36" Height="36"/>
                    <TextBlock Text="جاري تحميل المخزون..." Style="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibleConverter}}">
                    <Border Width="64" Height="64" CornerRadius="22" Background="#F0F4EE" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7B8;" FontSize="26" Foreground="{StaticResource BrandPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="لا توجد أصناف مخزون" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="أضف أصناف المخزون لتتبع الأرصدة والفاقد" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
                Background="{StaticResource TextPrimaryBrush}" CornerRadius="12" Padding="18,12"
                Visibility="{Binding ActionNote, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ActionNote}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
        </Border>

        <views:InventoryModalsView Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
</UserControl>
