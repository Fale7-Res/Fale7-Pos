<UserControl x:Class="Falah.Client.CashierWinUI.Views.CategoryStripView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft">
<Grid Padding="18,16,18,0" RowSpacing="12">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center"><TextBlock Text="قائمة الطعام" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
   <TextBlock Text="اختر الصنف لإضافته إلى الطلب" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
  <TextBox x:Name="ProductSearchBox" Grid.Column="1" AutomationProperties.Name="البحث عن صنف" Style="{StaticResource SearchBoxStyle}" MinHeight="48" CornerRadius="12"
   PlaceholderText="ابحث عن صنف…" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
 </Grid>
 <GridView Grid.Row="1" x:Name="CategoriesGridView" ItemsSource="{Binding CategoryTiles}" IsItemClickEnabled="True" SelectionMode="None"
  ItemClick="OnCategoryClicked" Height="66" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
  <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
  <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,0"/></Style></GridView.ItemContainerStyle>
  <GridView.ItemTemplate><DataTemplate>
   <Border MinWidth="116" Height="48" Padding="16,0" CornerRadius="12" BorderThickness="1"
    Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=BrandPrimaryBrush|WhiteBrush}"
    BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=BrandPrimaryBrush|CardBorderBrush}">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <TextBlock Text="{Binding Category.Icon}" FontSize="19"/>
     <!-- Fixed-height chip: wrapping would clip, so a pathologically long category name truncates
          with an ellipsis instead of growing a chip wider than the screen. -->
     <TextBlock Text="{Binding Category.Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
      MaxWidth="220" TextTrimming="CharacterEllipsis"
      Foreground="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=WhiteBrush|TextPrimaryBrush}"/>
    </StackPanel>
   </Border>
  </DataTemplate></GridView.ItemTemplate>
 </GridView>
</Grid></UserControl>