<UserControl x:Class="Falah.Client.CashierWinUI.Views.CartPanelView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft">
<Border x:Name="CartSurface" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Margin="12,14,0,14">
 <Border.Shadow><ThemeShadow/></Border.Shadow>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Padding="14,10" Spacing="8" IsHitTestVisible="{Binding CanEditOperation}">
   <!-- Owner 2026-11-17/18: one basket per customer being served. Tap a basket to work on it; + opens a
        new empty one; × closes an empty basket (an order is dropped with «إلغاء الطلب»). -->
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="6">
     <ItemsControl ItemsSource="{Binding Baskets}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border CornerRadius="10" BorderThickness="2" Padding="2"
        BorderBrush="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=BrandPrimaryBrush|CardBorderBrush}"
        Background="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=InfoBackgroundBrush|CardBackgroundBrush}">
        <StackPanel Orientation="Horizontal" Spacing="2">
         <Button Style="{StaticResource GhostButtonStyle}" MinHeight="40" Padding="10,4"
          AutomationProperties.Name="{Binding Title}"
          Command="{Binding ElementName=Root, Path=DataContext.SwitchBasketCommand}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal" Spacing="6">
           <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="{Binding IsActive, Converter={StaticResource BoolToBoldConverter}}"
            Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=BrandPrimaryBrush|TextPrimaryBrush}" VerticalAlignment="Center"/>
           <Border CornerRadius="9" MinWidth="20" Padding="6,0" Background="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center"
            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibleConverter}}">
            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentTextBrush}" HorizontalAlignment="Center"/>
           </Border>
          </StackPanel>
         </Button>
         <Button Content="×" AutomationProperties.Name="إغلاق السلة" Style="{StaticResource GhostButtonStyle}" MinHeight="40" MinWidth="32" Padding="0" FontSize="18"
          Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibleConverter}}"
          Command="{Binding ElementName=Root, Path=DataContext.CloseBasketCommand}" CommandParameter="{Binding}"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Content="+" AutomationProperties.Name="سلة جديدة" AutomationProperties.AutomationId="AddBasketButton" Style="{StaticResource SecondaryButtonStyle}"
      MinHeight="44" MinWidth="44" Padding="0" FontSize="20" FontWeight="Bold" Command="{Binding AddBasketCommand}"/>
    </StackPanel>
   </ScrollViewer>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="الطلب الحالي" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <Button x:Name="CompactOrderTypeButton" Grid.Column="1" Content="{Binding OrderTypeLabel}" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8">
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem Text="تيك أواي" Command="{Binding SetOrderTypeCommand}" CommandParameter="takeaway"/>
      <MenuFlyoutItem Text="استلام من المطعم" Command="{Binding SetOrderTypeCommand}" CommandParameter="pickup"/>
      <MenuFlyoutItem Text="توصيل" Command="{Binding SetOrderTypeCommand}" CommandParameter="delivery"/>
     </MenuFlyout></Button.Flyout>
    </Button>
    <Border Grid.Column="2" VerticalAlignment="Center" Background="{ThemeResource InfoBackgroundBrush}" CornerRadius="10" Padding="10,4"><TextBlock Foreground="{ThemeResource BrandPrimaryBrush}" FontSize="13"><Run Text="{Binding CartItemCount}"/><Run Text=" صنف"/></TextBlock></Border></Grid>
   <Grid x:Name="OrderTypeSegments" ColumnSpacing="4" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="12" Padding="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="تيك أواي" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetOrderTypeCommand}" CommandParameter="takeaway"
     Background="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=takeaway|CardBackgroundBrush|TransparentBrush}"
     Foreground="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=takeaway|BrandPrimaryBrush|TextMutedBrush}"/><Button Grid.Column="1" Content="استلام من المطعم" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetOrderTypeCommand}" CommandParameter="pickup"
     Background="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=pickup|CardBackgroundBrush|TransparentBrush}"
     Foreground="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=pickup|BrandPrimaryBrush|TextMutedBrush}"/><Button Grid.Column="2" Content="توصيل" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetOrderTypeCommand}" CommandParameter="delivery"
     Background="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=delivery|CardBackgroundBrush|TransparentBrush}"
     Foreground="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=delivery|BrandPrimaryBrush|TextMutedBrush}"/>
   </Grid>
   <!-- Who is collecting it. Shaped like the delivery summary below rather than a bare text box,
        because a pickup needs two fields and the same "tap to fill in, see what you filled in"
        affordance the cashier already knows from delivery. -->
   <Button AutomationProperties.Name="{Binding PickupSummary}" Command="{Binding OpenPickupEditorCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
    Visibility="{Binding IsPickup, Converter={StaticResource BoolToVisibleConverter}}">
    <TextBlock Text="{Binding PickupSummary}" TextWrapping="Wrap" FontSize="13" MaxLines="2"/>
   </Button>
   <Button AutomationProperties.Name="{Binding DeliverySummary}" Command="{Binding OpenDeliveryEditorCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
    Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibleConverter}}">
    <TextBlock Text="{Binding DeliverySummary}" TextWrapping="Wrap" FontSize="13" MaxLines="2"/>
   </Button>
  </StackPanel>
  <Grid Grid.Row="1" IsHitTestVisible="{Binding CanEditOperation}">
   <StackPanel x:Name="EmptyCartHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="12">
    <Border Width="52" Height="52" CornerRadius="18" Background="{ThemeResource InfoBackgroundBrush}" HorizontalAlignment="Center"><FontIcon Glyph="&#xE7BF;" FontSize="22" Foreground="{ThemeResource BrandPrimaryBrush}"/></Border>
    <TextBlock Text="ابدأ طلباً جديداً" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock Text="اختر الأصناف من القائمة؛ سيظهر طلبك هنا" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="{ThemeResource TextMutedBrush}"/>
   </StackPanel>
   <ScrollViewer x:Name="CartScrollViewer" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Cart}" Margin="14,0"><ItemsControl.ItemTemplate><DataTemplate>
     <!-- Owner 2026-11-23: two rows per item, so several items fit on a 1080p till. Row 1: name, line total, remove.
          Row 2: quantity, kitchen notes, unit price. Every touch target stays 44 px. -->
     <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
      <Grid ColumnSpacing="8" RowSpacing="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Spacing="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding ProductName}" Style="{StaticResource CartItemNameText}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding VariantName}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding VariantName, Converter={StaticResource NullToCollapsedConverter}}"/>
        <TextBlock Text="{Binding AppliedOfferName}" FontSize="12" Foreground="{ThemeResource BrandPrimaryBrush}" Visibility="{Binding AppliedOfferName, Converter={StaticResource NullToCollapsedConverter}}"/>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="{Binding LineTotalDisplay}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
       <Button Grid.Column="2" Content="×" AutomationProperties.Name="حذف الصنف" Style="{StaticResource GhostButtonStyle}" MinHeight="44" MinWidth="44" Padding="0" FontSize="22" VerticalAlignment="Center"
        Command="{Binding ElementName=Root, Path=DataContext.RemoveLineCommand}" CommandParameter="{Binding}"/>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Content="+" AutomationProperties.Name="زيادة الكمية" Style="{StaticResource QuantityButtonStyle}" Command="{Binding ElementName=Root, Path=DataContext.IncreaseQuantityCommand}" CommandParameter="{Binding}"/>
        <Button Content="{Binding Quantity}" MinWidth="44" MinHeight="44" Padding="4,0" FontSize="17" FontWeight="SemiBold" Style="{StaticResource GhostButtonStyle}" ToolTipService.ToolTip="اضغط لكتابة العدد" AutomationProperties.Name="كتابة العدد" Command="{Binding ElementName=Root, Path=DataContext.OpenQuantityPadCommand}" CommandParameter="{Binding}"/>
        <Button Content="−" AutomationProperties.Name="تقليل الكمية" Style="{StaticResource QuantityButtonStyle}" Command="{Binding ElementName=Root, Path=DataContext.DecreaseQuantityCommand}" CommandParameter="{Binding}"/>
        <Button Content="ملاحظات" AutomationProperties.Name="ملاحظات التحضير" Style="{StaticResource GhostButtonStyle}" FontSize="12" Padding="8,0" MinHeight="44" Margin="6,0,0,0">
         <Button.Flyout><Flyout><StackPanel Width="260" Spacing="8">
          <TextBox MaxLength="500" Header="ملاحظات للمطبخ" Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
          <Button Content="بدون بصل" Tag="بدون بصل" Click="OnNoteChipClicked" Style="{StaticResource SecondaryButtonStyle}"/>
          <Button Content="حار" Tag="حار" Click="OnNoteChipClicked" Style="{StaticResource SecondaryButtonStyle}"/>
         </StackPanel></Flyout></Button.Flyout>
        </Button>
       </StackPanel>
       <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding UnitPriceDisplay}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}"/>
       <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding Notes, Converter={StaticResource NullToCollapsedConverter}}"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
  </Grid>
  <Border x:Name="OrderFooter" Grid.Row="2" Background="{ThemeResource CartFooterBrush}" CornerRadius="0,0,18,18" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
   <Grid x:Name="FooterGrid" FlowDirection="RightToLeft" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="8"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="FooterSubtotalLabel" Grid.Row="0" Grid.Column="0" Text="الأصناف" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}"/>
    <TextBlock x:Name="FooterSubtotalAmount" Grid.Row="0" Grid.Column="1" Text="{Binding CartSubtotalDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock x:Name="FooterDeliveryLabel" Grid.Row="1" Grid.Column="0" Text="التوصيل" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterDeliveryAmount" Grid.Row="1" Grid.Column="1" Text="{Binding DeliveryFeeDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterDiscountLabel" Grid.Row="2" Grid.Column="0" Text="الخصم" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding IsDiscountEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterDiscountAmount" Grid.Row="2" Grid.Column="1" Text="{Binding DiscountDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding IsDiscountEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterCompLabel" Grid.Row="3" Grid.Column="0" Text="الضيافة" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding IsCompEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterCompAmount" Grid.Row="3" Grid.Column="1" Text="{Binding CompDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding IsCompEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterTaxLabel" Grid.Row="4" Grid.Column="0" Text="{Binding TaxLabel}" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding HasTax, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterTaxAmount" Grid.Row="4" Grid.Column="1" Text="{Binding TaxDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding HasTax, Converter={StaticResource BoolToVisibleConverter}}"/>
    <Border x:Name="FooterSeparator" Grid.Row="6" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource CardBorderBrush}"/>
    <TextBlock x:Name="FooterTotalLabel" Grid.Row="7" Grid.Column="0" Text="الإجمالي التقديري" MinHeight="44" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock x:Name="FooterTotalAmount" Grid.Row="7" Grid.Column="1" Text="{Binding GrandTotalDisplay}" MinHeight="44" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Left" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Spacing="6">
     <TextBlock Text="{Binding CheckoutError}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource DangerBrush}" Visibility="{Binding CheckoutError, Converter={StaticResource NullToCollapsedConverter}}"/>
     <!-- Owner, 2026-11-25: the order reached a gift offer's amount and the offer says the cashier adds the gift. -->
     <InfoBar IsOpen="True" IsClosable="False" Severity="Success" Message="{Binding GiftSuggestion}"
              AutomationProperties.AutomationId="Cart_GiftSuggestion" AutomationProperties.Name="هدية العرض"
              Visibility="{Binding HasGiftSuggestion, Converter={StaticResource BoolToVisibleConverter}}">
      <InfoBar.ActionButton>
       <Button Content="أضف الهدية" Command="{Binding AddGiftCommand}" AutomationProperties.AutomationId="Cart_AddGift"/>
      </InfoBar.ActionButton>
     </InfoBar>
    </StackPanel>
    <!-- Says why the button below is unavailable. Present only while it actually is, so a working
         footer carries no reassurance text and the row collapses to nothing. -->
    <TextBlock x:Name="FooterCheckoutReason" Grid.Row="9" Grid.ColumnSpan="2" Text="{Binding CheckoutBlockedReason}"
               Margin="0,4,0,0" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
               Foreground="{ThemeResource TextMutedBrush}"
               Visibility="{Binding CheckoutBlockedReason, Converter={StaticResource NullToCollapsedConverter}}"/>
    <Button x:Name="FooterCheckoutButton" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,6,0,0" AutomationProperties.AutomationId="OpenCheckoutButton" Content="متابعة إلى الدفع  ←" MinHeight="52" Height="Auto" FontSize="18" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding OpenCheckoutCommand}" IsEnabled="{Binding CanOpenCheckout}"/>
    <Grid x:Name="FooterActions" Grid.Row="11" Grid.ColumnSpan="2" ColumnSpacing="8" Margin="0,6,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Button x:Name="FooterCancelButton" Content="إلغاء الطلب" Style="{StaticResource GhostButtonStyle}" Foreground="{ThemeResource TextMutedBrush}" FontSize="13" MinHeight="44" HorizontalAlignment="Stretch" Command="{Binding RequestClearCartCommand}" IsEnabled="{Binding CanEditOperation}"/>
     <!-- Audit 2026-11-23, F-07: the last paid sale's number and change, beside cancel, until the next payment opens. -->
     <TextBlock Grid.Column="1" Text="{Binding LastSaleNote}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                TextAlignment="Left" TextWrapping="Wrap" Foreground="{ThemeResource BrandPrimaryBrush}"
                AutomationProperties.AutomationId="Cart_LastSaleNote"
                Visibility="{Binding LastSaleNote, Converter={StaticResource NullToCollapsedConverter}}"/>
     <!-- Owner, 2026-11-24: the drawer passed the safe-drop limit - a warning, the sale went through. -->
     <InfoBar Grid.Row="1" Grid.ColumnSpan="2" IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding DrawerCashAlert}"
              AutomationProperties.AutomationId="Cart_DrawerCashAlert" AutomationProperties.Name="تحذير الدرج"
              Visibility="{Binding DrawerCashAlert, Converter={StaticResource NullToCollapsedConverter}}"/>
     <!-- Owner's trial 2026-11-25: no card after a sale; what is left to do on the order just registered (a transfer
          to confirm, a pickup paid at collection, tickets not queued) is said here until the next payment opens. -->
     <InfoBar Grid.Row="2" Grid.ColumnSpan="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding PostSaleNotice}"
              AutomationProperties.AutomationId="Cart_PostSaleNotice" AutomationProperties.Name="تنبيه آخر طلب"
              Visibility="{Binding PostSaleNotice, Converter={StaticResource NullToCollapsedConverter}}"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Border></UserControl>
