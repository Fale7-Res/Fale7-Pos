<UserControl x:Class="Falah.Client.CashierWinUI.Views.CartPanelView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft">
<Border x:Name="CartSurface" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Margin="12,14,0,14">
 <Border.Shadow><ThemeShadow/></Border.Shadow>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Padding="16" Spacing="12" IsHitTestVisible="{Binding CanEditOperation}">
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="الطلب الحالي" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <Button x:Name="CompactOrderTypeButton" Grid.Column="1" Content="{Binding OrderTypeLabel}" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8">
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem Text="تيك أواي" Command="{Binding SetOrderTypeCommand}" CommandParameter="takeaway"/>
      <MenuFlyoutItem Text="استلام من المطعم" Command="{Binding SetOrderTypeCommand}" CommandParameter="pickup"/>
      <MenuFlyoutItem Text="توصيل" Command="{Binding SetOrderTypeCommand}" CommandParameter="delivery"/>
     </MenuFlyout></Button.Flyout>
    </Button>
    <Border Grid.Column="2" VerticalAlignment="Center" Background="{ThemeResource InfoBackgroundBrush}" CornerRadius="10" Padding="10,4"><TextBlock Foreground="{ThemeResource BrandPrimaryBrush}" FontSize="13"><Run Text="{Binding CartItemCount}"/><Run Text=" صنف"/></TextBlock></Border></Grid>
   <Grid x:Name="OrderTypeSegments" ColumnSpacing="4" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="12" Padding="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="تيك أواي" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetOrderTypeCommand}" CommandParameter="takeaway"
     Background="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=takeaway|WhiteBrush|TransparentBrush}"
     Foreground="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=takeaway|BrandPrimaryBrush|TextMutedBrush}"/><Button Grid.Column="1" Content="استلام من المطعم" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetOrderTypeCommand}" CommandParameter="pickup"
     Background="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=pickup|WhiteBrush|TransparentBrush}"
     Foreground="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=pickup|BrandPrimaryBrush|TextMutedBrush}"/><Button Grid.Column="2" Content="توصيل" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetOrderTypeCommand}" CommandParameter="delivery"
     Background="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=delivery|WhiteBrush|TransparentBrush}"
     Foreground="{Binding OrderType, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=delivery|BrandPrimaryBrush|TextMutedBrush}"/>
   </Grid>
   <!-- Who is collecting it. Shaped like the delivery summary below rather than a bare text box,
        because a pickup needs two fields and the same "tap to fill in, see what you filled in"
        affordance the cashier already knows from delivery. -->
   <Button Command="{Binding OpenPickupEditorCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
    Visibility="{Binding IsPickup, Converter={StaticResource BoolToVisibleConverter}}">
    <TextBlock Text="{Binding PickupSummary}" TextWrapping="Wrap" FontSize="13" MaxLines="2"/>
   </Button>
   <Button Command="{Binding OpenDeliveryEditorCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
    Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibleConverter}}">
    <TextBlock Text="{Binding DeliverySummary}" TextWrapping="Wrap" FontSize="13" MaxLines="2"/>
   </Button>
  </StackPanel>
  <Grid Grid.Row="1" IsHitTestVisible="{Binding CanEditOperation}">
   <StackPanel x:Name="EmptyCartHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="24">
    <Border Width="68" Height="68" CornerRadius="24" Background="{ThemeResource InfoBackgroundBrush}" HorizontalAlignment="Center"><FontIcon Glyph="&#xE7BF;" FontSize="28" Foreground="{ThemeResource BrandPrimaryBrush}"/></Border>
    <TextBlock Text="ابدأ طلباً جديداً" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock Text="اختر الأصناف من القائمة؛ سيظهر طلبك هنا" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="{ThemeResource TextMutedBrush}"/>
   </StackPanel>
   <ScrollViewer x:Name="CartScrollViewer" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Cart}" Padding="16,0"><ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
      <StackPanel Spacing="8">
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
         <TextBlock Text="{Binding ProductName}" Style="{StaticResource CartItemNameText}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding VariantName}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding VariantName, Converter={StaticResource NullToCollapsedConverter}}"/>
         <TextBlock Text="{Binding AppliedOfferName}" FontSize="12" Foreground="{ThemeResource BrandPrimaryBrush}" Visibility="{Binding AppliedOfferName, Converter={StaticResource NullToCollapsedConverter}}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="×" AutomationProperties.Name="حذف الصنف" Style="{StaticResource GhostButtonStyle}" MinHeight="44" Padding="0" FontSize="22" VerticalAlignment="Top"
         Command="{Binding ElementName=Root, Path=DataContext.RemoveLineCommand}" CommandParameter="{Binding}"/>
       </Grid>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="4">
         <Button Content="+" AutomationProperties.Name="زيادة الكمية" Style="{StaticResource QuantityButtonStyle}" Command="{Binding ElementName=Root, Path=DataContext.IncreaseQuantityCommand}" CommandParameter="{Binding}"/>
         <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
         <Button Content="−" AutomationProperties.Name="تقليل الكمية" Style="{StaticResource QuantityButtonStyle}" Command="{Binding ElementName=Root, Path=DataContext.DecreaseQuantityCommand}" CommandParameter="{Binding}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
         <TextBlock Text="{Binding LineTotalDisplay}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
         <TextBlock Text="{Binding UnitPriceDisplay}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
        </StackPanel>
       </Grid>
       <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding Notes, Converter={StaticResource NullToCollapsedConverter}}"/>
       <Button Content="ملاحظات التحضير" Style="{StaticResource GhostButtonStyle}" FontSize="12" Padding="0" MinHeight="44" HorizontalAlignment="Right">
        <Button.Flyout><Flyout><StackPanel Width="260" Spacing="8">
         <TextBox Header="ملاحظات للمطبخ" Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
         <Button Content="بدون بصل" Tag="بدون بصل" Click="OnNoteChipClicked" Style="{StaticResource SecondaryButtonStyle}"/>
         <Button Content="حار" Tag="حار" Click="OnNoteChipClicked" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
  </Grid>
  <Border x:Name="OrderFooter" Grid.Row="2" Background="{ThemeResource CartFooterBrush}" CornerRadius="0,0,18,18" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
   <Grid x:Name="FooterGrid" FlowDirection="RightToLeft" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="8"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="FooterSubtotalLabel" Grid.Row="0" Grid.Column="0" Text="الأصناف" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}"/>
    <TextBlock x:Name="FooterSubtotalAmount" Grid.Row="0" Grid.Column="1" Text="{Binding CartSubtotalDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock x:Name="FooterDeliveryLabel" Grid.Row="1" Grid.Column="0" Text="التوصيل" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterDeliveryAmount" Grid.Row="1" Grid.Column="1" Text="{Binding DeliveryFeeDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterDiscountLabel" Grid.Row="2" Grid.Column="0" Text="الخصم" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding IsDiscountEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterDiscountAmount" Grid.Row="2" Grid.Column="1" Text="{Binding DiscountDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding IsDiscountEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterCompLabel" Grid.Row="3" Grid.Column="0" Text="الضيافة" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding IsCompEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterCompAmount" Grid.Row="3" Grid.Column="1" Text="{Binding CompDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding IsCompEnabled, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterTaxLabel" Grid.Row="4" Grid.Column="0" Text="{Binding TaxLabel}" MinHeight="26" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" Visibility="{Binding HasTax, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock x:Name="FooterTaxAmount" Grid.Row="4" Grid.Column="1" Text="{Binding TaxDisplay}" MinHeight="26" FontSize="14" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{Binding HasTax, Converter={StaticResource BoolToVisibleConverter}}"/>
    <Border x:Name="FooterSeparator" Grid.Row="6" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource CardBorderBrush}"/>
    <TextBlock x:Name="FooterTotalLabel" Grid.Row="7" Grid.Column="0" Text="الإجمالي التقديري" MinHeight="52" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock x:Name="FooterTotalAmount" Grid.Row="7" Grid.Column="1" Text="{Binding GrandTotalDisplay}" MinHeight="52" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding CheckoutError}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource DangerBrush}" Visibility="{Binding CheckoutError, Converter={StaticResource NullToCollapsedConverter}}"/>
    <!-- Says why the button below is unavailable. Present only while it actually is, so a working
         footer carries no reassurance text and the row collapses to nothing. -->
    <TextBlock x:Name="FooterCheckoutReason" Grid.Row="9" Grid.ColumnSpan="2" Text="{Binding CheckoutBlockedReason}"
               Margin="0,10,0,0" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
               Foreground="{ThemeResource TextMutedBrush}"
               Visibility="{Binding CheckoutBlockedReason, Converter={StaticResource NullToCollapsedConverter}}"/>
    <Button x:Name="FooterCheckoutButton" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,12,0,0" AutomationProperties.AutomationId="OpenCheckoutButton" Content="متابعة إلى الدفع  ←" MinHeight="56" Height="Auto" FontSize="18" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding OpenCheckoutCommand}" IsEnabled="{Binding CanOpenCheckout}"/>
    <Button x:Name="FooterCancelButton" Grid.Row="11" Grid.ColumnSpan="2" Content="إلغاء الطلب" Style="{StaticResource GhostButtonStyle}" Foreground="{ThemeResource TextMutedBrush}" FontSize="13" HorizontalAlignment="Stretch" Command="{Binding RequestClearCartCommand}" IsEnabled="{Binding CanEditOperation}"/>
   </Grid>
  </Border>
 </Grid>
</Border></UserControl>
