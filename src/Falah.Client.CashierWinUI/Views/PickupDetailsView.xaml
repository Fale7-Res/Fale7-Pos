<UserControl x:Class="Falah.Client.CashierWinUI.Views.PickupDetailsView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
 FlowDirection="RightToLeft">
<!-- The delivery form's two customer fields and nothing else. A pickup is collected at the counter,
     so there is no address, no area, no delivery service and no table to ask for. -->
<Grid Background="{ThemeResource OverlayBrush}" Visibility="{Binding IsPickupEditorOpen, Converter={StaticResource BoolToVisibleConverter}}">
 <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" MaxWidth="520" Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Center">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <controls:ModalHeaderView Padding="24,18" Title="بيانات الاستلام" CloseCommand="{Binding ClosePickupEditorCommand}" CloseAutomationId="Pickup_Close"/>
   <StackPanel Grid.Row="1" Padding="24,0,24,20" Spacing="14">
    <TextBlock Text="اسم العميل ورقم هاتفه، عشان نعرف الطلب ده بتاع مين وقت الاستلام."
               TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextMutedBrush}"/>
    <TextBox x:Name="PickupPhoneBox" MaxLength="30" AutomationProperties.AutomationId="Pickup_Phone" IsEnabled="{Binding CanEditOperation}" Header="رقم الهاتف" InputScope="TelephoneNumber"
             Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox MaxLength="200" AutomationProperties.AutomationId="Pickup_Name" IsEnabled="{Binding CanEditOperation}" Header="اسم العميل"
             Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="موعد الاستلام (اختياري) - سيبه فاضي لو العميل جاي دلوقتي." TextWrapping="Wrap"
               FontSize="13" Foreground="{ThemeResource TextMutedBrush}"/>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <CalendarDatePicker x:Name="PickupDatePicker" AutomationProperties.AutomationId="Pickup_Date" Header="التاريخ" PlaceholderText="اختر التاريخ" HorizontalAlignment="Stretch"
                         IsEnabled="{Binding CanEditOperation}" DateChanged="OnPickupDateChanged"/>
     <!-- Audit 2026-11-25 U16: the framework time picker showed "hour"/"minute" in English whatever its Language, so the
          time is two lists with Arabic placeholders. FlowDirection left-to-right keeps "ساعة : دقيقة" in reading order. -->
     <StackPanel Grid.Column="1" Spacing="4">
      <TextBlock Text="الوقت"/>
      <Grid ColumnSpacing="6" FlowDirection="LeftToRight">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="PickupHourBox" PlaceholderText="الساعة" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditOperation}"
                 AutomationProperties.AutomationId="Pickup_Hour" AutomationProperties.Name="ساعة الاستلام" SelectionChanged="OnPickupTimePartChanged"/>
       <ComboBox x:Name="PickupMinuteBox" Grid.Column="1" PlaceholderText="الدقيقة" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditOperation}"
                 AutomationProperties.AutomationId="Pickup_Minute" AutomationProperties.Name="دقيقة الاستلام" SelectionChanged="OnPickupTimePartChanged"/>
      </Grid>
     </StackPanel>
    </Grid>
    <!-- UI-0025 (owner decision 2026-11-22): register now, the customer pays when collecting. -->
    <ToggleSwitch AutomationProperties.AutomationId="Pickup_PayOnCollection" AutomationProperties.Name="العميل يدفع وهو بيستلم"
                  IsEnabled="{Binding CanEditOperation}" Header="الدفع" IsOn="{Binding PayOnCollection, Mode=TwoWay}"
                  OnContent="العميل يدفع وهو بيستلم" OffContent="يدفع دلوقتي"/>
    <TextBlock Text="الطلب هيروح المطبخ دلوقتي، ومش هيتحسب مبيعات غير لما العميل يدفع. لو ما جاش، اليوم مش هيتقفل غير لما المدير يلغيه."
               TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextMutedBrush}"
               Visibility="{Binding PayOnCollection, Converter={StaticResource BoolToVisibleConverter}}"/>
    <TextBlock Text="{Binding PickupError}" Foreground="{ThemeResource DangerBrush}" FontWeight="Bold" TextWrapping="Wrap"
               Visibility="{Binding PickupError, Converter={StaticResource NullToCollapsedConverter}}"/>
   </StackPanel>
   <Border Grid.Row="2" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
    <Button AutomationProperties.AutomationId="Pickup_Save" Content="حفظ بيانات الاستلام" Command="{Binding SavePickupDetailsCommand}"
            HorizontalAlignment="Stretch" Style="{StaticResource CtaButtonStyle}"/>
   </Border>
  </Grid>
 </Border>
</Grid></UserControl>
