<UserControl x:Class="Falah.Client.CashierWinUI.Views.OrdersView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="الطلبات" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="سجل الطلبات وتفاصيلها" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadCommand}">
                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,12">
            <TextBox Style="{StaticResource SearchBoxStyle}" MinHeight="44" MaxWidth="460" HorizontalAlignment="Right"
                     PlaceholderText="ابحث برقم الطلب أو اسم/هاتف العميل..."
                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}" Margin="28,0,28,24" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="رقم الطلب" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="النوع" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="العميل" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="الإجمالي" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="الحالة" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="تفاصيل" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Orders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OrderNumber}" Style="{StaticResource TableCellText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OrderType, Converter={StaticResource OrderTypeLabelConverter}}" Style="{StaticResource TableCellText}"
                                                   Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CustomerName}" Style="{StaticResource TableCellText}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding TotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                        <Border Grid.Column="4" CornerRadius="8" Padding="8,3" VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Background="{Binding Status, Converter={StaticResource StatusToPillBrushConverter}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource OrderStatusLabelConverter}}" Style="{StaticResource StatusPillText}"/>
                                        </Border>
                                        <Button Grid.Column="5" Content="عرض" MinHeight="44" FontSize="12"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ElementName=Root, Path=DataContext.OpenOrderCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                    <ProgressRing IsActive="True" Width="36" Height="36"/>
                    <TextBlock Text="جاري تحميل الطلبات..." Style="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoOrders, Converter={StaticResource BoolToVisibleConverter}}">
                    <TextBlock Text="لا توجد طلبات مطابقة" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ORDER DETAIL ================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{ThemeResource OverlayBrush}"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" Width="620" MaxHeight="700"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <controls:ModalHeaderView Title="{Binding SelectedOrder.OrderNumber}" CloseCommand="{Binding CloseOrderCommand}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                            <Run Text="{Binding SelectedOrder.OrderType, Converter={StaticResource OrderTypeLabelConverter}}"/><Run Text=" — "/>
                            <Run Text="{Binding SelectedOrder.CustomerName}"/><Run Text=" "/>
                            <Run Text="{Binding SelectedOrder.CustomerPhone}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedOrder.DeliveryAddress, Converter={StaticResource NullToCollapsedConverter}}"
                                   Text="{Binding SelectedOrder.DeliveryAddress}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12">
                        <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding ProductName}" Style="{StaticResource TableCellText}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding VariantName}" Style="{StaticResource CaptionText}"
                                                           Visibility="{Binding VariantName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                           Visibility="{Binding Notes, Converter={StaticResource NullToCollapsedConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" VerticalAlignment="Center"
                                                       Style="{StaticResource TableCellText}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding TotalPricePiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{ThemeResource CartFooterBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,12,12">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="الإجمالي" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" FontWeight="Black" FontSize="18"
                                           Text="{Binding SelectedOrder.TotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="طريقة الدفع: "/><Run Text="{Binding SelectedOrder.PaymentMethod, Converter={StaticResource PaymentMethodLabelConverter}}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
