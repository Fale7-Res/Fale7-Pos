<UserControl x:Class="Falah.Client.CashierWinUI.Views.CashCountView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <!-- Physical denomination count. The running total is a counting aid only; the authoritative
         total, expected figure and difference all come back from the server. -->
    <Grid Background="{ThemeResource OverlayBrush}"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibleConverter}}">
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" MaxWidth="1020" MaxHeight="880"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ModalHeaderView Title="عدّ النقدية الفعلي" CloseCommand="{Binding CloseCommand}"/>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الفئة" Style="{StaticResource TableHeaderText}"/>
                                    <TextBlock Grid.Column="1" Text="العدد" Style="{StaticResource TableHeaderText}"/>
                                    <TextBlock Grid.Column="2" Text="الإجمالي" Style="{StaticResource TableHeaderText}"/>
                                </Grid>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                                    Padding="16,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource TableCellText}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" MinHeight="48" InputScope="Number"
                                                             PlaceholderText="0"
                                                             IsEnabled="{Binding ElementName=Root, Path=DataContext.CanAct}"
                                                             Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding LineTotalDisplay}"
                                                               Style="{StaticResource TableCellText}"
                                                               Foreground="{ThemeResource TextMutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                                <ProgressRing IsActive="True" Width="36" Height="36"/>
                                <TextBlock Text="جاري تحميل فئات النقد..." Style="{StaticResource MutedText}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="360" Padding="16"
                                        Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                                <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <Button Content="إعادة المحاولة" MinHeight="44" HorizontalAlignment="Center"
                                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border Style="{StaticResource PageCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="الإجمالي المعدود" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding CountedTotalDisplay}" Style="{StaticResource MetricValueText}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="هذا مجموع ما أدخلته للمساعدة أثناء العدّ؛ الرقم المعتمد والفرق يحسبهما الخادم."
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                    <TextBox Header="المبلغ المتوقع" MinHeight="48" InputScope="Number"
                                             IsEnabled="{Binding CanAct}"
                                             Text="{Binding ExpectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PageCardStyle}"
                                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibleConverter}}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="عمليات العدّ لهذا اليوم" Style="{StaticResource SectionTitleText}"/>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="2" Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource TableCellText}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap">
                                                        <Run Text="المعدود "/>
                                                        <Run Text="{Binding TotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                                                        <Run Text="المتوقع "/>
                                                        <Run Text="{Binding ExpectedPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                                        <Run Text=" • الفرق "/>
                                                        <Run Text="{Binding DifferencePiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="10">
                    <Border Background="{ThemeResource DangerBackgroundBrush}" CornerRadius="12" Padding="14,10"
                            Visibility="{Binding ActionError, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding ActionError}" Foreground="{ThemeResource DangerBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="{ThemeResource SuccessBackgroundBrush}" CornerRadius="12" Padding="14,10"
                            Visibility="{Binding ActionNote, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding ActionNote}" Foreground="{ThemeResource SuccessBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="{Binding SaveLabel}" MinHeight="52" MinWidth="220" HorizontalAlignment="Left"
                            Style="{StaticResource CtaButtonStyle}" IsEnabled="{Binding CanAct}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
