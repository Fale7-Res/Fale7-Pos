<UserControl x:Class="Falah.Client.CashierWinUI.Views.ControlCenterView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Falah.Client.CashierWinUI.Views"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <!-- Blockers decide whether closing is even possible, so they lead. The server publishes them;
         this screen never re-derives the same rules. -->
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="مركز التحكم بيوم العمل" Style="{StaticResource PageTitleText}"/>
                <TextBlock Style="{StaticResource PageSubtitleText}">
                    <Run Text="يوم العمل "/><Run Text="{Binding BusinessDay.BusinessDate}"/>
                    <Run Text=" — الحالة "/><Run Text="{Binding BusinessDay.Status}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Days}" DisplayMemberPath="BusinessDate" MinHeight="44" MinWidth="140"
                          SelectedItem="{Binding SelectedHistoryDay, Mode=TwoWay}" IsEnabled="{Binding CanEditAction}"
                          AutomationProperties.Name="اختيار يوم العمل"/>
                <Button Content="فتح يوم" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanOpenDay}" Command="{Binding OpenDayActionCommand}" CommandParameter="open"/>
                <Button Content="عدّ النقدية" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding HasBusinessDay}"
                        Visibility="{Binding CanCountCash, Converter={StaticResource BoolToVisibleConverter}}"
                        Command="{Binding OpenCashCountCommand}"/>
                <Button MinHeight="44" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24"
                      Visibility="{Binding HasBusinessDay, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel Spacing="16">

                <!-- Blockers -->
                <Border Style="{StaticResource PageCardStyle}" Visibility="{Binding IsActiveDay, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="موانع إغلاق اليوم" Style="{StaticResource SectionTitleText}"/>

                        <StackPanel Spacing="8" Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl ItemsSource="{Binding Blockers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource DangerBackgroundBrush}" CornerRadius="10"
                                                Padding="12,10" Margin="0,0,0,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource TableCellText}"
                                                           Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Code}" Style="{StaticResource CaptionText}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6" Visibility="{Binding HasBlockers, Converter={StaticResource InverseBoolToVisibleConverter}}">
                            <TextBlock Text="لا توجد موانع - يوم العمل جاهز للإغلاق."
                                       Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="راجع القائمة ثم أكّد إغلاق يوم العمل. يعيد السيرفر فحص الموانع عند التأكيد."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="إغلاق يوم العمل" MinHeight="48" Style="{StaticResource CtaButtonStyle}"
                                IsEnabled="{Binding CanClose}" Command="{Binding OpenDayActionCommand}" CommandParameter="close"/>
                    </StackPanel>
                </Border>

                <!-- Checklist -->
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="قائمة إجراءات الإغلاق" Style="{StaticResource SectionTitleText}"/>
                        <ItemsControl ItemsSource="{Binding Checklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="44"
                                                Style="{StaticResource GhostButtonStyle}"
                                                IsEnabled="{Binding ElementName=Root, Path=DataContext.CanChangeChecklist}"
                                                Command="{Binding ElementName=Root, Path=DataContext.ToggleChecklistItemCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="{StaticResource SuccessBrush}"
                                                          Visibility="{Binding Completed, Converter={StaticResource BoolToVisibleConverter}}"/>
                                                <FontIcon FontSize="14" Glyph="&#xE739;" Foreground="{StaticResource TextMutedBrush}"
                                                          Visibility="{Binding Completed, Converter={StaticResource InverseBoolToVisibleConverter}}"/>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource TableCellText}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Border Grid.Column="1" Background="{StaticResource WarningBackgroundBrush}" CornerRadius="7"
                                                Padding="7,2" VerticalAlignment="Center"
                                                Visibility="{Binding Required, Converter={StaticResource BoolToVisibleConverter}}">
                                            <TextBlock Text="إلزامي" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Exceptions -->
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="استثناءات تحتاج مراجعة" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="تُحسب من البيانات الحيّة في كل قراءة ولا تُخزَّن - قرار المراجعة وحده هو ما يُحفظ."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Exceptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource TableCellText}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    Background="{Binding Severity, Converter={StaticResource StatusToPillBrushConverter}}">
                                                <TextBlock Text="{Binding Severity}" Style="{StaticResource StatusPillText}"/>
                                            </Border>
                                            <Button Content="مراجعة" MinHeight="44"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    IsEnabled="{Binding ElementName=Root, Path=DataContext.CanReviewExceptions}"
                                                    Command="{Binding ElementName=Root, Path=DataContext.OpenExceptionCommand}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="لا توجد استثناءات." Style="{StaticResource MutedText}"
                                   Visibility="{Binding Exceptions.Count, Converter={StaticResource ZeroCountToVisibleConverter}}"/>
                    </StackPanel>
                </Border>
                <Button Content="إعادة فتح اليوم المحدد" MinHeight="48" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanReopenDay}"
                        Command="{Binding OpenDayActionCommand}" CommandParameter="reopen"/>
                <TextBlock Text="{Binding ActionNote}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ActionError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                <Button Content="التحقق وإعادة المحاولة" MinHeight="48" Style="{StaticResource CtaButtonStyle}"
                        Visibility="{Binding HasPendingOperation, Converter={StaticResource BoolToVisibleConverter}}"
                        Command="{Binding RetryOperationCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
            <ProgressRing IsActive="True" Width="36" Height="36"/>
            <TextBlock Text="جاري تحميل يوم العمل..." Style="{StaticResource MutedText}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                    Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding HasNoBusinessDay, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Width="64" Height="64" CornerRadius="22" Background="#F0F4EE" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE787;" FontSize="26" Foreground="{StaticResource BrandPrimaryBrush}"/>
            </Border>
            <TextBlock Text="لا يوجد يوم عمل مفتوح" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
            <TextBlock Text="افتح يوم العمل لبدء تسجيل الحركات المالية والورديات." Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.RowSpan="2" Background="#66313D35"
              Visibility="{Binding IsDayActionOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="20" Padding="24" MaxWidth="500" MaxHeight="620"
                    Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <controls:ModalHeaderView Title="{Binding DayActionTitle}" CloseCommand="{Binding CloseDayActionCommand}"/>
                        <TextBlock Text="{Binding BusinessDay.BusinessDate}" Style="{StaticResource SectionTitleText}"/>
                        <TextBox Header="التاريخ YYYY-MM-DD (فارغ = تاريخ القاهرة على السيرفر)" MinHeight="48"
                                 Text="{Binding NewBusinessDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditAction}" Visibility="{Binding IsOpeningDay, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <TextBox Header="سبب إعادة الفتح" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding ActionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditAction}" Visibility="{Binding IsReopeningDay, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <TextBlock Text="{Binding ActionError}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
                        <Button Content="تأكيد العملية" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitDayActionCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" Background="#66313D35"
              Visibility="{Binding ExceptionTarget, Converter={StaticResource NullToCollapsedConverter}}">
            <Border Background="White" CornerRadius="20" Padding="24" MaxWidth="500" MaxHeight="620"
                    Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <controls:ModalHeaderView Title="مراجعة الاستثناء" CloseCommand="{Binding CloseExceptionCommand}"/>
                        <TextBlock Text="{Binding ExceptionTarget.Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                        <ComboBox Header="نتيجة المراجعة" ItemsSource="{Binding ExceptionStatuses}" DisplayMemberPath="Label"
                                  SelectedValuePath="Code" SelectedValue="{Binding ExceptionStatus, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditAction}" MinHeight="48" HorizontalAlignment="Stretch"/>
                        <TextBox Header="السبب" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding ActionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditAction}"/>
                        <TextBlock Text="القرار يُحفظ للمراجعة ولا يلغي أي مانع مالي." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActionError}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
                        <Button Content="حفظ القرار" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitExceptionCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>


        <!-- Declared last so the count layers above the page and its day-action dialogs. -->
        <views:CashCountView Grid.RowSpan="2" DataContext="{Binding CashCount}"/>
    </Grid>
</UserControl>
