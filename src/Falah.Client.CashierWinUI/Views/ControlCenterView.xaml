<UserControl x:Class="Falah.Client.CashierWinUI.Views.ControlCenterView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Falah.Client.CashierWinUI.Views"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <!-- Blockers decide whether closing is even possible, so they lead. The server publishes them;
         this screen never re-derives the same rules. -->
    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="مركز التحكم بيوم العمل" Style="{StaticResource PageTitleText}"/>
                <TextBlock Style="{StaticResource PageSubtitleText}">
                    <Run Text="يوم العمل "/><Run Text="{Binding BusinessDay.BusinessDate}"/>
                    <Run Text=" — الحالة "/><Run Text="{Binding BusinessDay.Status, Converter={StaticResource GeneralStatusLabelConverter}}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Days}" DisplayMemberPath="BusinessDate" MinHeight="44" MinWidth="140"
                          SelectedItem="{Binding SelectedHistoryDay, Mode=TwoWay}" IsEnabled="{Binding CanEditAction}"
                          AutomationProperties.Name="اختيار يوم العمل"/>
                <Button Content="فتح يوم" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanOpenDay}" Command="{Binding OpenDayActionCommand}" CommandParameter="open"/>
                <Button Content="عدّ النقدية" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding HasBusinessDay}"
                        Visibility="{Binding CanCountCash, Converter={StaticResource BoolToVisibleConverter}}"
                        Command="{Binding OpenCashCountCommand}"/>
                <Button Content="إيداع آمن" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanOpenSafeDrop}"
                        Command="{Binding OpenSafeDropCommand}"/>
                <Button MinHeight="44" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24"
                      Visibility="{Binding HasBusinessDay, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel Spacing="16">

                <!-- Reconciliation - "where is the money" for the selected business day. Management
                     information only, same boundary Shifts uses for its own sales totals. -->
                <Border Style="{StaticResource PageCardStyle}" Visibility="{Binding CanSeeReconciliation, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="مطابقة يوم العمل" Style="{StaticResource SectionTitleText}"/>
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="إجمالي المبيعات" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding Reconciliation.Sales.GrossSalesPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="المرتجعات" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding Reconciliation.Sales.RefundsPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold" Foreground="{ThemeResource DangerBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="صافي المبيعات" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding Reconciliation.Sales.NetSalesPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="المصروفات" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding Reconciliation.ExpensesTotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold" Foreground="{ThemeResource DangerBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="عهد السائقين" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding Reconciliation.DeliveryExpectedCustodyPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Background="{ThemeResource NeutralBackgroundBrush}" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="فرق مطابقة الورديات" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding ReconciliationDifferencePiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Past close snapshot - closed days only, read-only, never recomputed from live data. -->
                <Border Style="{StaticResource PageCardStyle}" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="تقرير الإغلاق المحفوظ لهذا اليوم" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}">
                                <Run Text="أغلقه: "/><Run Text="{Binding LatestSnapshot.ClosedBy}"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="لقطة ثابتة وقت الإغلاق - لا تُعاد من البيانات الحيّة." Style="{StaticResource CaptionText}"/>
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي البيع" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding SnapshotReconciliation.Sales.GrossSalesPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="صافي البيع" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding SnapshotReconciliation.Sales.NetSalesPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="نقدي" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding SnapshotReconciliation.Sales.CashPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Text="بطاقات" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding SnapshotReconciliation.Sales.CardPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionText}">
                            <Run Text="رقم اللقطة: "/><Run Text="{Binding LatestSnapshot.Id}"/>
                            <Run Text=" — العملية: "/><Run Text="{Binding LatestSnapshot.OperationId}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Blockers -->
                <Border Style="{StaticResource PageCardStyle}" Visibility="{Binding IsActiveDay, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="موانع إغلاق اليوم" Style="{StaticResource SectionTitleText}"/>

                        <StackPanel Spacing="8" Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl ItemsSource="{Binding Blockers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource DangerBackgroundBrush}" CornerRadius="10"
                                                Padding="12,10" Margin="0,0,0,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource TableCellText}"
                                                           Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Code}" Style="{StaticResource CaptionText}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6" Visibility="{Binding HasBlockers, Converter={StaticResource InverseBoolToVisibleConverter}}">
                            <TextBlock Text="لا توجد موانع - يوم العمل جاهز للإغلاق."
                                       Foreground="{ThemeResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="راجع القائمة ثم أكّد إغلاق يوم العمل. يعيد السيرفر فحص الموانع عند التأكيد."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="إغلاق يوم العمل" MinHeight="48" Style="{StaticResource CtaButtonStyle}"
                                IsEnabled="{Binding CanClose}" Command="{Binding OpenDayActionCommand}" CommandParameter="close"/>
                    </StackPanel>
                </Border>

                <!-- Checklist -->
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="قائمة إجراءات الإغلاق" Style="{StaticResource SectionTitleText}"/>
                        <ItemsControl ItemsSource="{Binding Checklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="44"
                                                Style="{StaticResource GhostButtonStyle}"
                                                IsEnabled="{Binding ElementName=Root, Path=DataContext.CanChangeChecklist}"
                                                Command="{Binding ElementName=Root, Path=DataContext.ToggleChecklistItemCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}"
                                                          Visibility="{Binding Completed, Converter={StaticResource BoolToVisibleConverter}}"/>
                                                <FontIcon FontSize="14" Glyph="&#xE739;" Foreground="{ThemeResource TextMutedBrush}"
                                                          Visibility="{Binding Completed, Converter={StaticResource InverseBoolToVisibleConverter}}"/>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource TableCellText}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Border Grid.Column="1" Background="{ThemeResource WarningBackgroundBrush}" CornerRadius="7"
                                                Padding="7,2" VerticalAlignment="Center"
                                                Visibility="{Binding Required, Converter={StaticResource BoolToVisibleConverter}}">
                                            <TextBlock Text="إلزامي" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource WarningBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Exceptions -->
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="استثناءات تحتاج مراجعة" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="تُحسب من البيانات الحيّة في كل قراءة ولا تُخزَّن - قرار المراجعة وحده هو ما يُحفظ."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Exceptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource TableCellText}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    Background="{Binding Severity, Converter={StaticResource StatusToPillBrushConverter}}">
                                                <TextBlock Text="{Binding Severity}" Style="{StaticResource StatusPillText}"/>
                                            </Border>
                                            <Button Content="مراجعة" MinHeight="44"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    IsEnabled="{Binding ElementName=Root, Path=DataContext.CanReviewExceptions}"
                                                    Command="{Binding ElementName=Root, Path=DataContext.OpenExceptionCommand}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="لا توجد استثناءات." Style="{StaticResource MutedText}"
                                   Visibility="{Binding Exceptions.Count, Converter={StaticResource ZeroCountToVisibleConverter}}"/>
                    </StackPanel>
                </Border>
                <Button Content="إعادة فتح اليوم المحدد" MinHeight="48" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanReopenDay}"
                        Command="{Binding OpenDayActionCommand}" CommandParameter="reopen"/>
                <TextBlock Text="{Binding ActionNote}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ActionError}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
                <Button Content="التحقق وإعادة المحاولة" MinHeight="48" Style="{StaticResource CtaButtonStyle}"
                        Visibility="{Binding HasPendingOperation, Converter={StaticResource BoolToVisibleConverter}}"
                        Command="{Binding RetryOperationCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
            <ProgressRing IsActive="True" Width="36" Height="36"/>
            <TextBlock Text="جاري تحميل يوم العمل..." Style="{StaticResource MutedText}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                    Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding HasNoBusinessDay, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Width="64" Height="64" CornerRadius="22" Background="{ThemeResource InfoBackgroundBrush}" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE787;" FontSize="26" Foreground="{ThemeResource BrandPrimaryBrush}"/>
            </Border>
            <TextBlock Text="لا يوجد يوم عمل مفتوح" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
            <TextBlock Text="افتح يوم العمل لبدء تسجيل الحركات المالية والورديات." Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.RowSpan="2" Background="{ThemeResource OverlayBrush}"
              Visibility="{Binding IsDayActionOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" MaxWidth="500" MaxHeight="620"
                    Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <controls:ModalHeaderView Title="{Binding DayActionTitle}" CloseCommand="{Binding CloseDayActionCommand}"/>
                        <TextBlock Text="{Binding BusinessDay.BusinessDate}" Style="{StaticResource SectionTitleText}"/>
                        <TextBox Header="التاريخ YYYY-MM-DD (فارغ = تاريخ القاهرة على السيرفر)" MinHeight="48"
                                 Text="{Binding NewBusinessDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditAction}" Visibility="{Binding IsOpeningDay, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <TextBox Header="سبب إعادة الفتح" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding ActionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditAction}" Visibility="{Binding IsReopeningDay, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <TextBlock Text="{Binding ActionError}" TextWrapping="Wrap" Foreground="{ThemeResource DangerBrush}"/>
                        <Button Content="تأكيد العملية" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitDayActionCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- ================= SAFE DROP ================= -->
        <Grid Grid.RowSpan="2" Background="{ThemeResource OverlayBrush}"
              Visibility="{Binding IsSafeDropOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" MaxWidth="440" MaxHeight="600"
                    Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <controls:ModalHeaderView Title="الإيداع الآمن" CloseCommand="{Binding CloseSafeDropCommand}"/>
                        <TextBlock Text="تحويل داخلي من الدرج إلى الخزينة الرئيسية." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource AlertBannerStyle}"
                                Visibility="{Binding HasOpenShiftForDrop, Converter={StaticResource InverseBoolToVisibleConverter}}">
                            <TextBlock Text="لا توجد وردية مفتوحة على هذا الجهاز - الإيداع الآمن يتطلب وردية مفتوحة." TextWrapping="Wrap"/>
                        </Border>

                        <TextBox IsEnabled="{Binding CanEditAction}" Header="المبلغ بالجنيه" InputScope="Number" MinHeight="44" FontSize="18" TextAlignment="Center"
                                 Text="{Binding SafeDropAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="سبب الإيداع" MinHeight="44" TextWrapping="Wrap"
                                 Text="{Binding SafeDropReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Spacing="6" Visibility="{Binding SafeDropNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="صلاحيتك لا تسمح بالإيداع الآمن - أدخل رمز المدير المخوّل." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <PasswordBox IsEnabled="{Binding CanEditAction}" PlaceholderText="رمز المدير" MinHeight="44" FontSize="16"
                                         Password="{Binding SafeDropManagerPin, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SafeDropError}" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding SafeDropError, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <Button Content="تنفيذ الإيداع" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitSafeDropCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" Background="{ThemeResource OverlayBrush}"
              Visibility="{Binding ExceptionTarget, Converter={StaticResource NullToCollapsedConverter}}">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="20" Padding="24" MaxWidth="500" MaxHeight="620"
                    Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <controls:ModalHeaderView Title="مراجعة الاستثناء" CloseCommand="{Binding CloseExceptionCommand}"/>
                        <TextBlock Text="{Binding ExceptionTarget.Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                        <ComboBox Header="نتيجة المراجعة" ItemsSource="{Binding ExceptionStatuses}" DisplayMemberPath="Label"
                                  SelectedValuePath="Code" SelectedValue="{Binding ExceptionStatus, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditAction}" MinHeight="48" HorizontalAlignment="Stretch"/>
                        <TextBox Header="السبب" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding ActionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditAction}"/>
                        <TextBlock Text="القرار يُحفظ للمراجعة ولا يلغي أي مانع مالي." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActionError}" TextWrapping="Wrap" Foreground="{ThemeResource DangerBrush}"/>
                        <Button Content="حفظ القرار" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitExceptionCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>


        <!-- Declared last so the count layers above the page and its day-action dialogs. -->
        <views:CashCountView Grid.RowSpan="2" DataContext="{Binding CashCount}"/>
    </Grid>
</UserControl>
