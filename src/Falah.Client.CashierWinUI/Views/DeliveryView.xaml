<UserControl x:Class="Falah.Client.CashierWinUI.Views.DeliveryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Falah.Client.CashierWinUI.Views"
             FlowDirection="RightToLeft">
    <!--
        Dispatch board (right, main) + driver roster (left, secondary). Management density, not POS
        density: a dispatcher scans many rows at once on a desktop monitor, so rows are compact and
        text-led rather than large touch cards. Every row's available actions are driven by the
        delivery's real server-side status, so the screen can never offer a transition the state
        machine would reject.
    -->
    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="طابور الطلبات والتوصيل" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="كل طلب توصيل واستلام في مرحلته، والخطوة الجاية عليه" Style="{StaticResource PageSubtitleText}"/>
                <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="Queue_Summary"
                           Visibility="{Binding QueueSummary, Converter={StaticResource NullToCollapsedConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="السائقون وخدمات التوصيل" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding CanOpenDirectory, Converter={StaticResource BoolToVisibleConverter}}"
                        Command="{Binding OpenDirectoryCommand}"/>
                <Button Content="كشف يومية السائق" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="Delivery_DriverStatement"
                        Command="{Binding OpenDriverStatementCommand}"/>
                <Button AutomationProperties.Name="تحديث" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="تحديث" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- ===== THE ORDER QUEUE (workflow redesign, owner 2026-11-24) =====
                 Deliveries and pickups side by side, grouped by the stage the server says each order is in. A
                 card shows who, where, how much, how it is paid, and ONE next step; Cancel only when allowed. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <DataTemplate x:Key="QueueCardTemplate">
                        <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OrderNumber}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StageLabel}" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource BrandPrimaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ElapsedDisplay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextMutedBrush}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding CustomerDisplay}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PhoneDisplay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AddressDisplay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Foreground="{ThemeResource TextMutedBrush}"
                                           Visibility="{Binding HasAddress, Converter={StaticResource BoolToVisibleConverter}}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding AmountDisplay}" Style="{StaticResource BodyText}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding PaymentLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               Foreground="{Binding IsPaymentWarning, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=WarningBrush|TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Visibility="{Binding HasDriver, Converter={StaticResource BoolToVisibleConverter}}">
                                    <Run Text="السائق: "/><Run Text="{Binding DriverName}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Attention}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{Binding IsAttentionCritical, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=DangerBrush|WarningBrush}"
                                           Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibleConverter}}"/>
                                <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Content="{Binding NextActionLabel}" MinHeight="44" HorizontalAlignment="Stretch" Style="{StaticResource CtaButtonStyle}"
                                            AutomationProperties.Name="{Binding NextActionLabel}"
                                            Visibility="{Binding HasNextAction, Converter={StaticResource BoolToVisibleConverter}}"
                                            Command="{Binding ElementName=Root, Path=DataContext.RunNextActionCommand}" CommandParameter="{Binding}"/>
                                    <Button Grid.Column="1" Content="{Binding CancelLabel}" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="إلغاء الطلب"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibleConverter}}"
                                            Command="{Binding ElementName=Root, Path=DataContext.OpenQueueCancelCommand}" CommandParameter="{Binding}"/>
                                </Grid>
                                <!-- The kitchen paper never reached the printer: send it again; the main step above stays available. -->
                                <Button Content="{Binding SecondaryActionLabel}" MinHeight="40" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="{Binding SecondaryActionLabel}"
                                        Visibility="{Binding HasSecondaryAction, Converter={StaticResource BoolToVisibleConverter}}"
                                        Command="{Binding ElementName=Root, Path=DataContext.RunSecondaryActionCommand}" CommandParameter="{Binding}"/>
                                <!-- Owner's trial 2026-11-25: an order out with one driver goes to another. -->
                                <Button Content="نقل لسائق تاني" MinHeight="40" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="Queue_Reassign" AutomationProperties.Name="نقل الطلب لسائق تاني"
                                        Visibility="{Binding CanReassign, Converter={StaticResource BoolToVisibleConverter}}"
                                        Command="{Binding ElementName=Root, Path=DataContext.OpenReassignCommand}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="QueueStageTemplate">
                        <StackPanel Spacing="8" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitleText}"/>
                            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource QueueCardTemplate}"/>
                        </StackPanel>
                    </DataTemplate>
                </Grid.Resources>

                <!-- Deliveries -->
                <Border Style="{StaticResource PageCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                            <TextBlock Text="التوصيل" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                            <ItemsControl ItemsSource="{Binding DeliveryStages}" ItemTemplate="{StaticResource QueueStageTemplate}"
                                          AutomationProperties.AutomationId="Queue_Delivery"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                            <ProgressRing IsActive="True" Width="36" Height="36"/>
                            <TextBlock Text="جاري تحميل الطلبات..." Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                    Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoDeliveries, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="لا توجد طلبات توصيل جارية" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                            <TextBlock Text="ستظهر هنا فور تسجيل أول طلب توصيل" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pickups -->
                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                            <TextBlock Text="الاستلام من المطعم" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                            <ItemsControl ItemsSource="{Binding PickupStages}" ItemTemplate="{StaticResource QueueStageTemplate}"
                                          AutomationProperties.AutomationId="Queue_Pickup"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoPickups, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="لا توجد طلبات استلام مفتوحة" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== DRIVERS ===== -->
            <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                        <TextBlock Text="السائقون" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Drivers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="52"
                                            Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardBorderBrush}"
                                            CornerRadius="0" Padding="16,12"
                                            Command="{Binding ElementName=Root, Path=DataContext.OpenDriverAccountCommand}" CommandParameter="{Binding}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Owner decision 2026-11-25 (audit U24): the driver's phone under the name, when there is one. -->
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellText}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Phone}" Style="{StaticResource CaptionText}"
                                                           Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextMutedBrush}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Audit 2026-11-23, F-11: say so when there is nobody to assign. -->
                    <TextBlock Grid.Row="1" Margin="16" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource MutedText}" AutomationProperties.AutomationId="Delivery_NoDrivers"
                               Text="لا يوجد سائقون نشطون. أضف سائقًا أو فعّله من «السائقون وخدمات التوصيل»."
                               Visibility="{Binding HasNoDrivers, Converter={StaticResource BoolToVisibleConverter}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Action feedback -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                Background="{ThemeResource TextPrimaryBrush}" CornerRadius="12" Padding="18,12"
                Visibility="{Binding ActionNote, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ActionNote}" Foreground="{ThemeResource CardBackgroundBrush}" FontWeight="SemiBold"/>
        </Border>
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                Background="{ThemeResource DangerBrush}" CornerRadius="12" Padding="18,12"
                Visibility="{Binding ActionError, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ActionError}" Foreground="{ThemeResource AccentTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="420"/>
        </Border>

        <views:DeliveryModalsView Grid.Row="0" Grid.RowSpan="2"/>

        <!-- Declared last so the directory layers above the board and its dispatch modals. -->
        <views:DeliveryDirectoryView Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Directory}"/>
        <!-- UI-REQ-001 -->
        <views:DriverStatementView Grid.RowSpan="10" Grid.ColumnSpan="10" DataContext="{Binding DriverStatement}"/>
    </Grid>
</UserControl>
