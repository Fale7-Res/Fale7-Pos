<UserControl x:Class="Falah.Client.CashierWinUI.Views.UsersView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <!-- Users on the right, the selected user's permissions on the left. The permission list is the
         server's own catalog, so it can never drift from what the backend actually enforces. -->
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="المستخدمون والصلاحيات" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="من يستطيع فعل ماذا داخل النظام" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="مستخدم جديد" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenCreateUserCommand}" IsEnabled="{Binding CanCreateUser}"/>
                <Button MinHeight="44" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}"
                        IsEnabled="{Binding CanEditAction}" AutomationProperties.Name="تحديث المستخدمين">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Permissions of the selected user -->
            <Border Style="{StaticResource PageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                        <TextBlock Style="{StaticResource TableHeaderText}" VerticalAlignment="Center">
                            <Run Text="صلاحيات "/><Run Text="{Binding SelectedUser.Name}"/>
                        </TextBlock>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,8">
                            <Border Style="{StaticResource AlertBannerStyle}" Margin="0,0,0,10"
                                    Visibility="{Binding IsOwnerSelected, Converter={StaticResource BoolToVisibleConverter}}">
                                <TextBlock Text="حساب المالك محصّن: لا يمكن تعديل صلاحياته أو إيقافه من هنا."
                                           TextWrapping="Wrap"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Permissions}" IsEnabled="{Binding CanEditSelected}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox MinHeight="44" IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanActorGrant}">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource TableCellText}" TextWrapping="Wrap"/>
                                            </CheckBox>
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="يمكنك منح الصلاحيات التي تملكها وإلغاء الصلاحيات الحالية."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F9FAF7" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ActionError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding ActionError, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <Button Grid.Column="1" Content="حفظ الصلاحيات" MinHeight="44" Style="{StaticResource CtaButtonStyle}"
                                    IsEnabled="{Binding CanEditSelected}" Command="{Binding SavePermissionsCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Users -->
            <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                        <TextBlock Text="المستخدمون" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                        <ProgressRing IsActive="True" Width="32" Height="32"/>
                        <TextBlock Text="جاري تحميل المستخدمين..." Style="{StaticResource MutedText}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding HasNoUsers, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="لا يوجد مستخدمون" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="60"
                                            Background="Transparent" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="0" Padding="16,10"
                                            Command="{Binding ElementName=Root, Path=DataContext.SelectUserCommand}" CommandParameter="{Binding}">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellText}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" Background="{StaticResource NeutralPillBrush}" CornerRadius="7"
                                                        Padding="7,2" VerticalAlignment="Center"
                                                        Visibility="{Binding Active, Converter={StaticResource InverseBoolToVisibleConverter}}">
                                                    <TextBlock Text="موقوف" Style="{StaticResource StatusPillText}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Role}" Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                        <StackPanel Spacing="8">
                            <Button Content="تغيير الرمز السري" MinHeight="44" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanChangeSelectedPin}"
                                    Command="{Binding OpenPinChangeCommand}"/>
                            <Button Content="تفعيل / إيقاف المستخدم" MinHeight="44" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding CanEditSelected}" Command="{Binding ToggleActiveCommand}"/>
                            <Button Content="التحقق وإعادة المحاولة" MinHeight="44" HorizontalAlignment="Stretch"
                                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RetryUserActionCommand}"
                                    Visibility="{Binding HasPendingAction, Converter={StaticResource BoolToVisibleConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
                Background="{StaticResource TextPrimaryBrush}" CornerRadius="12" Padding="18,12"
                Visibility="{Binding ActionNote, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ActionNote}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
        </Border>

        <Grid Grid.RowSpan="2" Background="#66313D35"
              Visibility="{Binding IsCreateUserOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border x:Name="CreateUserCard" Background="White" CornerRadius="20" Padding="24" MaxWidth="680" MaxHeight="800"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:ModalHeaderView Title="مستخدم جديد" CloseCommand="{Binding CloseUserDialogCommand}"/>
                    <ScrollViewer x:Name="CreateUserScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <TextBox Header="اسم المستخدم" MinHeight="44" IsEnabled="{Binding CanEditAction}"
                                     Text="{Binding NewUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Header="الدور الوظيفي" MinHeight="44" IsEnabled="{Binding CanEditAction}"
                                     Text="{Binding NewUserRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="الصلاحيات أدناه تحدد ما يستطيع المستخدم فعله؛ لا يمنح الدور صلاحيات تلقائية."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <PasswordBox Header="الرمز السري الأولي" MinHeight="44" MaxLength="6" IsEnabled="{Binding CanEditAction}"
                                         Password="{Binding NewUserPin, Mode=TwoWay}"/>
                            <PasswordBox Header="تأكيد الرمز السري" MinHeight="44" MaxLength="6" IsEnabled="{Binding CanEditAction}"
                                         Password="{Binding ConfirmUserPin, Mode=TwoWay}"/>
                            <TextBlock Text="من 4 إلى 6 أرقام، دون تكرار الرقم نفسه في الرمز كله." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <TextBlock Text="الصلاحيات" Style="{StaticResource SectionTitleText}"/>
                            <ItemsControl ItemsSource="{Binding NewUserPermissions}" IsEnabled="{Binding CanEditAction}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <CheckBox MinHeight="44" IsChecked="{Binding IsGranted, Mode=TwoWay}" IsEnabled="{Binding CanActorGrant}">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="CreateUserFooter" Grid.Row="2" Spacing="10">
                        <TextBlock Text="{Binding ActionError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding ActionError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <Button Content="{Binding CreateUserLabel}" MinHeight="48" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding CreateUserCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" Background="#66313D35"
              Visibility="{Binding IsPinChangeOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="20" Padding="24" MaxWidth="500" MaxHeight="660"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <controls:ModalHeaderView Title="{Binding PinChangeTitle}" CloseCommand="{Binding CloseUserDialogCommand}"/>
                        <TextBlock Text="{Binding PinTarget.Name}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap"/>
                        <PasswordBox Header="الرمز الحالي" MinHeight="44" IsEnabled="{Binding CanEditAction}"
                                     Password="{Binding CurrentPin, Mode=TwoWay}"
                                     Visibility="{Binding IsSelfPinChange, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <PasswordBox Header="الرمز الجديد" MinHeight="44" MaxLength="6" IsEnabled="{Binding CanEditAction}"
                                     Password="{Binding NewPin, Mode=TwoWay}"/>
                        <PasswordBox Header="تأكيد الرمز الجديد" MinHeight="44" MaxLength="6" IsEnabled="{Binding CanEditAction}"
                                     Password="{Binding ConfirmPin, Mode=TwoWay}"/>
                        <TextBlock Text="من 4 إلى 6 أرقام، دون تكرار الرقم نفسه في الرمز كله." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActionError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding ActionError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <Button Content="{Binding ChangePinLabel}" MinHeight="48" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding ChangePinCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
