<UserControl x:Class="Falah.Client.CashierWinUI.Views.WasteView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- Management read of recorded loss for one business date. Recording new loss lives on the
         Inventory screen, beside the balances it changes. -->
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="الهدر والفاقد" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="قيمة الفاقد المسجّل حسب نوعه ليوم العمل" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button MinHeight="44" MinWidth="44" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="اليوم السابق" Command="{Binding PreviousDayCommand}">
                    <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                </Button>
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,0" MinHeight="44" MinWidth="150">
                    <TextBlock Text="{Binding BusinessDateLabel}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Button MinHeight="44" MinWidth="44" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="اليوم التالي" Command="{Binding NextDayCommand}">
                    <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Total + split by the three distinct loss types -->
        <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Margin="28,0,28,12">
            <Grid ColumnSpacing="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" MinWidth="170">
                    <TextBlock Text="إجمالي قيمة الفاقد" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Style="{StaticResource MetricValueText}"
                               Text="{Binding Summary.TotalLossValuePiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ByType}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="32"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" MinWidth="140">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitleText}" TextWrapping="Wrap"/>
                                <TextBlock FontSize="18" FontWeight="Bold"
                                           Text="{Binding ValuePiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}" Margin="28,0,28,24" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="النوع" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="الكمية" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="القيمة" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="السبب" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Movements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource TableCellText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TableCellText}"
                                                   Text="{Binding QuantityMilliUnits, Converter={StaticResource MilliUnitsToDisplayConverter}}"/>
                                        <!-- Unvalued loss (no purchase history) shows as such, never as 0.00 -->
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding LossValuePiastres, Converter={StaticResource NullablePiastresToDisplayConverter}}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource TableCellText}"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                    <ProgressRing IsActive="True" Width="36" Height="36"/>
                    <TextBlock Text="جاري التحميل..." Style="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoLoss, Converter={StaticResource BoolToVisibleConverter}}">
                    <TextBlock Text="لا يوجد فاقد مسجّل في هذا اليوم" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="يُسجَّل الفاقد من شاشة المخزون" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
