<UserControl x:Class="Falah.Client.CashierWinUI.Views.PrintingView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- Status of the print queue per station. This system records jobs; a station agent prints
         them. That distinction is stated plainly rather than implied. -->
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="الطباعة والأجهزة" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="حالة طوابير الطباعة لكل محطة" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadCommand}">
                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource AlertBannerStyle}" Margin="28,0,28,12">
            <TextBlock TextWrapping="Wrap"
                       Text="النظام يسجّل أوامر الطباعة ويتتبّع محاولاتها. الإرسال الفعلي للطابعة يقوم به برنامج المحطة، وتسجيل الأمر لا يعني أن الإيصال طُبع فعليًا."/>
        </Border>

        <!-- Queue per route -->
        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}" Margin="28,0,28,12">
            <ItemsControl ItemsSource="{Binding Queues}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button MinHeight="44" MinWidth="190" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding ElementName=Root, Path=DataContext.SelectRouteCommand}"
                                CommandParameter="{Binding Route}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Border Grid.Column="1" Background="#EDF3EE" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PendingCount}" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource BrandPrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PageCardStyle}" Margin="28,0,28,24" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="رقم الطلب" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="الحالة" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="المحاولات" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="آخر خطأ" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PendingJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OrderNumber}" Style="{StaticResource TableCellText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Background="{Binding Status, Converter={StaticResource StatusToPillBrushConverter}}">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding AttemptCount}" Style="{StaticResource TableCellText}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LastError}" Style="{StaticResource TableCellText}"
                                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                    <ProgressRing IsActive="True" Width="36" Height="36"/>
                    <TextBlock Text="جاري تحميل حالة الطباعة..." Style="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoPending, Converter={StaticResource BoolToVisibleConverter}}">
                    <TextBlock Text="لا توجد أوامر طباعة معلّقة لهذه المحطة" Style="{StaticResource SectionTitleText}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
