<UserControl x:Class="Falah.Client.CashierWinUI.Views.AppHeaderView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft">
<Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Height="64">
 <Grid Padding="20,0" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
   <Border Width="40" Height="40" CornerRadius="14" Background="{ThemeResource BrandPrimaryBrush}"><TextBlock Text="ف" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="{Binding RestaurantName}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
   <Border Background="{ThemeResource InfoBackgroundBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8">
    <Ellipse Width="7" Height="7" Fill="{Binding IsShiftOpen, Converter={StaticResource ShiftDotBrushConverter}}" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding ShiftLabel}" FontSize="13" Foreground="{ThemeResource BrandPrimaryBrush}"/>
   </StackPanel></Border>
  </StackPanel>
  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding TimeText}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
   <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/></StackPanel>
  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
   <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
    <TextBlock Text="{Binding RoleLabel}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/></StackPanel>
   <Button x:Name="LockButton" IsEnabled="{Binding CanLock}" ToolTipService.ToolTip="أكمل العملية المالية قبل قفل الشاشة" Click="OnLockClicked" Content="قفل" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8"/>
  </StackPanel>
 </Grid>
</Border></UserControl>