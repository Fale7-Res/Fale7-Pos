<UserControl x:Class="Falah.Client.CashierWinUI.Views.PurchasingView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Falah.Client.CashierWinUI.Views"
             FlowDirection="RightToLeft">
    <!-- Suppliers (with outstanding balance) beside their invoices. Outstanding is always the
         server's figure, derived fresh from the supplier ledger - never a cached column. -->
    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="المشتريات والموردون" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="الفواتير والأرصدة المستحقة للموردين" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="إضافة مورد" MinHeight="44" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenAddSupplierCommand}"/>
                <Button MinHeight="44" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Suppliers -->
            <Border Style="{StaticResource PageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                        <TextBlock Text="الموردون" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Suppliers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellText}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                                                    <Run Text="مستحق: "/>
                                                    <Run Text="{Binding OutstandingBalancePiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="استلام فاتورة" MinHeight="44" FontSize="12"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding ElementName=Root, Path=DataContext.OpenReceiveCommand}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                Visibility="{Binding HasNoSuppliers, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="لا يوجد موردون بعد" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="أضف موردًا لتسجيل فواتير المشتريات" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Purchases -->
            <Grid Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Payables aging. Overdue and "no agreed due date" are shown as two separate facts on
                 purpose: an invoice nobody set a term for is not late, and folding it into the
                 overdue figure would invent a deadline the restaurant never agreed. -->
            <Border Style="{StaticResource PageCardStyle}"
                    Visibility="{Binding HasPayables, Converter={StaticResource BoolToVisibleConverter}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="أعمار الفواتير المستحقة" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="{Binding OverdueSummary}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UnscheduledSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Visibility="{Binding UnscheduledSummary, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <ItemsControl ItemsSource="{Binding PayableBuckets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource NeutralBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,8,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
                                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}"
                                                   Text="{Binding TotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextMutedBrush}">
                                            <Run Text="{Binding InvoiceCount}"/><Run Text=" فاتورة"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Worst first, and only the worst. The complete list is the table below. -->
                    <ItemsControl ItemsSource="{Binding WorstOverdue}"
                                  Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVisibleConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TableCellText}" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <Run Text="{Binding SupplierName}" FontWeight="SemiBold"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding InvoiceNumber}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="{Binding RemainingPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                    <Border Grid.Column="2" Background="{ThemeResource DangerBackgroundBrush}" CornerRadius="8" Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource DangerBrush}">
                                            <Run Text="متأخرة "/><Run Text="{Binding DaysOverdue}"/><Run Text=" يوم"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource TableHeaderRowStyle}" Padding="16,10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="الفاتورة" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="الإجمالي" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="المدفوع" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="3" Text="المتبقي" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="4" Text="تاريخ الاستحقاق" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="5" Text="إجراء" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Purchases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding InvoiceNumber}" Style="{StaticResource TableCellText}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding TotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TableCellText}"
                                                       Foreground="{ThemeResource TextMutedBrush}"
                                                       Text="{Binding PaidPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding RemainingAmountPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                            <!-- An invoice with no agreed term says so, and the button
                                                 is how one gets agreed after the goods arrived. -->
                                            <Button Grid.Column="4" MinHeight="44" FontSize="12" Padding="8,4"
                                                    Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right"
                                                    Content="{Binding DueDate, Converter={StaticResource NullToTextConverter}, ConverterParameter=بدون تاريخ}"
                                                    IsEnabled="{Binding ElementName=Root, Path=DataContext.CanManage}"
                                                    Command="{Binding ElementName=Root, Path=DataContext.OpenDueDateCommand}" CommandParameter="{Binding}"/>
                                            <Button Grid.Column="5" Content="سداد" MinHeight="44" FontSize="12"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Visibility="{Binding RemainingAmountPiastres, Converter={StaticResource PositiveAmountToVisibleConverter}}"
                                                    Command="{Binding ElementName=Root, Path=DataContext.OpenPayCommand}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
                        <ProgressRing IsActive="True" Width="36" Height="36"/>
                        <TextBlock Text="جاري التحميل..." Style="{StaticResource MutedText}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding LoadError}" Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="إعادة المحاولة" MinHeight="44" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
                Background="{ThemeResource TextPrimaryBrush}" CornerRadius="12" Padding="18,12"
                Visibility="{Binding ActionNote, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ActionNote}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
        </Border>

        <views:PurchasingModalsView Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</UserControl>
