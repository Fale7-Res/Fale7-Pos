<UserControl x:Class="Falah.Client.CashierWinUI.Views.CashierOperationsModalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <!--
        Full-screen modals for the "Cashier Operations" menu (see the toolbar button in CashierView.xaml's
        own workspace header) - Safe Drop, Cash In/Out, Cash Drawer, Cash Count, Order Lookup/Reprint.
        This UserControl is added as a plain, unpositioned child of CashierView.xaml's root Grid, the
        same way its other modals (checkout, close-shift, add-expense) already are - a Grid child with
        no Grid.Row/Column stretches to fill the parent's full bounds by default, which is exactly the
        overlay behavior every modal here needs. Kept in its own file per the established
        one-file-per-nontrivial-DataTemplate rule (see CashierView.xaml's own file-level comment) -
        the Order Lookup modal's line-item list is this file's one ItemsControl/DataTemplate.
    -->
    <Grid>
        <!-- ================= SAFE DROP MODAL ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsSafeDropOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24" MaxHeight="680"><ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="إيداع بالخزنة (Safe Drop)" CloseCommand="{Binding CancelSafeDropCommand}" CloseAutomationId="SafeDrop_Close"/>
                    <TextBlock Text="نقل مبلغ فائض من الدرج إلى الخزنة أثناء الوردية." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <TextBlock Text="المبلغ بالجنيه" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                    <TextBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="SafeDrop_Amount" Text="{Binding SafeDropAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                             FontSize="20" TextAlignment="Center"/>
                    <TextBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="SafeDrop_Reason" PlaceholderText="سبب الإيداع" Text="{Binding SafeDropReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Spacing="8" Visibility="{Binding SafeDropNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="صلاحيتك الحالية لا تسمح بالإيداع للخزنة - أدخل رمز المدير المخوّل." Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <PasswordBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="SafeDrop_ManagerPin" Password="{Binding SafeDropManagerPin, Mode=TwoWay}"
                                 PlaceholderText="رمز المدير" FontSize="18"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SafeDropError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap" Visibility="{Binding SafeDropError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Button AutomationProperties.AutomationId="SafeDrop_Submit" Content="تأكيد الإيداع" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                            Command="{Binding SubmitSafeDropCommand}"/>
                </StackPanel>
            </ScrollViewer></Border>
        </Grid>

        <!-- ================= CASH IN / OUT MODAL ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsCashMovementOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24" MaxHeight="680"><ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="{Binding CashMovementTitle}" CloseCommand="{Binding CancelCashMovementCommand}" CloseAutomationId="CashMovement_Close"/>
                    <TextBlock Text="المبلغ بالجنيه" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                    <TextBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="CashMovement_Amount" Text="{Binding CashMovementAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                             FontSize="20" TextAlignment="Center"/>
                    <TextBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="CashMovement_Reason" PlaceholderText="سبب الحركة" Text="{Binding CashMovementReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Spacing="8" Visibility="{Binding CashMovementNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="صلاحيتك الحالية لا تسمح بهذه الحركة - أدخل رمز المدير المخوّل." Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <PasswordBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="CashMovement_ManagerPin" Password="{Binding CashMovementManagerPin, Mode=TwoWay}"
                                 PlaceholderText="رمز المدير" FontSize="18"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CashMovementError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap" Visibility="{Binding CashMovementError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Button AutomationProperties.AutomationId="CashMovement_Submit" Content="تأكيد" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                            Command="{Binding SubmitCashMovementCommand}"/>
                </StackPanel>
            </ScrollViewer></Border>
        </Grid>

        <!-- ================= CASH DRAWER MODAL ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsCashDrawerOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24" MaxHeight="680"><ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="فتح الدرج" CloseCommand="{Binding CancelCashDrawerCommand}" CloseAutomationId="CashDrawer_Close"/>
                    <TextBlock Text="يسجل طلب فتح الدرج؛ تأكد من فتح الدرج فعلياً."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <TextBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="CashDrawer_Reason" PlaceholderText="سبب فتح الدرج" Text="{Binding CashDrawerReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Spacing="8" Visibility="{Binding CashDrawerNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="صلاحيتك الحالية لا تسمح بفتح الدرج - أدخل رمز المدير المخوّل." Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <PasswordBox IsEnabled="{Binding CanEditOperation}" AutomationProperties.AutomationId="CashDrawer_ManagerPin" Password="{Binding CashDrawerManagerPin, Mode=TwoWay}"
                                 PlaceholderText="رمز المدير" FontSize="18"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CashDrawerError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap" Visibility="{Binding CashDrawerError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Button AutomationProperties.AutomationId="CashDrawer_Submit" Content="تسجيل طلب فتح الدرج" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                            Command="{Binding SubmitCashDrawerCommand}"/>
                </StackPanel>
            </ScrollViewer></Border>
        </Grid>

        <!-- ================= CASH COUNT MODAL (read-only) ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsCashCountOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="24" Width="380" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24" MaxHeight="680"><ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="رصيد الدرج المسجل" CloseCommand="{Binding CloseCashCountCommand}" CloseAutomationId="CashCount_Close"/>
                    <TextBlock Text="الرصيد النقدي الحالي في الدرج (محسوب من حركات الخزينة الفعلية على السيرفر)."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <ProgressRing IsActive="{Binding IsLoadingCashCount}" Visibility="{Binding IsLoadingCashCount, Converter={StaticResource BoolToVisibleConverter}}"
                                  Width="32" Height="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CashCountBalancePiastres, Converter={StaticResource PiastresToDisplayConverter}}"
                               FontSize="32" FontWeight="Black" HorizontalAlignment="Center"
                               Visibility="{Binding IsLoadingCashCount, Converter={StaticResource InverseBoolToVisibleConverter}}"/>
                    <TextBlock Text="{Binding CashCountError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap" Visibility="{Binding CashCountError, Converter={StaticResource NullToCollapsedConverter}}"/>
                </StackPanel>
            </ScrollViewer></Border>
        </Grid>

        <!-- ================= ORDER LOOKUP + REPRINT MODAL ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsOrderLookupOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="24" Width="460" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24"><ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="البحث عن طلب" CloseCommand="{Binding CloseOrderLookupCommand}" CloseAutomationId="OrderLookup_Close"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox IsEnabled="{Binding CanEditOperation}" Grid.Column="0" AutomationProperties.AutomationId="OrderLookup_Number" PlaceholderText="رقم الطلب" Text="{Binding OrderLookupNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" AutomationProperties.AutomationId="OrderLookup_Search" Content="بحث" Style="{StaticResource PrimaryButtonStyle}" MinHeight="44" Padding="16,8"
                                Command="{Binding SearchOrderCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding OrderLookupError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap" Visibility="{Binding OrderLookupError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Spacing="10" Visibility="{Binding OrderLookupResult, Converter={StaticResource NullToCollapsedConverter}}">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="رقم الطلب:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OrderLookupResult.OrderNumber}" HorizontalAlignment="Left" FontWeight="Bold"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الحالة:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OrderLookupResult.Status}" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الإجمالي:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OrderLookupResult.TotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}"
                                               HorizontalAlignment="Left" FontWeight="Black"/>
                                </Grid>
                                <!--
                                    How it was actually paid. The server has recorded the split
                                    breakdown all along and no screen ever showed it, so an order
                                    looked up later said only "دفع مقسّم" - which cannot be
                                    reconciled against a drawer.
                                -->
                                <Grid ColumnSpacing="8" Visibility="{Binding HasLookupPaymentBreakdown, Converter={StaticResource BoolToVisibleConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الدفع:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LookupPaymentBreakdown}" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid ColumnSpacing="8" Visibility="{Binding HasLookupTable, Converter={StaticResource BoolToVisibleConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المكان:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LookupTableLine}" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding OrderLookupResult.Items}" MaxHeight="220">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" TextWrapping="Wrap" TextAlignment="Right">
                                            <Run Text="{Binding Quantity}"/><Run Text=" × "/><Run Text="{Binding ProductName}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalPricePiastres, Converter={StaticResource PiastresToDisplayConverter}}" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding ReprintStatusMessage}" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding ReprintStatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <Button Content="مراجعة التحويل المعلق" Command="{Binding ReviewPendingOrderCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Visibility="{Binding LookupHasPendingPayment, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <Button Content="استرداد مبلغ" Command="{Binding OpenRefundCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Visibility="{Binding CanRefundOrder, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <Button AutomationProperties.AutomationId="OrderLookup_Reprint" Content="إعادة طباعة الفاتورة" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                                Command="{Binding ReprintOrderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
