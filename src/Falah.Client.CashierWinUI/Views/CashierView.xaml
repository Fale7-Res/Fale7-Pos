<UserControl x:Class="Falah.Client.CashierWinUI.Views.CashierView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Falah.Client.CashierWinUI.Views"
             FlowDirection="RightToLeft">
    <!--
        Deliberately a thin shell: the cart workspace and the product catalogue each live in their
        own UserControl (CartPanelView / ProductCatalogueView) rather than inline here. The WinUI 3
        XAML compiler (Microsoft.UI.Xaml.Markup.Compiler / XamlCompiler.exe, WindowsAppSDK 1.5)
        crashes silently (exit code 1, zero diagnostic output on any stream, no event-log entry -
        confirmed by direct invocation outside MSBuild too) whenever this single file contains BOTH
        the cart's ItemsControl DataTemplate and the catalogue's GridView DataTemplate together, even
        though each one alone compiles cleanly and the resources referenced are all present -
        narrowed down through binary-search isolation of the file's sections. Splitting them into
        separate files sidesteps the compiler bug entirely and is arguably better structure anyway.
        Both child views inherit DataContext (this control's CashierViewModel) automatically.
    -->
    <Grid Background="{StaticResource PosSurfaceBrush}">

        <!-- ================= SHIFT NOT OPEN: prompt to open one before anything else works ================= -->
        <Grid Background="{StaticResource SurfaceBrush}"
              Visibility="{Binding IsShiftOpen, Converter={StaticResource InverseBoolToVisibleConverter}}">
            <Border Style="{StaticResource CardBorderStyle}" Width="420" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="افتح الوردية" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="أدخل الرصيد الافتتاحي بالجنيه لبدء العمل" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBox Text="{Binding OpeningCashText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                             FontSize="20" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding OpenShiftError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding OpenShiftError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Button Content="فتح الوردية" Style="{StaticResource CtaButtonStyle}"
                            Command="{Binding OpenShiftCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MAIN POS WORKSPACE ================= -->
        <Grid x:Name="WorkspaceGrid" Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibleConverter}}" SizeChanged="OnWorkspaceSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CartColumn" Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <views:CartPanelView Grid.Column="0"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <views:CategoryStripView Grid.Row="0"/>
                <views:ProductCatalogueView Grid.Row="1"/>
            </Grid>
        </Grid>

        <!-- ================= VARIANT PICKER MODAL ================= -->
        <Grid Background="#B0000000" Visibility="{Binding IsVariantPickerOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="20" Padding="20" Width="420" MaxHeight="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✕" Background="Transparent" VerticalAlignment="Top" Padding="4" MinWidth="0" MinHeight="0"
                                Command="{Binding CloseVariantPickerCommand}"/>
                        <TextBlock Grid.Column="1" Text="{Binding VariantPickerProduct.Name}" Style="{StaticResource TitleText}"
                                   FontSize="18" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"/>
                    </Grid>
                    <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="10" Padding="10,8"
                            Visibility="{Binding HasPendingOffer, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="{Binding PendingOfferBanner}" FontSize="12" FontWeight="Bold" Foreground="#065F46"
                                   TextWrapping="Wrap" TextAlignment="Right"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding VariantPickerProduct.Variants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"
                                        Command="{Binding ElementName=Root, Path=DataContext.SelectVariantCommand}" CommandParameter="{Binding}">
                                    <!-- Same real-columns fix as the offer pill in ProductCatalogueView - two
                                         overlapping HorizontalAlignment TextBlocks garble as soon as a variant
                                         name is long enough to reach the price. -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PricePiastres, Converter={StaticResource PiastresToDisplayConverter}}"
                                                   FontWeight="Black" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= CHECKOUT MODAL ================= -->
        <Grid Background="#B0000000" Visibility="{Binding IsCheckoutOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Width="560" MaxHeight="700"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Background="#0F172A" CornerRadius="24,24,0,0" Padding="20,16">
                        <Grid>
                            <TextBlock Text="إنهاء ودفع الطلب" FontSize="16" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Right"/>
                            <Button Content="✕" Background="Transparent" Foreground="#94A3B8" HorizontalAlignment="Left" MinWidth="0" MinHeight="0" Padding="4"
                                    Command="{Binding CloseCheckoutCommand}"/>
                        </Grid>
                    </Border>

                    <StackPanel Padding="20" Spacing="14">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="كاش" Command="{Binding SetPaymentMethodCommand}" CommandParameter="cash"
                                    Style="{StaticResource PaymentMethodButtonStyle}" BorderBrush="{StaticResource SuccessBrush}"
                                    Background="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|SuccessBrush|WhiteBrush}"
                                    Foreground="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|WhiteBrush|TextPrimaryBrush}"/>
                            <Button Grid.Column="1" Content="فيزا" Command="{Binding SetPaymentMethodCommand}" CommandParameter="card"
                                    Style="{StaticResource PaymentMethodButtonStyle}" BorderBrush="{StaticResource BrandPrimaryBrush}"
                                    Background="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=card|BrandPrimaryBrush|WhiteBrush}"
                                    Foreground="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=card|WhiteBrush|TextPrimaryBrush}"/>
                            <Button Grid.Column="2" Content="إنستاباي" Command="{Binding SetPaymentMethodCommand}" CommandParameter="instapay"
                                    Style="{StaticResource PaymentMethodButtonStyle}" BorderBrush="{StaticResource InstaPayBrush}"
                                    Background="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|InstaPayBrush|WhiteBrush}"
                                    Foreground="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|WhiteBrush|TextPrimaryBrush}"/>
                            <Button Grid.Column="3" Content="محفظة" Command="{Binding SetPaymentMethodCommand}" CommandParameter="wallet"
                                    Style="{StaticResource PaymentMethodButtonStyle}" BorderBrush="{StaticResource WalletBrush}"
                                    Background="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=wallet|WalletBrush|WhiteBrush}"
                                    Foreground="{Binding PaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=wallet|WhiteBrush|TextPrimaryBrush}"/>
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                            <!-- Auto column for each fixed label, Star for the amount - the total/paid/change
                                 figures are exactly what grows long on a large order or a big cash tender. -->
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="إجمالي المبلغ المطلوب:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GrandTotalDisplay}" FontSize="22" FontWeight="Black" HorizontalAlignment="Left"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource CardBorderBrush}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المبلغ المدفوع:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AmountPaidText}" FontSize="20" FontWeight="Black" FontFamily="Consolas"
                                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الباقي للعميل:" FontWeight="ExtraBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangeDuePiastres, Converter={StaticResource PiastresToDisplayConverter}}"
                                               FontSize="16" FontWeight="Black" Foreground="{StaticResource BrandPrimaryBrush}" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CheckoutError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" TextAlignment="Center"
                                   Visibility="{Binding CheckoutError, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <StackPanel Spacing="10" Visibility="{Binding PaymentMethod, Converter={StaticResource StringEqualsToVisibleConverter}, ConverterParameter=cash}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="المبلغ بالضبط" Style="{StaticResource SecondaryButtonStyle}" Height="40" FontSize="11"
                                        Command="{Binding QuickCashCommand}" CommandParameter="{Binding GrandTotalDisplay}"/>
                                <Button Grid.Column="1" Content="50 ج" Style="{StaticResource SecondaryButtonStyle}" Height="40" FontSize="11"
                                        Command="{Binding QuickCashCommand}" CommandParameter="50"/>
                            </Grid>
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="1"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="2"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="3"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="4"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="5"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="6"/>
                                <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="7"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="8"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="9"/>
                                <Button Grid.Row="3" Grid.Column="0" Content="مسح" FontSize="12" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="clear"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="0"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource KeypadButtonStyle}" Command="{Binding PressAmountKeyCommand}" CommandParameter="back"/>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="رجوع" Style="{StaticResource SecondaryButtonStyle}" Height="52" FontSize="14"
                                    Command="{Binding CloseCheckoutCommand}"/>
                            <Button Grid.Column="1" Content="تأكيد الدفع" Style="{StaticResource SuccessButtonStyle}" Height="52" FontSize="15"
                                    Command="{Binding SubmitPaymentCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= POST-CHECKOUT CONFIRMATION ================= -->
        <Grid Background="#C0000000" Visibility="{Binding HasCheckoutResult, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="32" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <Border Background="#D1FAE5" CornerRadius="40" Width="72" Height="72">
                        <TextBlock Text="✓" FontSize="34" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="تم الدفع بنجاح" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="رقم الطلب: "/><Run Text="{Binding LastCheckoutResult.OrderNumber}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Black">
                        <Run Text="{Binding LastCheckoutResult.TotalPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                    </TextBlock>
                    <Button Content="طلب جديد" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                            Command="{Binding StartNewOrderCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= CLOSE SHIFT MODAL ================= -->
        <Grid Background="#B0000000" Visibility="{Binding IsCloseShiftOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="24" Width="420" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="إغلاق الوردية" Style="{StaticResource TitleText}" HorizontalAlignment="Right"/>
                        <Button Content="✕" Background="Transparent" HorizontalAlignment="Left" MinWidth="0" MinHeight="0" Padding="4"
                                Command="{Binding CancelCloseShiftCommand}"/>
                    </Grid>

                    <!-- STEP 1: blind count - the server's expected figure is never shown until
                         after this is submitted, matching the reference app's blind-close design. -->
                    <StackPanel Spacing="10" Visibility="{Binding IsCloseShiftCounting, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="عدّ الدرج فعليًا ثم أدخل المبلغ بالجنيه - سيظهر المتوقع بعد ذلك مباشرة."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding CloseShiftActualCashText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                                 FontSize="20" TextAlignment="Center"/>
                        <TextBlock Text="{Binding CloseShiftError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding CloseShiftError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="متابعة" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                                Command="{Binding PrepareCloseShiftCommand}"/>
                    </StackPanel>

                    <!-- STEP 2: confirm - expected/actual/difference, a reason, and (only when the
                         difference exceeds the server's threshold) a manager PIN. -->
                    <StackPanel Spacing="10" Visibility="{Binding CloseShiftPreview, Converter={StaticResource NullToCollapsedConverter}}">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المتوقع:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left"
                                               Text="{Binding CloseShiftPreview.ExpectedCashPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الفعلي المعدود:" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left"
                                               Text="{Binding CloseShiftPreview.ActualCashPiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource CardBorderBrush}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الفارق:" FontWeight="ExtraBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" FontSize="18" FontWeight="Black" HorizontalAlignment="Left"
                                               Text="{Binding CloseShiftPreview.DifferencePiastres, Converter={StaticResource PiastresToDisplayConverter}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBox PlaceholderText="سبب الفارق (اختياري إن كان ضمن الحد المسموح)"
                                 Text="{Binding CloseShiftReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Spacing="8" Visibility="{Binding CloseShiftNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="الفارق يتجاوز الحد المسموح - السبب أعلاه إلزامي، وأدخل رمز المدير المخوّل باعتماد الإغلاق."
                                       Foreground="{StaticResource DangerBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding CloseShiftManagerPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                                     PlaceholderText="رمز المدير" FontSize="18" TextAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding CloseShiftError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding CloseShiftError, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="رجوع" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                    Command="{Binding BackToCloseShiftCountCommand}"/>
                            <Button Grid.Column="1" Content="تأكيد الإغلاق" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                                    Command="{Binding ConfirmCloseShiftCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= ADD EXPENSE MODAL ================= -->
        <!-- Drawer-only by design - see CashierViewModel.Expense.cs's own doc comment for why a
             main-treasury expense has no place in this client. -->
        <Grid Background="#B0000000" Visibility="{Binding IsAddExpenseOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="24" Padding="24" Width="420" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="تسجيل مصروف من الدرج" Style="{StaticResource TitleText}" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                        <Button Content="✕" Background="Transparent" HorizontalAlignment="Left" MinWidth="0" MinHeight="0" Padding="4"
                                Command="{Binding CancelAddExpenseCommand}"/>
                    </Grid>

                    <!-- Two fixed rows rather than a wrapping panel - this WindowsAppSDK version's
                         XamlCompiler has a documented history of crashing silently on unusual
                         constructs (see CashierView.xaml.cs's own doc comment), and this project has
                         never used WrapPanel anywhere; a plain Grid is the one layout shape already
                         proven to compile and render correctly throughout this app. -->
                    <TextBlock Text="الفئة" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                    <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="مستلزمات" Style="{StaticResource SecondaryButtonStyle}" Padding="4,6" MinHeight="0" FontSize="11"
                                Command="{Binding SetExpenseCategoryCommand}" CommandParameter="مستلزمات"
                                Background="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=مستلزمات|ActionBlueBrush|WhiteBrush}"
                                Foreground="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=مستلزمات|WhiteBrush|TextPrimaryBrush}"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="مواصلات" Style="{StaticResource SecondaryButtonStyle}" Padding="4,6" MinHeight="0" FontSize="11"
                                Command="{Binding SetExpenseCategoryCommand}" CommandParameter="مواصلات"
                                Background="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=مواصلات|ActionBlueBrush|WhiteBrush}"
                                Foreground="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=مواصلات|WhiteBrush|TextPrimaryBrush}"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="صيانة" Style="{StaticResource SecondaryButtonStyle}" Padding="4,6" MinHeight="0" FontSize="11"
                                Command="{Binding SetExpenseCategoryCommand}" CommandParameter="صيانة"
                                Background="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=صيانة|ActionBlueBrush|WhiteBrush}"
                                Foreground="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=صيانة|WhiteBrush|TextPrimaryBrush}"/>
                        <Button Grid.Row="0" Grid.Column="3" Content="غاز" Style="{StaticResource SecondaryButtonStyle}" Padding="4,6" MinHeight="0" FontSize="11"
                                Command="{Binding SetExpenseCategoryCommand}" CommandParameter="غاز"
                                Background="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=غاز|ActionBlueBrush|WhiteBrush}"
                                Foreground="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=غاز|WhiteBrush|TextPrimaryBrush}"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="نظافة" Style="{StaticResource SecondaryButtonStyle}" Padding="4,6" MinHeight="0" FontSize="11"
                                Command="{Binding SetExpenseCategoryCommand}" CommandParameter="نظافة"
                                Background="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=نظافة|ActionBlueBrush|WhiteBrush}"
                                Foreground="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=نظافة|WhiteBrush|TextPrimaryBrush}"/>
                        <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="مشتريات عاجلة" Style="{StaticResource SecondaryButtonStyle}" Padding="4,6" MinHeight="0" FontSize="11"
                                Command="{Binding SetExpenseCategoryCommand}" CommandParameter="مشتريات عاجلة"
                                Background="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=مشتريات عاجلة|ActionBlueBrush|WhiteBrush}"
                                Foreground="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=مشتريات عاجلة|WhiteBrush|TextPrimaryBrush}"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="أخرى" Style="{StaticResource SecondaryButtonStyle}" Padding="4,6" MinHeight="0" FontSize="11"
                                Command="{Binding SetExpenseCategoryCommand}" CommandParameter="أخرى"
                                Background="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=أخرى|ActionBlueBrush|WhiteBrush}"
                                Foreground="{Binding ExpenseCategory, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=أخرى|WhiteBrush|TextPrimaryBrush}"/>
                    </Grid>

                    <TextBlock Text="المبلغ بالجنيه" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                    <TextBox Text="{Binding ExpenseAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                             FontSize="20" TextAlignment="Center"/>

                    <TextBox PlaceholderText="بيان المصروف" Text="{Binding ExpenseDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Spacing="8" Visibility="{Binding ExpenseNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="صلاحيتك الحالية لا تسمح بصرف مصروف من الدرج - أدخل رمز المدير المخوّل باعتماد هذا المصروف."
                                   Foreground="{StaticResource DangerBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding ExpenseManagerPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                                 PlaceholderText="رمز المدير" FontSize="18" TextAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ExpenseError}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding ExpenseError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <Button Content="تسجيل المصروف" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Stretch"
                            Command="{Binding SubmitExpenseCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
