<UserControl x:Class="Falah.Client.CashierWinUI.Views.ShellPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!--
        Kept in its own file rather than inline inside ShellView.xaml - see the file-level comment in
        CashierView.xaml documenting that WinUI 3's XamlCompiler.exe crashes silently on this
        WindowsAppSDK version when a single file mixes a NavigationView's item template with another
        templated content region. One page-content type per file sidesteps that entirely.

        Every module not yet wired to its real API lands here - an honestly-labeled "not built yet"
        state (see the "real data only" constraint: no fake data, but a page that legitimately has
        none yet should still look like part of the same finished product, not a bare wrench icon).
    -->
    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,24,28,0" Spacing="4">
            <TextBlock Text="{Binding ModuleTitle}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="هذه الوحدة ضمن خطة البناء - سيتم ربطها بالـ API الحقيقي في مرحلة لاحقة."
                       Style="{StaticResource PageSubtitleText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="420" Padding="36">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource InfoBackgroundBrush}">
                    <FontIcon Glyph="&#xE90F;" FontSize="26" Foreground="{ThemeResource InfoBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="قيد التطوير" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center"/>
                <TextBlock Text="التصميم والصلاحيات جاهزان لهذه الشاشة، والربط بالبيانات الفعلية قادم ضمن مراحل البناء التالية."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
