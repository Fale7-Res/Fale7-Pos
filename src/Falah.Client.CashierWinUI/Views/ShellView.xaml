<UserControl x:Class="Falah.Client.CashierWinUI.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!--
        The management shell's chrome. Page content lives in PageHost, populated from code-behind
        rather than an inline DataTemplate, matching the established pattern (see MainWindow.xaml.cs's
        ApplyCurrentView) of keeping WinUI's ContentControl content-swapping in code, because
        WinUI/UWP's ContentControl has no implicit "template by CLR type" resolution to bind against.

        This replaced a NavigationView. That control's MenuItemsSource + item template combination
        crashed the app at runtime with 0xc000027b on the SDK version this project shipped on, so its
        items had to be constructed in C# anyway - and a horizontal bar of grouped entries needs none
        of what NavigationView provides. Building the bar directly removes the control, and with it a
        whole documented crash class, rather than working around it.

        The bar carries the same dark ground as the app header directly above it, with no gap, so the
        two read as one piece of chrome instead of two stacked bars.
    -->
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ShellNavBrush}" Padding="14,0">
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <!-- Entries are appended here in code-behind, one per permitted group. -->
                <StackPanel x:Name="NavBar" Orientation="Horizontal" Spacing="2" MinHeight="46"
                            AutomationProperties.Name="أقسام النظام"/>
            </ScrollViewer>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>
