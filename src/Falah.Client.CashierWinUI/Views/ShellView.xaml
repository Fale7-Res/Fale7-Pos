<UserControl x:Class="Falah.Client.CashierWinUI.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!--
        The management shell's chrome. Page content lives in PageHost, populated from code-behind
        rather than an inline DataTemplate, matching the established pattern (see MainWindow.xaml.cs's
        ApplyCurrentView) of keeping WinUI's ContentControl content-swapping in code, because
        WinUI/UWP's ContentControl has no implicit "template by CLR type" resolution to bind against.

        This replaced a NavigationView. That control's MenuItemsSource + item template combination
        crashed the app at runtime with 0xc000027b on the SDK version this project shipped on, so its
        items had to be constructed in C# anyway - and a horizontal bar of grouped entries needs none
        of what NavigationView provides. Building the bar directly removes the control, and with it a
        whole documented crash class, rather than working around it.

        The bar carries the same dark ground as the app header directly above it, with no gap, so the
        two read as one piece of chrome instead of two stacked bars.
    -->
    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource ShellNavBrush}" Padding="14,0">
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <!-- Entries are appended here in code-behind, one per permitted group. -->
                <StackPanel x:Name="NavBar" Orientation="Horizontal" Spacing="2" MinHeight="46"
                            AutomationProperties.Name="أقسام النظام"/>
            </ScrollViewer>
        </Border>

        <!-- One row per unresolved attempt. It sits above every screen, so it must not take a third of
             the window: at four stacked rows per item it pushed the screen's own dialog (the very
             place the retry is pressed) below the fold. -->
        <Border Grid.Row="1" Padding="16,8" Background="{ThemeResource WarningBackgroundBrush}"
                BorderBrush="{ThemeResource WarningBrush}" BorderThickness="0,0,0,1"
                AutomationProperties.AutomationId="RecoveryPanel"
                Visibility="{Binding Recovery.HasItems, Converter={StaticResource BoolToVisibleConverter}}">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="4">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource WarningTextBrush}" FontSize="12">
                    <Run Text="محاولات تحتاج مراجعة: " FontWeight="Bold"/><Run Text="أعد المحاولة من شاشتها أولًا للتحقق. إذا استمر الرفض، راجع سجل العملية على السيرفر قبل إنهاء المحاولة المحفوظة؛ إنهاؤها لا يلغي أي عملية نُفّذت على السيرفر."/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Recovery.Items}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="12" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="{Binding Label}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Status}"/>
                            </TextBlock>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                                      Content="راجعت سجل السيرفر" IsChecked="{Binding ServerRecordReviewed, Mode=TwoWay}"/>
                            <Button Grid.Column="2" VerticalAlignment="Center" Content="إنهاء المحاولة المحفوظة"
                                    Command="{Binding DiscardCommand}" IsEnabled="{Binding CanDiscard}"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Error}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource DangerBrush}"
                                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsedConverter}}"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel></ScrollViewer>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Row="2"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>
