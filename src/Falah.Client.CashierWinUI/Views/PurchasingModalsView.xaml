<UserControl x:Class="Falah.Client.CashierWinUI.Views.PurchasingModalsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Falah.Client.CashierWinUI.Controls"
             FlowDirection="RightToLeft">
    <Grid>

        <!-- ================= ADD SUPPLIER ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsSupplierOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="20" Padding="24" Width="440" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <controls:ModalHeaderView Title="إضافة مورد" CloseCommand="{Binding CloseAddSupplierCommand}"/>
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="اسم المورد" MinHeight="44"
                                 Text="{Binding SupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="رقم الهاتف" InputScope="TelephoneNumber" MinHeight="44"
                                 Text="{Binding SupplierPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="التصنيف" MinHeight="44"
                                 Text="{Binding SupplierCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="ملاحظات" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding SupplierNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Spacing="6" Visibility="{Binding SupplierNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="صلاحيتك لا تسمح بإضافة مورد - أدخل رمز المدير المخوّل."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <PasswordBox IsEnabled="{Binding CanEditAction}" PlaceholderText="رمز المدير" MinHeight="44" FontSize="16"
                                         Password="{Binding SupplierManagerPin, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SupplierError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding SupplierError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="حفظ المورد" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitSupplierCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= RECEIVE PURCHASE ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsReceiveOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="20" Padding="24" Width="640" MaxHeight="720"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="10">
                        <controls:ModalHeaderView Title="استلام فاتورة مشتريات" CloseCommand="{Binding CloseReceiveCommand}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                            <Run Text="المورد: "/><Run Text="{Binding ReceiveSupplier.Name}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="رقم الفاتورة (اختياري)" MinHeight="44"
                                 Text="{Binding InvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="أصناف الفاتورة" Style="{StaticResource SectionTitleText}"/>
                            <ItemsControl ItemsSource="{Binding ReceiveLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12"
                                                Padding="12" Margin="0,0,0,8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ComboBox IsEnabled="{Binding ElementName=Root, Path=DataContext.CanEditAction}" Header="الصنف" HorizontalAlignment="Stretch" MinHeight="44"
                                                          ItemsSource="{Binding ElementName=Root, Path=DataContext.InventoryItems}"
                                                          DisplayMemberPath="Name" SelectedItem="{Binding Item, Mode=TwoWay}"/>
                                                <TextBox IsEnabled="{Binding ElementName=Root, Path=DataContext.CanEditAction}" Grid.Column="1" Header="الكمية" InputScope="Number" MinHeight="44"
                                                         Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox IsEnabled="{Binding ElementName=Root, Path=DataContext.CanEditAction}" Grid.Column="2" Header="سعر الوحدة" InputScope="Number" MinHeight="44"
                                                         Text="{Binding UnitCostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="3" Content="✕" MinHeight="44" MinWidth="44" VerticalAlignment="Bottom"
                                                        Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="حذف السطر"
                                                        Command="{Binding ElementName=Root, Path=DataContext.RemoveReceiveLineCommand}"
                                                        CommandParameter="{Binding}"/>

                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Style="{StaticResource CaptionText}"
                                                           Text="{Binding CostShiftNote}"
                                                           Visibility="{Binding HasCostShiftNote, Converter={StaticResource BoolToVisibleConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ إضافة صنف" MinHeight="44" HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddReceiveLineCommand}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <TextBlock Text="طريقة الدفع" Style="{StaticResource MutedText}"/>
                        <Grid ColumnSpacing="6" Background="#F0F3EF" CornerRadius="12" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="نقدًا" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding SetReceivePaymentMethodCommand}" CommandParameter="cash"
                                    Background="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|WhiteBrush|TransparentBrush}"
                                    Foreground="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|BrandPrimaryBrush|TextMutedBrush}"/>
                            <Button Grid.Column="1" Content="إنستاباي" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding SetReceivePaymentMethodCommand}" CommandParameter="instapay"
                                    Background="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|WhiteBrush|TransparentBrush}"
                                    Foreground="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|BrandPrimaryBrush|TextMutedBrush}"/>
                            <Button Grid.Column="2" Content="بنك" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding SetReceivePaymentMethodCommand}" CommandParameter="bank"
                                    Background="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=bank|WhiteBrush|TransparentBrush}"
                                    Foreground="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=bank|BrandPrimaryBrush|TextMutedBrush}"/>
                            <Button Grid.Column="3" Content="آجل" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding SetReceivePaymentMethodCommand}" CommandParameter="credit"
                                    Background="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=credit|WhiteBrush|TransparentBrush}"
                                    Foreground="{Binding ReceivePaymentMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=credit|BrandPrimaryBrush|TextMutedBrush}"/>
                        </Grid>

                        <!-- Credit means nothing moves through treasury; the paid box would only
                             manufacture a server rejection, so it is hidden rather than disabled. -->
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="المدفوع الآن بالجنيه" InputScope="Number" MinHeight="44"
                                 Visibility="{Binding IsCreditPurchase, Converter={StaticResource InverseBoolToVisibleConverter}}"
                                 Text="{Binding ReceivePaidText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="آجل: تُسجَّل الفاتورة كاملة على حساب المورد ولا يخرج أي مبلغ الآن."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Visibility="{Binding IsCreditPurchase, Converter={StaticResource BoolToVisibleConverter}}"/>

                        <!-- Optional on purpose. Most invoices arrive with no agreed term, and a
                             prefilled date here would become an agreed one nobody agreed to - which
                             is exactly how a payables report starts inventing overdue invoices. -->
                        <TextBox IsEnabled="{Binding CanEditAction}" Header="تاريخ الاستحقاق (اختياري)" MinHeight="44"
                                 PlaceholderText="2026-10-01"
                                 Text="{Binding ReceiveDueDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="اتركه فارغًا إن لم يُتفق على موعد سداد؛ لن تُحتسب الفاتورة متأخرة."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>

                        <StackPanel Spacing="6" Visibility="{Binding ReceiveNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                            <PasswordBox IsEnabled="{Binding CanEditAction}" PlaceholderText="رمز المدير" MinHeight="44" FontSize="16"
                                         Password="{Binding ReceiveManagerPin, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding ReceiveError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding ReceiveError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <!--
                            This system values an ingredient at its LAST purchase price, so one
                            keyed line becomes THE cost immediately - and with it every recipe using
                            that ingredient. A tenfold move is asked about once; it is never refused.
                        -->
                        <Border Background="{StaticResource WarningBackgroundBrush}" CornerRadius="10" Padding="12,10"
                                Visibility="{Binding HasSuspiciousCostShift, Converter={StaticResource BoolToVisibleConverter}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding SuspiciousCostShiftLabel}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                                <CheckBox Content="راجعت السعر وهو صحيح" MinHeight="44"
                                          IsEnabled="{Binding CanEditAction}"
                                          IsChecked="{Binding CostShiftAcknowledged, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <Button Content="تسجيل الاستلام" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitReceiveCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= PAY AN INVOICE ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsPayOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="20" Padding="24" Width="440" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <controls:ModalHeaderView Title="سداد فاتورة" CloseCommand="{Binding ClosePayCommand}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                            <Run Text="المتبقي على الفاتورة: "/>
                            <Run Text="{Binding PayTarget.RemainingAmountPiastres, Converter={StaticResource PiastresToDisplayConverter}}" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBox IsEnabled="{Binding CanEditAction}" Header="مبلغ السداد بالجنيه" InputScope="Number" MinHeight="44" FontSize="18" TextAlignment="Center"
                                 Text="{Binding PayAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="طريقة السداد" Style="{StaticResource MutedText}"/>
                        <Grid ColumnSpacing="6" Background="#F0F3EF" CornerRadius="12" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="نقدًا" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding SetPayMethodCommand}" CommandParameter="cash"
                                    Background="{Binding PayMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|WhiteBrush|TransparentBrush}"
                                    Foreground="{Binding PayMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=cash|BrandPrimaryBrush|TextMutedBrush}"/>
                            <Button Grid.Column="1" Content="إنستاباي" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding SetPayMethodCommand}" CommandParameter="instapay"
                                    Background="{Binding PayMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|WhiteBrush|TransparentBrush}"
                                    Foreground="{Binding PayMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=instapay|BrandPrimaryBrush|TextMutedBrush}"/>
                            <Button Grid.Column="2" Content="بنك" FontSize="12" Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding SetPayMethodCommand}" CommandParameter="bank"
                                    Background="{Binding PayMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=bank|WhiteBrush|TransparentBrush}"
                                    Foreground="{Binding PayMethod, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter=bank|BrandPrimaryBrush|TextMutedBrush}"/>
                        </Grid>

                        <StackPanel Spacing="6" Visibility="{Binding PayNeedsApproval, Converter={StaticResource BoolToVisibleConverter}}">
                            <PasswordBox IsEnabled="{Binding CanEditAction}" PlaceholderText="رمز المدير" MinHeight="44" FontSize="16"
                                         Password="{Binding PayManagerPin, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding PayError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding PayError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <Button Content="تنفيذ السداد" MinHeight="52" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitPayCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= DUE DATE ON AN INVOICE ALREADY RECEIVED ================= -->
        <Grid Background="#66313D35" Visibility="{Binding IsDueDateOpen, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="White" CornerRadius="20" Padding="24" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <StackPanel Spacing="14">
                    <controls:ModalHeaderView Title="تاريخ استحقاق الفاتورة" CloseCommand="{Binding CloseDueDateCommand}"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                        <Run Text="الفاتورة: "/>
                        <Run Text="{Binding DueDateTargetLabel}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBox IsEnabled="{Binding CanEditAction}" Header="التاريخ بصيغة سنة-شهر-يوم" MinHeight="44"
                             PlaceholderText="2026-10-01"
                             Text="{Binding DueDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="اتركه فارغًا لإلغاء تاريخ الاستحقاق - تعود الفاتورة إلى «بدون تاريخ» ولا تُحتسب متأخرة."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DueDateError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding DueDateError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Button Content="حفظ" MinHeight="52" HorizontalAlignment="Stretch"
                            Style="{StaticResource CtaButtonStyle}" Command="{Binding SubmitDueDateCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
