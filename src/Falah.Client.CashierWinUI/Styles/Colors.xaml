    <!-- ===================== Flat, non-themed utility resources ===================== -->

    <!-- Plain utility brushes needed for runtime Background/Foreground swaps (selected-state
         coloring) - see BoolToBrushConverter/StringEqualsToBrushConverter in Converters.cs.
         Deliberately NOT themed: many call sites use "White" to mean literal, always-white
         (e.g. a receipt preview standing in for real paper), and forcing those dark on a whim
         would silently misrepresent what they render. -->
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="White"/>

    <!--
        Product-card "image band" gradients - added for the commercial-POS visual pass. There is no
        real product photography in this system (no asset pipeline exists, and inventing fake photos
        would violate "real data only"), so instead of a photo, every product card gets an honest,
        deliberately-designed abstract gradient band carrying a large glyph - a genuine visual
        treatment, not a placeholder pretending to be something it isn't. Grill items (SendToGrill)
        get the warm charcoal gradient; everything else gets the cool slate one, so the grid still
        reads with real variety instead of one flat color repeated 40 times. Kept flat (not themed):
        a decorative image-band behind a glyph, not a text-bearing surface, so it does not need to
        invert with the shell - a lower-priority (P8) item revisited only if it ever looks wrong
        against a dark card in practice.
    -->
    <LinearGradientBrush x:Key="ProductImageGrillGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0"/>
        <GradientStop Color="#DC2626" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProductImageDefaultGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E3A5F" Offset="0"/>
        <GradientStop Color="#0F52BA" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
