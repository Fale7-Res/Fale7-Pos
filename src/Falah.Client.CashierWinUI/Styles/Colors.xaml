<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        NEXT.JS PARITY — 2026-09-12: the brand accent below was drifting green (#156B5A /
        #146C59) while this file's own comment still described "genuinely two blues". The
        reference app (app/globals.css + AppShell.tsx's own `bg-[#0F52BA]` active-nav class) is
        unambiguous: the primary accent is #0F52BA, hover #0A3D8F. Those are restored here as the
        LIGHT theme, extracted from the actual computed reference values, not re-guessed.

        One real trap found in the reference during extraction: app/globals.css overrides
        `.bg-red-600 { background:#0F52BA !important }` (and the matching hover/text/border/focus
        variants) - so every `bg-red-600` in the reference TSX renders BLUE, not red. Reading
        Tailwind class NAMES off the reference source would have produced a wrong palette; the
        values here come from the override, not the class name.

        THEME STRUCTURE: every key below is defined identically by NAME in both the Light and
        Dark ResourceDictionary.ThemeDictionaries entries, so existing `{ThemeResource XyzBrush}`
        bindings resolve correctly in both without any call site needing to know which theme is
        active. Light is the parity theme and must track the reference; Dark has no Next.js
        reference to extract (the reference ships no dark theme at all - globals.css declares
        `color-scheme: light` and the codebase has zero `dark:` Tailwind usage) and is therefore a
        documented C#-only extension, built from the same semantic structure and the same brand
        hue family rather than invented ad hoc per screen.

        WhiteBrush/TransparentBrush stay OUTSIDE the theme dictionaries, unchanged: they are
        already used as generic "always this literal colour" utility brushes (state-swap
        converter parameters, genuinely-white surfaces), not surface tokens - forcing them dark
        would silently break whichever of their many call sites actually means literal white.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================== LIGHT — parity theme ============================== -->
        <ResourceDictionary x:Key="Light">

            <Color x:Key="BrandPrimaryColor">#0F52BA</Color>
            <Color x:Key="BrandPrimaryHoverColor">#0A3D8F</Color>
            <Color x:Key="BrandPrimaryPressedColor">#083069</Color>
            <!-- Restored to the value this file's own comment always described: a brighter blue
                 reserved for the single big checkout CTA, distinct from nav/price BrandPrimary. -->
            <Color x:Key="ActionBlueColor">#0866E8</Color>
            <Color x:Key="ActionBlueHoverColor">#0757C5</Color>

            <!-- Reference body background (app/globals.css body class) and its one card border
                 shade (the reference's own base-layer `border-color` custom-property default, #e2e8f0). The
                 reference has no second surface tone - card vs. page is white-on-#F5F5F5, not two
                 grays - so PosSurface tracks Surface exactly rather than inventing a shade. -->
            <Color x:Key="SurfaceColor">#F5F5F5</Color>
            <Color x:Key="PosSurfaceColor">#F5F5F5</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="CardBorderColor">#E2E8F0</Color>
            <Color x:Key="DividerColor">#E2E8F0</Color>

            <!-- Dark app header - unchanged; #1A1F26 already matched the reference's own
                 own colour-graphite custom property exactly and was never part of the green drift. -->
            <Color x:Key="GraphiteColor">#1A1F26</Color>
            <Color x:Key="GraphiteBorderColor">#2C343E</Color>
            <Color x:Key="GraphiteButtonColor">#232931</Color>

            <!-- Dark cart/sidebar palette - POS order workspace only. White in Light, matching
                 the reference's own white order-panel card. -->
            <Color x:Key="CartBackgroundColor">#FFFFFF</Color>
            <Color x:Key="CartHeaderColor">#FFFFFF</Color>
            <Color x:Key="CartTabBarColor">#F0F3EF</Color>
            <Color x:Key="CartItemCardColor">#FFFFFF</Color>
            <Color x:Key="CartItemBorderColor">#E5EAE4</Color>
            <Color x:Key="CartFooterColor">#F9FAF7</Color>

            <!-- Semantic. Success/Warning/Danger/Info are the reference's own Tailwind palette
                 values (emerald-600 / amber-600 / red-600 / blue-600) - the .bg-red-600 override
                 above repoints ONE literal Tailwind class to the brand blue, it does not change
                 what "danger" semantically means in the reference's own design language; a real
                 destructive action still reads as red there (bg-red-50, text-red-700, etc., all
                 untouched by the override). -->
            <Color x:Key="SuccessColor">#059669</Color>
            <Color x:Key="SuccessHoverColor">#047857</Color>
            <Color x:Key="WarningColor">#D97706</Color>
            <Color x:Key="DangerColor">#DC2626</Color>
            <Color x:Key="DangerHoverColor">#B91C1C</Color>
            <Color x:Key="DangerBackgroundColor">#FEF2F2</Color>
            <Color x:Key="InstaPayColor">#7C3AED</Color>
            <Color x:Key="WalletColor">#C026D3</Color>
            <Color x:Key="MultiPayColor">#D97706</Color>

            <!-- Text. TextPrimary/TextMuted were also green-drifted (#25342E / #66756C); restored
                 to the reference's own body text colour (`text-slate-900` in app/layout.tsx) and
                 its standard muted register (Tailwind slate-500), respectively. TextSecondary is a
                 new token for the reference's other common secondary tone (slate-600). -->
            <Color x:Key="TextPrimaryColor">#0F172A</Color>
            <Color x:Key="TextSecondaryColor">#475569</Color>
            <Color x:Key="TextMutedColor">#64748B</Color>
            <Color x:Key="TextOnDarkColor">#FFFFFF</Color>
            <Color x:Key="TextOnDarkMutedColor">#94A3B8</Color>

            <!-- New: disabled state and the modal scrim. The scrim was a hardcoded, undocumented
                 #66313D35 repeated across every modal in 21 view files - a green-black tint, itself
                 a fossil of the same colour drift - centralised here as one real semantic token,
                 with every one of those 38 call sites now pointing at OverlayBrush instead. -->
            <Color x:Key="DisabledBackgroundColor">#F1F5F9</Color>
            <Color x:Key="DisabledTextColor">#94A3B8</Color>
            <Color x:Key="OverlayColor">#66000000</Color>

            <!-- Focus ring - the reference's own `button:focus-visible { outline: 3px solid
                 rgba(15,82,186,.24); outline-offset:2px }` (app/globals.css), extracted as a
                 stroke colour/thickness pair for controls that draw their own focus indicator. -->
            <Color x:Key="FocusRingColor">#3D0F52BA</Color>

