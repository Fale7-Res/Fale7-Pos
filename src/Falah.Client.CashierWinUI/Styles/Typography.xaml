<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Same sizes/weights as the WPF technical-reference client's Styles/Typography.xaml, measured
        with getComputedStyle() against the ACTUAL RENDERED reference app (localhost:3000, cashier PIN
        1111, 1366x768) during the 2026-09-02 visual parity pass - not eyeballed, not re-guessed for
        this port. Segoe UI matches the reference app's own font-family stack exactly.
    -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="FlowDirection" Value="RightToLeft"/>
    </Style>

    <!-- Grand total figure ("الإجمالي النهائي"): measured 24px/900. -->
    <Style x:Key="TotalAmountText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Black"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Black"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}"/>
    </Style>

    <!-- Product tile name: measured 15px/800, 2-line wrap. -->
    <Style x:Key="ProductNameText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Product tile / variant price: measured 16px/900, brand blue. -->
    <Style x:Key="PriceText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}"/>
    </Style>

    <!-- Category tile label: measured 12px/700. -->
    <Style x:Key="CategoryLabelText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- Small badge/pill text (variant tag, offer tag): measured 11px/700. -->
    <Style x:Key="SmallBadgeText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Cart line product name: measured 13px/700, white (on the dark cart panel). -->
    <Style x:Key="CartItemNameText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <!-- Management-shell scale, added for Reports/Delivery/Inventory/etc. A page never needs the
         POS's TitleText/TotalAmountText sizes (those exist for a cashier reading a total from arm's
         length on a touch terminal); this scale is tuned for a manager reading a dense screen up
         close on a desktop monitor. -->
    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}"/>
    </Style>

    <!-- Summary-card headline figure (a KPI number: "١٢٤ طلب", "٤٥,٢٠٠ ج.م"). -->
    <Style x:Key="MetricValueText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Black"/>
    </Style>

    <Style x:Key="TableHeaderText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="TableCellText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="StatusPillText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="NavItemText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextOnDarkBrush}"/>
    </Style>

</ResourceDictionary>
