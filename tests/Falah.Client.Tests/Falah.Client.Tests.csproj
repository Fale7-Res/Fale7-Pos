<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <Compile Remove="NativeFooterLayoutProbe.cs" />
    <Compile Remove="NativeScreenLayoutProbe.cs" />
    <Compile Remove="NativeManagementLayoutProbe.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Falah.Application/Falah.Application.csproj" />
    <!-- ThemeService/ThemeResources are excluded: both depend on Microsoft.UI.Xaml types
         (ElementTheme, FrameworkElement, ResourceDictionary) that only exist in the real WinUI 3
         app, not in this plain net8.0 test project - the same reason HeaderViewModel/MainViewModel
         are excluded from the ViewModels glob below. -->
    <Compile Include="../../src/Falah.Client.CashierWinUI/Services/*.cs"
             Exclude="../../src/Falah.Client.CashierWinUI/Services/ThemeService.cs;../../src/Falah.Client.CashierWinUI/Services/ThemeResources.cs"
             Link="Client/Services/%(Filename)%(Extension)" />
    <Compile Include="../../src/Falah.Client.CashierWinUI/Models/*.cs" Link="Client/Models/%(Filename)%(Extension)" />
    <!-- SettingsViewModel.Appearance.cs is excluded alongside them for the same reason as
         ThemeService/ThemeResources above: it references AppTheme/ThemeService directly. The
         resulting InitializeAppearance() call in SettingsViewModel.cs simply elides in this build,
         which is exactly what an unimplemented partial method is designed to do. -->
    <Compile Include="../../src/Falah.Client.CashierWinUI/ViewModels/*.cs" Exclude="../../src/Falah.Client.CashierWinUI/ViewModels/HeaderViewModel.cs;../../src/Falah.Client.CashierWinUI/ViewModels/MainViewModel.cs;../../src/Falah.Client.CashierWinUI/ViewModels/SettingsViewModel.Appearance.cs" Link="Client/ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../src/Falah.Client.CallCenterWinUI/Services/*.cs" Link="CallCenter/Services/%(Filename)%(Extension)" />
    <Compile Include="../../src/Falah.Client.CallCenterWinUI/Models/*.cs" Link="CallCenter/Models/%(Filename)%(Extension)" />
    <Compile Include="../../src/Falah.Client.CallCenterWinUI/ViewModels/CallCenterViewModel*.cs" Link="CallCenter/ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../src/Falah.Client.CallCenterWinUI/ViewModels/MainViewModel.cs" Link="CallCenter/ViewModels/MainViewModel.cs" />
    <Compile Include="../../src/Falah.Client.CashierWinUI/ViewModels/MainViewModel.cs" Link="Client/ViewModels/MainViewModel.cs" />
    <Compile Include="../../src/Falah.Client.CallCenterWinUI/ViewModels/LoginViewModel.cs" Link="CallCenter/ViewModels/LoginViewModel.cs" />
  </ItemGroup>
</Project>
