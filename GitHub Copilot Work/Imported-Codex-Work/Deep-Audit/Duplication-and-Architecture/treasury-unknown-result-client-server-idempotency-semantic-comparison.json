  "artifact_kind": "source_semantic_comparison",
  "id": "SEM-MIRROR-055",
  "baseline": "c35816ecae49633674775dd32061c6ee92f94aaf",
  "created_at": "2026-10-22",
  "reviewer": "/root main coordinator; source-level comparison; no runtime execution",
  "title": "Treasury unknown-result retry across cashier client and server",
  "scope": "Compare Cashier WinUI deposit/withdraw/transfer recovery after uncertain HTTP outcomes with server replay keys, durable side effects and test coverage. Cross-layer supplement to SEM-028 and existing UI-001.",
  "decision": "SAME-PROCESS RETRY PRESERVES ORIGINAL REQUEST KEY; CLIENT REQUEST STATE IS VOLATILE ACROSS PROCESS RESTART; SERVER IDEMPOTENCY IS KEYED TO THAT REQUEST ID. CONDITIONAL RECOVERY / DUPLICATE-INTENT RISK REUSES UI-001. NO DUPLICATE MOVEMENT WAS RUNTIME-PROVEN; NO NEW FINDING CREATED.",
  "behavior": {
    "client": "TreasuryViewModel creates a request ID when an action opens, builds one typed command and holds its delegate while pending; an OutcomeUnknown retains the delegate for same-process retry and success clears it. AppSession explicitly uses process-only state and Shell navigation blocks only while that session is alive.",
    "server": "Deposit/withdraw/transfer derive idempotency keys from the typed request IDs, replay existing movements by key, and atomically persist the movement, journal and audit; transfer also persists a linked CashHandover. A new ID is a distinct operation.",
    "interpretation": "After process loss, inspected client code does not restore the original request identity. This is a reconciliation gap, not proof of a second transaction. An operator submitting a fresh action after an uncertain commit could create a new intent; runtime occurrence is unknown."
  },
  "cross_file_call_chain": [
    "TreasuryViewModel.OpenTreasuryAction -> SubmitTreasuryActionAsync -> typed ApiClient POST -> SendAsync classifies transport/JSON/cancellation/IO as OutcomeUnknown -> Program.cs maps routes -> handler replay key is based on request ID -> transaction persists ledger side effects.",
    "Same-process unresolved state is retained by TreasuryViewModel/AppSession and checked by ShellViewModel.Navigate; none of those state holders is durable across process restart."
  ],
  "existing_finding": {
    "id": "UI-001",
    "relationship": "Treasury-specific client/server trace supplements existing cashier lost-request-identity finding. Reuse the canonical ID; do not duplicate it."
  },
  "new_finding_created": false,
  "counterevidence_and_limits": [
    "Same-process retry uses the same typed request and ID.",
    "Navigation is blocked during unresolved operation while process remains alive.",
    "Server same-key replay and transaction behavior are source-confirmed; existing tests cover server same-key replay/concurrency.",
    "No app process was killed and no API/database operation was run; no duplicate movement is established.",
    "Whether a cashier creates a fresh request after restart is an operator/workflow question, not proven behavior.",
    "Changed payload under an existing replay key is a separate contract question and was not classified as a defect here."
  ],
  "recommendation": "For a future repair, persist the immutable typed request and request ID before dispatch and restore/reconcile it after reauthentication, or provide server operation-status lookup by the original ID. Gate new treasury action until reconciliation. Do not persist credentials/PIN; protect and minimize local financial request state.",
  "tests": {
    "executed": "NONE",
    "needed": [
      "For each deposit/withdraw/transfer, simulate server commit then lost response; reconstruct AppSession/TreasuryViewModel; verify same ID and payload restore and exactly one movement, journal, audit, plus one CashHandover for transfer.",
      "Simulate failure before commit and restart/retry; verify one complete operation.",
      "Verify unresolved recovery blocks fresh request creation until resolved.",
      "Test reauthentication and local request-state protection without storing credentials or approval PINs.",
      "Test same request ID with altered payload and record the intended replay contract."
    ],
    "limitations": "No UI, integration, SQL or runtime tests executed."
  },
