  "comparisons": [
    {
      "contract": "Actor/target binding",
      "evidence": "CommandReceipt.FindAsync checks transaction plus UserId/ReferenceId; CorrectAttendance checks same actor/record before returning immutable prior DTO. PayEmployee LoadReplay and CashOut early replay select deterministic keys only; EmployeeLedgerPoster also returns null on ID only.",
      "conclusion": "Distinct contracts, not an automatic unauthorized financial-write finding. A successful replay does not post a new movement; authenticated-session boundary, caller key generation and conflict policy must be retained. Neither stronger helper binds the entire payload."
    },
    {
      "contract": "Single-use manager approval versus durable retry",
      "evidence": "Overtime90/ExtraShift138 authorize before replay100-105/149-153; own permission bypass in AuthorizeCommand73, otherwise ValidateApproval89-97 rejects consumed token. EfApprovalRegistry tracks Consumed; first handler Save107/155 persists pending token consumption and ledger entry.",
      "conclusion": "Source-supported lost-response recovery defect lead for legitimate actor lacking employees_ledger using a consumed manager approval: same-key retry fails before finding saved ledger. Own-permission actor bypass is counterevidence to unconditional claim. CorrectAttendance and CashOut demonstrate replay-before-reconsumption alternative. Independent challenge requested; no runtime reproduction or duplicate-money claim."
    },
    {
      "contract": "Daily wage natural-key rule",
      "evidence": "DailyWage52/57-58 deliberately rejects same employee/day/shift instead of returning a request receipt.",
      "conclusion": "Intentional duplicate-business-operation rejection must not be erased by blanket shared retry refactor."
    }
  ],
