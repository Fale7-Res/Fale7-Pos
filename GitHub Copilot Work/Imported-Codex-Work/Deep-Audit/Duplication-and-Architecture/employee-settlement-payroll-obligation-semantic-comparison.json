{
  "artifact_kind": "bounded_semantic_crossflow_comparison",
  "id": "SEM-MIRROR-017-REPAIR-READINESS-SUPPLEMENT",
  "baseline": "c35816ecae49633674775dd32061c6ee92f94aaf",
  "created_at_utc": "2026-10-21T03:52:20.756Z",
  "scope": "Repair-readiness supplement to existing SEM-MIRROR-017. This does not add a second comparison group or a new finding.",
  "decision": "SUPPLEMENTS SEM-MIRROR-017: distinct payout workflows are source-confirmed; same-obligation duplicate remains policy/runtime conditional.",
  "related_existing_findings": [
    "FIN-CAND-EMPLOYEE-PAYROLL-OVERLAP-001"
  ],
  "severity": "HIGH conditional financial risk; not a confirmed duplicate-pay defect",
  "confidence": "HIGH for distinct source mechanics; owner policy and same-period runtime sequence unresolved",
  "source_confirmed": true,
  "runtime": {
    "status": "NOT_EXECUTED",
    "reason": "No disposable SQL/HTTP test or real transaction authorized/executed; static only."
  },
  "manual_reasoning": {
    "standalone_settlement": {
      "entry": "PayEmployeeHandler.HandleAsync",
      "flow": "Accepts standalone employee settlement request, checks current employee balance and protected treasury balance, posts treasury movement plus Settlement ledger debit under a standalone request idempotency key and transaction.",
      "source_ranges": [
        [
          46,
          154
        ]
      ],
      "symbol_context": "The call is not tied to payroll run or period in handler evidence."
    },
    "payroll_creation": {
      "entry": "CreatePayrollHandler.HandleAsync",
      "flow": "Selects period ledger entries, creates PayrollLineInput, calculates and persists a frozen Draft run. PayPayroll later uses that stored line amount.",
      "source_ranges": [
        [
          29,
          104
        ]
      ],
      "symbol_context": "The creation query filters by UTC year/month; period entries are not recalculated by PayPayroll."
    },
    "calculation": {
      "entry": "PayrollRules.CalculatePayrollLines",
      "flow": "Builds base from MonthlySalary or DailyWage/Salary credits, plus overtime/extra-shift/bonus earnings, less named deductions/adjustments and requested advance deduction. Settlement debit is not an explicit payroll deduction category in the reviewed calculation.",
      "source_ranges": [
        [
          83,
          110
        ]
      ],
      "symbol_context": "This supports separate accounting treatment; whether Settlement is intended to offset payroll is a business policy not established by source."
    },
    "payroll_payment": {
      "entry": "PayPayrollHandler.HandleAsync",
      "flow": "Reads persisted run lines, sums NetPayablePiastres, then within a database transaction posts one Treasury payroll movement, per-line PayrollSettlement ledger entries, and marks run Paid.",
      "source_ranges": [
        [
          39,
          182
        ]
      ],
      "symbol_context": "The handler does not recompute the run from current employee balance before paying; this is consistent with paying a frozen approved run, but enables overlap if standalone settlement covers the same earnings."
    }
  },
  "conclusion": "The two mechanisms are distinct, not mirrored copies: PayEmployee is an independent ledger settlement; payroll is a period-snapshot obligation, with a separate approval/payment path. A same-period double payout is possible only if the owner intends standalone Settlement and period payroll to cover the same earning obligation and both authorized flows are used. Source demonstrates separate posting mechanics, not that an operator actually did this or that policy prohibits it.",
  "counterevidence_and_limits": [
    "Standalone settlement checks current employee balance, so it cannot by itself pay more than current ledger balance at the time it runs.",
    "Payroll uses a unique live-period run constraint and frozen approved lines; this prevents multiple concurrent active runs, not cross-channel offset of standalone settlements.",
    "Payroll lines and settlement types may be intentionally independent; no owner policy defines whether the categories overlap.",
    "No isolated combined-sequence test or production data inspection was performed."
  ],
  "owner_decision_needed": "Clarify whether a standalone Settlement is an advance against earnings already included in a month payroll, a separate obligation, or an exclusive alternate process. If same obligation, decide whether settlements before run creation reduce the run and whether settlements after approval/payroll freeze invalidate or adjust the approved amount.",
  "repair_options": [
    {
      "option": "Treat standalone Settlement as a prepayment against current-period payroll",
      "requirements": [
        "Persist period/obligation attribution for settlement.",
        "Payroll creation subtracts valid period settlements before freezing.",
        "If settlement occurs after run freeze, require controlled recalculation/revision or block payout; preserve approved historical version and audit trail."
      ]
    },
    {
      "option": "Treat standalone Settlement as a separate liability class",
      "requirements": [
        "Document separate accounting source and avoid implying period earnings are offset.",
        "Verify employee balance and payroll totals represent distinct obligations.",
        "Add tests that prove the two categories cannot double-count a common earning."
      ]
    },
    {
      "option": "Make payment modes exclusive per employee/period",
      "requirements": [
        "Enforce server-side invariant, not only UI visibility.",
        "Provide migration/legacy behavior for already-created runs and ledger rows."
      ]
    }
  ],
  "required_tests": [
    "Disposable SQL integration: create same-period earning, post standalone Settlement, create and pay payroll; assert chosen policy and one obligation funded exactly once.",
    "Reverse order: create and approve a frozen payroll run, post a standalone settlement, then attempt payroll payment; assert policy-specific block/revision/remaining liability.",
    "Concurrent distinct payment requests around payroll approval/payment; assert database serialization and one permitted outcome.",
    "Idempotent retries after lost response for each flow; assert no duplicate treasury movement or employee ledger debit.",
    "Legacy-data test for outstanding and partially settled employees."
  ],
  "acceptance_criteria": [
    "Owner-approved accounting policy is recorded and the source/API enforcement matches it.",
    "For every allowed sequence, employee payable balance and treasury outflow reconcile to the same obligation without duplicate debit/payout.",
    "A frozen payroll run cannot silently pay a superseded amount if policy permits a later standalone settlement.",
    "Rejected/conflicting operations leave no partial ledger or treasury writes; retries return a durable result.",
    "Existing distinct-obligation use cases remain payable and auditable."
  ],
  "implementation_readiness": "Policy decision required before selecting a code fix; source mechanics and test plan are explicit.",
