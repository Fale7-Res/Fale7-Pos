{
  "artifact_kind": "manual_semantic_comparison",
  "id": "SEM-MIRROR-041",
  "baseline": "c35816ecae49633674775dd32061c6ee92f94aaf",
  "created_at_utc": "2026-10-21T08:09:00.065029+00:00",
  "scope": "Bounded comparison of inventory metadata CostSource changes, estimated-cost updates, cost resolution, exposed inventory detail/client surfaces, actual-purchase precedence, and existing recipe-cost integration-test source.",
  "decision": "The implementations are distinct commands, not duplicate code. Create/update handlers maintain CostSource metadata and inventory identity/unit invariants; SetEstimatedCostHandler stores an audited estimate without stock, supplier or treasury postings; CostingRules uses an active prep recipe exclusively for Prep items, otherwise latest actual purchase before a strictly-positive estimate. This is coherent for priced non-prep ingredients. Two unresolved boundary questions are: setter accepts zero while resolver treats zero as unknown, and setter accepts estimates for Prep items while Prep resolution bypasses estimates and purchase fallback. These are policy questions, not confirmed defects: owner rules do not state whether zero is valid or Prep estimates are forbidden. Bounded client search found no Cashier WinUI call to this endpoint; route remains available to other consumers, so this does not prove dead code.",
  "finding_candidate": null,
  "related_existing_findings": [],
  "severity": "No new finding assigned; unresolved behavior/policy ambiguity only, with no financial posting in estimate command.",
  "confidence": "High for source behavior/data flow; undetermined for owner policy, actual deployment and runtime client use.",
  "manual_reasoning": {
    "metadata_path": "CreateInventoryItemHandler initializes CostSource but not estimated amount. UpdateInventoryItemHandler changes CostSource and metadata, refusing unit changes after any movement; it does not mutate estimate.",
    "estimate_path": "Setter rejects negatives, authorizes inventory_manage, loads item, returns if unchanged, stores nullable estimated piastres, appends audit event and saves. It creates no stock movement, supplier balance, treasury movement or business-day dependency.",
    "cost_selection": "Prep is checked first and uses an active prep recipe; absent recipe produces Unknown with no purchase/estimate fallback. Non-Prep uses latest purchase first, else estimate only when >0, else Unknown.",
    "cross_layer": "Server route overwrites body item ID with route ID. Inventory DTO exposes nullable estimate. WinUI API exposes create/update methods but bounded search did not find estimated-cost request method or call. Detail VM loads item detail and labels CostSource.",
    "test_evidence": "Existing Recipe_cost_detail_prices_every_line_and_says_where_each_price_came_from source sets a 5000-piaster estimate on a non-prep ingredient and expects Estimated. It does not test zero, clearing or Prep estimates. Test not run.",
    "disposition": "No dangerous duplicate implementation found. Estimated values and invoices remain distinct. No finding ID. Decide whether zero means valid free cost or unknown, and whether estimates may be stored on Prep items. If zero is valid, resolver must distinguish it from unknown; if not, setter should reject it. If Prep estimates are forbidden, reject them; otherwise communicate that prep cost ignores them.",
    "search_method": "Read exact handlers, domain resolver, request DTOs, route, inventory projection, detail ViewModel, API client declarations and existing integration-test source. rg search of Cashier WinUI, CallCenter WinUI and legacy Cashier for SetEstimatedCost, estimated-cost, EstimatedUnitCost found no match. Bounded negative evidence only.",
    "counterevidence": "Comments describe estimates as placeholders and actual purchases as overriding facts. Prep items use recipe-derived cost. Zero may intentionally mean unknown; an estimate on Prep may be retained for later if CostSource changes. Both policies need owner confirmation.",
    "runtime": "No test/build/API/database/UI operation executed."
  },
  "recommended_action": "No implementation recommendation without owner policy. Decide zero and Prep-source estimate semantics, then align setter validation, cost resolver, DTO and UI. Keep estimates separate from inventory/purchase/treasury ledger postings.",
  "required_tests": [
    "Zero estimate semantics match resolver and recipe completeness.",
    "Prep estimate is either rejected or documented as retained-but-unused until CostSource changes.",
    "A real purchase remains higher priority than estimate for non-Prep items.",
    "Clearing estimate yields Unknown absent a purchase and preserves audit history.",
    "Estimate updates never create stock movement, purchase, supplier payable or treasury movement.",
    "Unit-change guard still checks historical stock movements."
  ],
  "acceptance_criteria": [
    "No estimate-only action writes a financial/stock ledger or supplier obligation.",
    "Zero and Prep estimate semantics are explicit and consistent.",
    "No duplicate finding ID is created.",
    "Actual purchase precedence and recipe-derived Prep costing remain intact."
  ],
  "runtime": "NOT_EXECUTED. Source inspection and test-source reading only.",
  "limits": [
    "No database/server execution.",
    "No tests run.",
    "No WinUI screen observation.",
    "Client search excludes reflection/generated invocation and is not a dead-code proof.",
    "Owner intent for zero and Prep estimates is unknown."
  ],
