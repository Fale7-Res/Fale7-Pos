                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{StaticResource BLine}" BorderThickness="1,1,1,1"><TextBlock Text="رقم الفاتورة" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border Grid.Column="1" BorderBrush="{StaticResource BLine}" BorderThickness="0,1,1,1"><TextBlock Text="الوقت" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border Grid.Column="2" BorderBrush="{StaticResource BLine}" BorderThickness="0,1,1,1"><TextBlock Text="هاتف العميل" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border Grid.Column="3" BorderBrush="{StaticResource BLine}" BorderThickness="0,1,1,1"><TextBlock Text="السائق" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border Grid.Column="4" BorderBrush="{StaticResource BLine}" BorderThickness="0,1,1,1"><TextBlock Text="الإجمالي" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border Grid.Column="5" BorderBrush="{StaticResource BLine}" BorderThickness="0,1,1,1"><TextBlock Text="إجراءات" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="DeliveryShiftRowsPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="InventoryOverviewOverlay" Background="#50000000" Visibility="Collapsed" Panel.ZIndex="1195" MouseLeftButtonDown="InventoryOverviewOverlay_MouseLeftButtonDown">
                    <Border x:Name="InventoryOverviewModalBorder" Width="1100" Height="780" Background="{StaticResource BQueue}" BorderBrush="#FF6B6B6B" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewMouseLeftButtonDown="InventoryOverviewModalBorder_PreviewMouseLeftButtonDown">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{StaticResource BBlue2}">
                                <Grid Margin="10,0" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="InventoryOverviewRefreshButton" Grid.Column="0" Width="92" Height="28" Margin="0,0,8,0" VerticalAlignment="Center" Content="تحديث" FontWeight="Black" FontSize="12" Click="InventoryOverviewRefreshButton_Click"/>
                                    <TextBlock x:Name="InventoryOverviewTitleText" Grid.Column="1" Text="المخزون المشترك" Foreground="White" FontWeight="Black" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="RightToLeft"/>
                                    <Button x:Name="InventoryOverviewCloseButton" Grid.Column="2" Width="26" Height="22" Content="✕" FontWeight="Black" Foreground="White" Background="#22000000" BorderBrush="#55FFFFFF" VerticalAlignment="Center" Click="InventoryOverviewCloseButton_Click"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Padding="10">
                                <Border Background="White" BorderBrush="#FF666666" BorderThickness="1" Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="InventoryOverviewRowsPanel"/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AdminAddCategoryOverlay" Background="#40000000" Visibility="Collapsed" Panel.ZIndex="1200">
                    <Border x:Name="AdminAddCategoryModalBorder" Width="420" Background="{StaticResource BQueue}" BorderBrush="#FF6B6B6B" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewKeyDown="AdminAddCategoryModalBorder_PreviewKeyDown">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{StaticResource BBlue2}">
                                <TextBlock Text="إضافة قائمة" Foreground="White" FontWeight="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="RightToLeft"/>
                            </Border>
                            <Border Grid.Row="1" Padding="10">
                                <Border Background="White" BorderBrush="#FF666666" BorderThickness="1" Padding="12">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="اسم القائمة" FontWeight="Black" Margin="0,0,0,6"/>
                                            <TextBox x:Name="AdminAddCategoryNameTextBox" Height="34" Padding="8,4" FontWeight="Black"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,12,0,0" FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Height="38" Content="حفظ" FontWeight="Black" Click="AdminAddCategorySaveButton_Click"/>
                                            <Button Grid.Column="2" Height="38" Content="إلغاء" FontWeight="Black" Click="AdminAddCategoryCancelButton_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AdminAddItemOverlay" Background="#40000000" Visibility="Collapsed" Panel.ZIndex="1201">
                    <Border x:Name="AdminAddItemModalBorder" Width="620" Background="{StaticResource BQueue}" BorderBrush="#FF6B6B6B" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewKeyDown="AdminAddItemModalBorder_PreviewKeyDown">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{StaticResource BBlue2}">
                                <TextBlock Text="إضافة صنف" Foreground="White" FontWeight="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="RightToLeft"/>
                            </Border>
                            <Border Grid.Row="1" Padding="10">
                                <Border Background="White" BorderBrush="#FF666666" BorderThickness="1" Padding="12">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="القائمة النشطة" FontWeight="Black" Margin="0,0,0,4"/>
                                            <Border BorderBrush="#FF999999" BorderThickness="1" Background="#FFF7F7F7" Padding="8,6">
                                                <TextBlock x:Name="AdminAddItemCategoryNameText" FontWeight="Black" FlowDirection="RightToLeft"/>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                                            <TextBlock Text="ربط منتج التطبيق (Linked App Product)" FontWeight="Black" Margin="0,0,0,6"/>
                                            <TextBox x:Name="AdminAddItemProductSearchTextBox" Grid.Row="1" Height="34" Padding="8,4" FontWeight="Black" TextChanged="AdminAddItemProductSearchTextBox_TextChanged"/>
                                            <ListBox x:Name="AdminAddItemProductsListBox" Grid.Row="2" Margin="0,8,0,0" BorderBrush="#FF999999" BorderThickness="1" SelectionChanged="AdminAddItemProductsListBox_SelectionChanged"/>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                            <TextBlock Text="Fixed Options (اختياري)" FontWeight="Black" Margin="0,0,0,6"/>
                                            <Border BorderBrush="#FF999999" BorderThickness="1" Background="#FFF7F7F7" Padding="6">
                                                <ScrollViewer Height="108" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="AdminAddItemOptionsPanel"/>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="POS Display Name" FontWeight="Black" Margin="0,0,0,6"/>
                                                <TextBox x:Name="AdminAddItemNameTextBox" Height="34" Padding="8,4" FontWeight="Black"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Price Preview" FontWeight="Black" Margin="0,0,0,6"/>
                                                <Border Height="34" BorderBrush="#FF999999" BorderThickness="1" Background="#FFF7F7F7" Padding="8,4">
                                                    <TextBlock x:Name="AdminAddItemPricePreviewText" FontWeight="Black" FlowDirection="LeftToRight" VerticalAlignment="Center" Text="0"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="4" Margin="0,12,0,0" FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Height="38" Content="حفظ" FontWeight="Black" Click="AdminAddItemSaveButton_Click"/>
                                            <Button Grid.Column="2" Height="38" Content="إلغاء" FontWeight="Black" Click="AdminAddItemCancelButton_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <primitives:Popup x:Name="AdminCategoryReorderPopup" Placement="Right" StaysOpen="True" AllowsTransparency="True" Closed="AdminCategoryReorderPopup_Closed">
                    <Border Background="{StaticResource BQueue}" BorderBrush="#FF666666" BorderThickness="1" Padding="4">
                        <StackPanel>
                            <Button Width="34" Height="28" FontWeight="Black" Content="↑" Click="AdminCategoryReorderUpButton_Click"/>
                            <Button Width="34" Height="28" FontWeight="Black" Content="↓" Margin="0,4,0,0" Click="AdminCategoryReorderDownButton_Click"/>
                            <Button Width="52" Height="24" FontSize="10" FontWeight="Black" Content="تعديل" Margin="0,6,0,0" Click="AdminCategoryEditButton_Click"/>
                            <Button Width="52" Height="24" FontSize="10" FontWeight="Black" Content="حذف" Margin="0,4,0,0" Click="AdminCategoryDeleteButton_Click"/>
                        </StackPanel>
                    </Border>
                </primitives:Popup>

                <primitives:Popup x:Name="AdminItemReorderPopup" Placement="Right" StaysOpen="True" AllowsTransparency="True" Closed="AdminItemReorderPopup_Closed">
                    <Border Background="{StaticResource BQueue}" BorderBrush="#FF666666" BorderThickness="1" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" FontWeight="Black" Content="↑" Click="AdminItemReorderUpButton_Click"/>
                            <Button Grid.Row="1" Grid.Column="0" FontWeight="Black" Content="←" Click="AdminItemReorderLeftButton_Click"/>
                            <Button Grid.Row="1" Grid.Column="2" FontWeight="Black" Content="→" Click="AdminItemReorderRightButton_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" FontWeight="Black" Content="↓" Click="AdminItemReorderDownButton_Click"/>
                            <Button Grid.Row="3" Grid.Column="0" FontWeight="Black" FontSize="10" Content="تعديل" Click="AdminItemEditButton_Click"/>
                            <Button Grid.Row="3" Grid.Column="2" FontWeight="Black" FontSize="10" Content="حذف" Click="AdminItemDeleteButton_Click"/>
                        </Grid>
                    </Border>
                </primitives:Popup>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
